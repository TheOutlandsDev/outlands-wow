+void GuildMgr::UnloadGuilds()
+{
+    if (GuildStore.empty())
+        return;
+
+    LOG_INFO("server.worldserver", "Unloading {} guilds while world services are available...", GuildStore.size());
+
+    for (auto const& [id, guild] : GuildStore)
+    {
+        (void)id;
+        delete guild;
+    }
+
+    GuildStore.clear();
+    LOG_INFO("server.worldserver", "Guild manager unload complete.");
+}
