+bool ScriptMgr::CanAutomatedListingMutate(Player* player, Item* item, uint32 count,
+    uint32 bid, uint32 buyout, uint32 durationSeconds, uint32 deposit, bool fullStack)
+{
+    ASSERT(player);
+    ASSERT(item);
+    CALL_ENABLED_BOOLEAN_HOOKS(AuctionHouseScript,
+        AUCTIONHOUSEHOOK_CAN_AUTOMATED_LISTING_MUTATE,
+        !script->CanAutomatedListingMutate(player, item, count, bid, buyout,
+            durationSeconds, deposit, fullStack));
+}
+
+void ScriptMgr::OnAutomatedListingPreCommit(Player* player, Item* item,
+    AuctionEntry* entry, CharacterDatabaseTransaction transaction)
+{
+    ASSERT(player);
+    ASSERT(item);
+    ASSERT(entry);
+    ASSERT(transaction);
+    CALL_ENABLED_HOOKS(AuctionHouseScript,
+        AUCTIONHOUSEHOOK_ON_AUTOMATED_LISTING_PRE_COMMIT,
+        script->OnAutomatedListingPreCommit(player, item, entry, transaction));
+}
