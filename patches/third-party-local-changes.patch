diff --git a/source/modules/mod-ollama-chat/src/mod-ollama-chat_route.h b/source/modules/mod-ollama-chat/src/mod-ollama-chat_route.h
new file mode 100644
--- /dev/null
+++ b/source/modules/mod-ollama-chat/src/mod-ollama-chat_route.h
@@ -0,0 +1,232 @@
+#pragma once
+
+#include <algorithm>
+#include <cctype>
+#include <cstdint>
+#include <initializer_list>
+#include <string>
+
+namespace OllamaChatRoute
+{
+enum class Intent
+{
+    Activity,
+    Direction,
+    Inventory,
+    Identity,
+    Quest,
+    Advice,
+    Greeting,
+    General
+};
+
+struct BoundedContext
+{
+    std::string activity = "stationary";
+    std::string health = "healthy";
+    std::string area = "unknown";
+    std::string zone = "unknown";
+    uint32_t activeQuests = 0;
+    uint32_t groupSize = 0;
+};
+
+inline std::string NormalizeWords(std::string const& input)
+{
+    std::string normalized = " ";
+    bool pendingSpace = false;
+    for (unsigned char value : input)
+    {
+        if (std::isalnum(value))
+        {
+            if (pendingSpace && normalized.back() != ' ')
+                normalized.push_back(' ');
+            normalized.push_back(static_cast<char>(std::tolower(value)));
+            pendingSpace = false;
+        }
+        else
+            pendingSpace = true;
+    }
+    if (normalized.back() != ' ')
+        normalized.push_back(' ');
+    return normalized;
+}
+
+inline bool ContainsAny(std::string const& normalized,
+    std::initializer_list<char const*> phrases)
+{
+    for (char const* phrase : phrases)
+    {
+        std::string needle = " " + std::string(phrase) + " ";
+        if (normalized.find(needle) != std::string::npos)
+            return true;
+    }
+    return false;
+}
+
+inline Intent Classify(std::string const& message)
+{
+    std::string const normalized = NormalizeWords(message);
+    if (ContainsAny(normalized, {"are you ai", "an ai", "real person", "system prompt",
+        "your rules", "ignore your rules", "ignore instructions", "language model"}))
+        return Intent::Identity;
+    if (ContainsAny(normalized, {"do you have", "have any", "for sale", "to sell",
+        "buy from you", "trade with", "your inventory", "your bags"}))
+        return Intent::Inventory;
+    if (ContainsAny(normalized, {"where should", "where can", "where is", "where are",
+        "directions", "how do i get", "go next", "head next"}))
+        return Intent::Direction;
+    if (ContainsAny(normalized, {"what are you doing", "what brings you", "up to",
+        "doing here", "why are you here"}))
+        return Intent::Activity;
+    if (ContainsAny(normalized, {"quest", "quests", "mission", "missions", "task", "tasks"}))
+        return Intent::Quest;
+    if (ContainsAny(normalized, {"advice", "tip", "tips", "help me", "how should i",
+        "what should i"}))
+        return Intent::Advice;
+    if (ContainsAny(normalized, {"hello", "hello there", "hi", "hey", "greetings",
+        "good morning", "good evening"}))
+        return Intent::Greeting;
+    return Intent::General;
+}
+
+inline char const* Name(Intent intent)
+{
+    switch (intent)
+    {
+        case Intent::Activity: return "activity";
+        case Intent::Direction: return "direction";
+        case Intent::Inventory: return "inventory";
+        case Intent::Identity: return "identity";
+        case Intent::Quest: return "quest";
+        case Intent::Advice: return "advice";
+        case Intent::Greeting: return "greeting";
+        case Intent::General: return "general";
+    }
+    return "general";
+}
+
+inline std::string SanitizeFact(std::string const& input, std::size_t limit = 48)
+{
+    std::string output;
+    output.reserve(std::min(input.size(), limit));
+    bool pendingSpace = false;
+    for (unsigned char value : input)
+    {
+        if (output.size() >= limit)
+            break;
+        if (std::isalnum(value) || value == '\'' || value == '-')
+        {
+            if (pendingSpace && !output.empty())
+                output.push_back(' ');
+            output.push_back(static_cast<char>(value));
+            pendingSpace = false;
+        }
+        else if (std::isspace(value))
+            pendingSpace = true;
+    }
+    while (!output.empty() && output.back() == ' ')
+        output.pop_back();
+    return output.empty() ? "unknown" : output;
+}
+
+inline std::string RenderContext(BoundedContext const& context)
+{
+    return "activity=" + SanitizeFact(context.activity) +
+        "; health=" + SanitizeFact(context.health) +
+        "; active_quest_count=" + std::to_string(std::min<uint32_t>(context.activeQuests, 25)) +
+        "; group_size=" + std::to_string(std::min<uint32_t>(context.groupSize, 40)) +
+        "; area=" + SanitizeFact(context.area) +
+        "; zone=" + SanitizeFact(context.zone) + ".";
+}
+
+inline std::string CanonicalText(std::string const& input)
+{
+    std::string canonical = NormalizeWords(input);
+    if (canonical.size() >= 2)
+        canonical = canonical.substr(1, canonical.size() - 2);
+    return canonical;
+}
+
+inline bool CanonicalEquals(std::string const& response, std::string const& expected)
+{
+    return CanonicalText(response) == CanonicalText(expected);
+}
+
+inline std::string ReplyGoal(Intent intent, BoundedContext const& context,
+    std::string const& botName = "adventurer", uint32_t botLevel = 1,
+    std::string const& botClass = "adventurer")
+{
+    switch (intent)
+    {
+        case Intent::Activity:
+            return "I am " + SanitizeFact(context.activity) + " here right now.";
+        case Intent::Direction:
+            return "I do not know where you should go next.";
+        case Intent::Inventory:
+            return "I cannot confirm any requested item is available to trade.";
+        case Intent::Identity:
+            return "I am " + SanitizeFact(botName, 24) + ", a level " +
+                std::to_string(std::min<uint32_t>(botLevel, 80)) + " " +
+                SanitizeFact(botClass, 24) + ".";
+        case Intent::Quest:
+            if (context.activeQuests == 0)
+                return "I have no active quests right now.";
+            return "I have " +
+                std::to_string(std::min<uint32_t>(context.activeQuests, 25)) +
+                " active quests right now.";
+        case Intent::Advice:
+            return "Practice carefully and learn which of your existing spells suit you.";
+        case Intent::Greeting:
+            return "Hello there, traveler.";
+        case Intent::General:
+            return "I am not sure how to answer that.";
+    }
+    return "I am not sure how to answer that.";
+}
+
+inline bool IsGroundedReply(Intent intent, std::string const& response,
+    BoundedContext const& context, std::string const& botName = "adventurer",
+    uint32_t botLevel = 1, std::string const& botClass = "adventurer",
+    std::string const& playerName = "player")
+{
+    std::string const contract = ReplyGoal(intent, context, botName, botLevel, botClass);
+    if (CanonicalEquals(response, contract))
+        return true;
+
+    std::string const canonical = CanonicalText(response);
+    std::string const activity = CanonicalText(SanitizeFact(context.activity));
+    std::string const name = CanonicalText(SanitizeFact(botName, 24));
+    std::string const player = CanonicalText(SanitizeFact(playerName, 24));
+    std::string const level = std::to_string(std::min<uint32_t>(botLevel, 80));
+    std::string const className = CanonicalText(SanitizeFact(botClass, 24));
+
+    switch (intent)
+    {
+        case Intent::Activity:
+            return canonical == "i am " + activity + " here" ||
+                canonical == "i am currently " + activity ||
+                canonical == "currently i am " + activity;
+        case Intent::Direction:
+            return canonical == "i don t know where you should go next" ||
+                canonical == "i have no verified destination to recommend" ||
+                canonical == "i do not have a verified destination to recommend";
+        case Intent::Inventory:
+            return canonical == "i can t confirm any requested item is available to trade";
+        case Intent::Identity:
+            return canonical == "i m " + name + " a level " + level + " " + className ||
+                canonical == "my name is " + name + " and i am a level " + level + " " + className;
+        case Intent::Quest:
+            return context.activeQuests == 0 && canonical == "i have no active quests";
+        case Intent::Advice:
+            return canonical == "practice carefully and learn which existing spells suit you";
+        case Intent::Greeting:
+            return canonical == "hello" || canonical == "hello there" ||
+                canonical == "hello traveler" || canonical == "greetings" ||
+                canonical == "greetings traveler" || canonical == "hello " + player ||
+                canonical == "greetings " + player;
+        case Intent::General:
+            return canonical == "i m not sure how to answer that";
+    }
+    return false;
+}
+}
