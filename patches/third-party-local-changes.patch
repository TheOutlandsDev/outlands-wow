+
+inline std::string NormalizeReply(std::string const& reply, std::size_t maxWords = 15,
+    std::size_t maxBytes = 200)
+{
+    std::string normalized;
+    normalized.reserve(reply.size());
+    bool pendingSpace = false;
+    for (unsigned char value : reply)
+    {
+        if (std::isspace(value))
+        {
+            pendingSpace = !normalized.empty();
+            continue;
+        }
+        if (value < 0x20 || value == 0x7F)
+            continue;
+        if (pendingSpace)
+            normalized.push_back(' ');
+        normalized.push_back(static_cast<char>(value));
+        pendingSpace = false;
+    }
+
+    if (normalized.size() >= 2 &&
+        ((normalized.front() == '"' && normalized.back() == '"') ||
+         (normalized.front() == '\'' && normalized.back() == '\'')))
+        normalized = normalized.substr(1, normalized.size() - 2);
+
+    std::size_t prefixSize = 0;
+    if (normalized.starts_with("Bot:"))
+        prefixSize = 4;
+    else if (normalized.starts_with("Assistant:"))
+        prefixSize = 10;
+    if (prefixSize != 0)
+    {
+        normalized.erase(0, prefixSize);
+        while (!normalized.empty() && normalized.front() == ' ')
+            normalized.erase(0, 1);
+    }
+
+    std::size_t words = 0;
+    bool inWord = false;
+    std::size_t wordCut = normalized.size();
+    for (std::size_t index = 0; index < normalized.size(); ++index)
+    {
+        bool const space = normalized[index] == ' ';
+        if (!space && !inWord)
+        {
+            ++words;
+            inWord = true;
+            if (words > maxWords)
+            {
+                wordCut = index;
+                break;
+            }
+        }
+        else if (space)
+            inWord = false;
+    }
+    normalized.resize(wordCut);
+    while (!normalized.empty() && normalized.back() == ' ')
+        normalized.pop_back();
+
+    if (normalized.size() > maxBytes)
+    {
+        std::size_t const cut = normalized.rfind(' ', maxBytes);
+        if (cut == std::string::npos)
+            return "";
+        normalized.resize(cut);
+    }
+    return normalized;
+}
 }
