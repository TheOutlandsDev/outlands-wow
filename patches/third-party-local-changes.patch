diff --git a/source/modules/mod-playerbots/tests/LivingAzerothChatPolicyTests.cpp b/source/modules/mod-playerbots/tests/LivingAzerothChatPolicyTests.cpp
new file mode 100644
--- /dev/null
+++ b/source/modules/mod-playerbots/tests/LivingAzerothChatPolicyTests.cpp
@@ -0,0 +1,76 @@
+#include "../src/Ai/Base/Actions/LivingAzerothChat.h"
+
+#include <cstdlib>
+#include <iostream>
+#include <string>
+#include <string_view>
+
+namespace Chat = LivingAzerothChat;
+
+namespace
+{
+void Expect(bool condition, std::string_view name)
+{
+    if (condition)
+        return;
+
+    std::cerr << "FAIL " << name << std::endl;
+    std::exit(1);
+}
+}
+
+int main()
+{
+    Expect(Chat::Normalize("  HELLO,   Adventurer! ") == "hello adventurer",
+        "normalization");
+    Expect(Chat::ContainsToken("hello ann", "ann"), "whole token match");
+    Expect(!Chat::ContainsToken("hello annette", "ann"), "partial token rejected");
+    Expect(Chat::StartsWithToken("lfg deadmines", "lfg"), "command prefix token");
+    Expect(Chat::IsCommand("Follow me"), "bot command classification");
+    Expect(!Chat::IsCommand("do you follow the story"), "ordinary speech classification");
+
+    struct IntentCase
+    {
+        std::string_view text;
+        Chat::Intent expected;
+    };
+    IntentCase const intentCases[] = {
+        {"hello there", Chat::Intent::Greeting},
+        {"thank you", Chat::Intent::Thanks},
+        {"goodbye", Chat::Intent::Goodbye},
+        {"where are you", Chat::Intent::Location},
+        {"what are you doing", Chat::Intent::Activity},
+        {"who are you", Chat::Intent::Identity},
+        {"what level are you", Chat::Intent::Level},
+        {"which quest are you on", Chat::Intent::Quest},
+        {"need a dungeon group", Chat::Intent::Group},
+        {"want to trade an item", Chat::Intent::Trade},
+        {"what is your class role", Chat::Intent::Role},
+        {"help", Chat::Intent::Help},
+        {"which guild are you in", Chat::Intent::Guild},
+        {"horde or alliance", Chat::Intent::Faction},
+        {"are you in combat", Chat::Intent::Combat},
+        {"the weather is strange", Chat::Intent::Unknown},
+    };
+    for (IntentCase const& test : intentCases)
+        Expect(Chat::DetectIntent(test.text) == test.expected, test.text);
+
+    std::string const identity = "bot-42";
+    Expect(Chat::SelectPersona(identity) == Chat::SelectPersona(identity),
+        "stable persona");
+    Expect(Chat::SelectVariant(identity, "hello", 600, 3) < 3,
+        "bounded response variant");
+    Expect(Chat::SelectVariant(identity, "hello", 600, 0) == 0,
+        "zero response variants");
+
+    Chat::ReplyArbiter::ResetForTests();
+    Expect(Chat::ReplyArbiter::TryClaim("conversation", 100, 5), "first reply claim");
+    Expect(!Chat::ReplyArbiter::TryClaim("conversation", 100, 5), "duplicate reply blocked");
+    Expect(Chat::ReplyArbiter::TryClaim("conversation", 105, 5), "expired reply claim replaced");
+
+    std::string oversized(400, 'A');
+    Expect(Chat::Normalize(oversized).size() == 255, "input length bound");
+
+    std::cout << "PASS intents=16 command_guard=1 duplicate_guard=1 input_bound=255" << std::endl;
+    return 0;
+}
diff --git a/source/modules/mod-playerbots/tests/PlayerLocalPopulationPolicyTests.cpp b/source/modules/mod-playerbots/tests/PlayerLocalPopulationPolicyTests.cpp
new file mode 100644
--- /dev/null
+++ b/source/modules/mod-playerbots/tests/PlayerLocalPopulationPolicyTests.cpp
@@ -0,0 +1,114 @@
+#include "../src/Bot/PlayerLocalPopulationPolicy.h"
+
+#include <cstdlib>
+#include <iostream>
+
+namespace Local = PlayerLocalPopulation;
+
+namespace
+{
+void Require(bool condition, char const* message)
+{
+    if (!condition)
+    {
+        std::cerr << "FAIL " << message << '\n';
+        std::exit(1);
+    }
+}
+}
+
+int main()
+{
+    Local::CandidateState eligible;
+    eligible.randomBot = true;
+    eligible.sameFaction = true;
+    eligible.inWorld = true;
+    eligible.alive = true;
+    eligible.overworld = true;
+    Require(Local::IsEligible(eligible), "safe candidate rejected");
+
+    bool Local::CandidateState::* blockers[] = {
+        &Local::CandidateState::teleporting,
+        &Local::CandidateState::rooted,
+        &Local::CandidateState::inCombat,
+        &Local::CandidateState::grouped,
+        &Local::CandidateState::inLfg,
+        &Local::CandidateState::inBattleground,
+        &Local::CandidateState::onTransport,
+        &Local::CandidateState::visibleAtSource,
+        &Local::CandidateState::coolingDown,
+        &Local::CandidateState::recentlyInteracted,
+        &Local::CandidateState::explicitlyProtected,
+    };
+    for (auto blocker : blockers)
+    {
+        Local::CandidateState state = eligible;
+        state.*blocker = true;
+        Require(!Local::IsEligible(state), "unsafe candidate accepted");
+    }
+
+    Local::CandidateState wrongFaction = eligible;
+    wrongFaction.sameFaction = false;
+    Require(!Local::IsEligible(wrongFaction), "cross-faction candidate accepted");
+    Local::CandidateState notRandom = eligible;
+    notRandom.randomBot = false;
+    Require(!Local::IsEligible(notRandom), "non-random character accepted");
+
+    Require(Local::LevelDelta(12, 9) == 3, "level delta");
+    Require(Local::IsLevelMatched(12, 9, 3), "level match boundary");
+    Require(!Local::IsLevelMatched(13, 9, 3), "level mismatch boundary");
+    Require(Local::CanPromote(8, 10, 80), "promotion rejected");
+    Require(!Local::CanPromote(10, 8, 80), "downgrade accepted");
+    Require(!Local::CanPromote(8, 81, 80), "over-cap promotion accepted");
+    Require(Local::PromotionLevel(1, 0, 3, 80) == 1, "promotion lower clamp");
+    Require(Local::PromotionLevel(80, 6, 3, 80) == 80, "promotion upper clamp");
+
+    Require(Local::RelocationBudget(2, 4, 2) == 2, "relocation budget");
+    Require(Local::RelocationBudget(4, 4, 2) == 0, "satisfied relocation budget");
+    Require(Local::RelocationBudget(0, 4, 2) == 2, "bounded relocation budget");
+
+    constexpr std::uint32_t normal = 0x01;
+    constexpr std::uint32_t incomplete = 0x04;
+    constexpr std::uint32_t noPath = 0x08;
+    constexpr std::uint32_t shortcut = 0x02;
+    Require(Local::IsUsableArrivalPath(normal, normal | incomplete, noPath | shortcut),
+            "normal arrival path rejected");
+    Require(Local::IsUsableArrivalPath(incomplete, normal | incomplete, noPath | shortcut),
+            "incomplete navmesh arrival path rejected");
+    Require(!Local::IsUsableArrivalPath(noPath, normal | incomplete, noPath | shortcut),
+            "missing arrival path accepted");
+    Require(!Local::IsUsableArrivalPath(normal | shortcut, normal | incomplete, noPath | shortcut),
+            "unsafe shortcut arrival path accepted");
+    Require(Local::IsArrivalDistanceSafe(160.0f * 160.0f, 160.0f, 350.0f),
+            "minimum safe arrival distance rejected");
+    Require(Local::IsArrivalDistanceSafe(350.0f * 350.0f, 160.0f, 350.0f),
+            "maximum safe arrival distance rejected");
+    Require(!Local::IsArrivalDistanceSafe(159.9f * 159.9f, 160.0f, 350.0f),
+            "visible arrival distance accepted");
+    Require(!Local::IsArrivalDistanceSafe(350.1f * 350.1f, 160.0f, 350.0f),
+            "out-of-bound arrival distance accepted");
+
+    Local::ArrivalDiagnostics diagnostics;
+    diagnostics.pathUnavailable = 2;
+    diagnostics.invalidPosition = 1;
+    diagnostics.water = 1;
+    diagnostics.unsafeDistance = 1;
+    diagnostics.wrongZone = 1;
+    diagnostics.visibleToPlayer = 1;
+    diagnostics.teleportFailed = 1;
+    Require(diagnostics.Total() == 8, "arrival diagnostic total");
+
+    Local::LevelWindow low = Local::AdaptiveLevelWindow(1, 80, 25, 4);
+    Require(low.lower == 1 && low.upper == 25, "low adaptive window");
+    Local::LevelWindow high = Local::AdaptiveLevelWindow(80, 80, 25, 4);
+    Require(high.lower == 56 && high.upper == 80, "high adaptive window");
+    Require(Local::CohortTarget(10, 80) == 8, "cohort target");
+    Require(Local::CohortTarget(3, 50) == 2, "cohort target rounds up");
+    Require(Local::AnchorIndex(5, 2) == 1, "anchor distribution");
+    Require(Local::CohortMutationBudget(6, 8, 2) == 2, "cohort mutation budget");
+    Require(Local::CohortMutationBudget(8, 8, 2) == 0, "cohort satisfied");
+
+    std::cout << "PASS blockers=11 faction_guard=1 downgrade_guard=1 "
+                 "relocation_bound=2 navmesh_path_policy=1 arrival_bounds=1 diagnostics=7 cohort_bounds=1\n";
+    return 0;
+}
