+static OllamaChatRoute::BoundedContext GenerateBoundedBotContext(
+    Player* bot, std::string const& area, std::string const& zone)
+{
+    OllamaChatRoute::BoundedContext context;
+    context.area = area;
+    context.zone = zone;
+
+    if (!bot->IsAlive())
+        context.activity = "incapacitated";
+    else if (bot->IsInCombat())
+        context.activity = "fighting";
+    else if (bot->IsMounted() && bot->isMoving())
+        context.activity = "moving while mounted";
+    else if (bot->isMoving())
+        context.activity = "moving";
+    else if (bot->IsMounted())
+        context.activity = "mounted and stationary";
+    else
+        context.activity = "stationary";
+
+    float const health = bot->GetHealthPct();
+    if (health < 25.0f)
+        context.health = "critical";
+    else if (health < 70.0f)
+        context.health = "wounded";
+    else
+        context.health = "healthy";
+
+    for (auto const& [questId, status] : bot->getQuestStatusMap())
+    {
+        (void)questId;
+        if (status.Status == QUEST_STATUS_INCOMPLETE || status.Status == QUEST_STATUS_COMPLETE)
+            ++context.activeQuests;
+        if (context.activeQuests >= 25)
+            break;
+    }
+    context.groupSize = bot->GetGroup() ? bot->GetGroup()->GetMembersCount() : 0;
+    return context;
+}
