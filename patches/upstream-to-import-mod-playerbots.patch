+bool RandomPlayerbotMgr::RelocateBotNearPlayer(Player* bot, Player* player)
+{
+    if (!bot || !player || !bot->IsInWorld() || !player->IsInWorld() || !player->GetMap())
+        return false;
+
+    WorldPosition playerPosition(player);
+    uint32 playerZone = player->GetZoneId();
+    float minimumDistance = static_cast<float>(sPlayerbotAIConfig.playerLocalPopulationMinimumArrivalDistance);
+    float maximumDistance = static_cast<float>(sPlayerbotAIConfig.playerLocalPopulationMaximumArrivalDistance);
+
+    for (uint32 attempt = 0; attempt < sPlayerbotAIConfig.playerLocalPopulationSafeArrivalAttempts; ++attempt)
+    {
+        WorldPosition destination(playerPosition);
+        float radius = frand(minimumDistance, maximumDistance);
+        if (!destination.GetReachableRandomPointOnGround(player, radius, false) || !destination.IsValid() ||
+            destination.isInWater() || destination.GetMapId() != player->GetMapId())
+            continue;
+
+        uint32 destinationZone = player->GetMap()->GetZoneId(player->GetPhaseMask(), destination.GetPositionX(),
+                                                              destination.GetPositionY(), destination.GetPositionZ());
+        if (destinationZone != playerZone)
+            continue;
+
+        bool visibleArrival = false;
+        for (Player* realPlayer : players)
+        {
+            if (!realPlayer || !realPlayer->IsInWorld() || realPlayer->GetMapId() != destination.GetMapId())
+                continue;
+
+            if (destination.sqDistance2d(WorldPosition(realPlayer)) < minimumDistance * minimumDistance)
+            {
+                visibleArrival = true;
+                break;
+            }
+        }
+        if (visibleArrival)
+            continue;
+
+        bot->GetMotionMaster()->Clear();
+        if (PlayerbotAI* botAI = GET_PLAYERBOT_AI(bot))
+            botAI->Reset(true);
+        bot->RemoveAurasWithInterruptFlags(AURA_INTERRUPT_FLAG_TELEPORTED | AURA_INTERRUPT_FLAG_CHANGE_MAP);
+        bot->TeleportTo(destination.GetMapId(), destination.GetPositionX(), destination.GetPositionY(),
+                        destination.GetPositionZ(), destination.GetOrientation());
+        bot->SendMovementFlagUpdate();
+        return true;
+    }
+
+    return false;
+}
