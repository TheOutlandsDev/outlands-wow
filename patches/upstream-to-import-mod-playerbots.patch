diff --git a/src/Ai/Base/Actions/LfgLifecycleGuard.h b/src/Ai/Base/Actions/LfgLifecycleGuard.h
new file mode 100644
index 0000000..7161293
--- /dev/null
+++ b/src/Ai/Base/Actions/LfgLifecycleGuard.h
@@ -0,0 +1,178 @@
+#ifndef PLAYERBOTS_LFG_LIFECYCLE_GUARD_H
+#define PLAYERBOTS_LFG_LIFECYCLE_GUARD_H
+
+#include <cstdint>
+
+namespace PlayerbotLfgLifecycle
+{
+enum class RoleSubmissionDecision : uint8_t
+{
+    Submit,
+    SuppressAlreadyReady,
+    SuppressTerminalState,
+    RejectMalformed,
+    RejectMissingSelf
+};
+
+enum class DungeonReleaseDecision : uint8_t
+{
+    ReleaseImmediately,
+    WaitForPlayerResurrection,
+    ReleaseAfterGrace,
+    SuppressAlreadyGhost
+};
+
+enum class TeleportRequestDecision : uint8_t
+{
+    Attempt,
+    SuppressTeleportInProgress,
+    SuppressAlreadyAtDestination,
+    RejectNotLfgGroup,
+    RejectMissingDungeon,
+    RejectDead
+};
+
+enum class CompanionCatchupDecision : uint8_t
+{
+    Attempt,
+    RejectMissingMember,
+    SuppressAnchor,
+    RejectNotPlayerbot,
+    RejectRealPlayer,
+    SuppressSameInstance,
+    SuppressTeleportInProgress,
+    RejectDead
+};
+
+inline RoleSubmissionDecision EvaluateRoleSubmission(bool packetValid, bool initializing, bool selfFound,
+                                                      bool selfReady, uint32_t currentRoles,
+                                                      uint32_t desiredRoles)
+{
+    if (!packetValid)
+        return RoleSubmissionDecision::RejectMalformed;
+    if (!initializing)
+        return RoleSubmissionDecision::SuppressTerminalState;
+    if (!selfFound)
+        return RoleSubmissionDecision::RejectMissingSelf;
+    if (selfReady && currentRoles == desiredRoles)
+        return RoleSubmissionDecision::SuppressAlreadyReady;
+    return RoleSubmissionDecision::Submit;
+}
+
+inline DungeonReleaseDecision EvaluateDungeonRelease(bool alreadyGhost, bool protectedPlayerDungeon,
+                                                      uint32_t elapsedSeconds, uint32_t graceSeconds)
+{
+    if (alreadyGhost)
+        return DungeonReleaseDecision::SuppressAlreadyGhost;
+    if (!protectedPlayerDungeon)
+        return DungeonReleaseDecision::ReleaseImmediately;
+    if (elapsedSeconds < graceSeconds)
+        return DungeonReleaseDecision::WaitForPlayerResurrection;
+    return DungeonReleaseDecision::ReleaseAfterGrace;
+}
+
+inline bool PreserveGroupFromAmbientRecovery(bool hasGroup, bool lfgGroup, bool leaderKnown,
+                                             bool leaderIsRandomBot, bool hasLoadedRealPlayer)
+{
+    if (!hasGroup)
+        return false;
+    if (lfgGroup || hasLoadedRealPlayer)
+        return true;
+    return leaderKnown && !leaderIsRandomBot;
+}
+
+inline TeleportRequestDecision EvaluateTeleportRequest(bool out, bool alive, bool lfgGroup,
+                                                        bool dungeonKnown, bool atSelectedDungeon,
+                                                        bool teleportInProgress)
+{
+    if (!lfgGroup)
+        return TeleportRequestDecision::RejectNotLfgGroup;
+    if (!dungeonKnown)
+        return TeleportRequestDecision::RejectMissingDungeon;
+    if (teleportInProgress)
+        return TeleportRequestDecision::SuppressTeleportInProgress;
+    if (!alive)
+        return TeleportRequestDecision::RejectDead;
+    if ((!out && atSelectedDungeon) || (out && !atSelectedDungeon))
+        return TeleportRequestDecision::SuppressAlreadyAtDestination;
+    return TeleportRequestDecision::Attempt;
+}
+
+inline CompanionCatchupDecision EvaluateCompanionCatchup(bool memberPresent, bool isAnchor, bool isPlayerbot,
+                                                          bool isRealPlayer, bool alive, bool sameInstance,
+                                                          bool teleportInProgress)
+{
+    if (!memberPresent)
+        return CompanionCatchupDecision::RejectMissingMember;
+    if (isAnchor)
+        return CompanionCatchupDecision::SuppressAnchor;
+    if (!isPlayerbot)
+        return CompanionCatchupDecision::RejectNotPlayerbot;
+    if (isRealPlayer)
+        return CompanionCatchupDecision::RejectRealPlayer;
+    if (sameInstance)
+        return CompanionCatchupDecision::SuppressSameInstance;
+    if (teleportInProgress)
+        return CompanionCatchupDecision::SuppressTeleportInProgress;
+    if (!alive)
+        return CompanionCatchupDecision::RejectDead;
+    return CompanionCatchupDecision::Attempt;
+}
+
+inline char const* ToString(RoleSubmissionDecision decision)
+{
+    switch (decision)
+    {
+        case RoleSubmissionDecision::Submit: return "submit";
+        case RoleSubmissionDecision::SuppressAlreadyReady: return "suppress_already_ready";
+        case RoleSubmissionDecision::SuppressTerminalState: return "suppress_terminal_state";
+        case RoleSubmissionDecision::RejectMalformed: return "reject_malformed";
+        case RoleSubmissionDecision::RejectMissingSelf: return "reject_missing_self";
+    }
+    return "reject_unknown";
+}
+
+inline char const* ToString(DungeonReleaseDecision decision)
+{
+    switch (decision)
+    {
+        case DungeonReleaseDecision::ReleaseImmediately: return "release_immediately";
+        case DungeonReleaseDecision::WaitForPlayerResurrection: return "wait_for_player_resurrection";
+        case DungeonReleaseDecision::ReleaseAfterGrace: return "release_after_grace";
+        case DungeonReleaseDecision::SuppressAlreadyGhost: return "suppress_already_ghost";
+    }
+    return "release_unknown";
+}
+
+inline char const* ToString(TeleportRequestDecision decision)
+{
+    switch (decision)
+    {
+        case TeleportRequestDecision::Attempt: return "attempt";
+        case TeleportRequestDecision::SuppressTeleportInProgress: return "suppress_teleport_in_progress";
+        case TeleportRequestDecision::SuppressAlreadyAtDestination: return "suppress_already_at_destination";
+        case TeleportRequestDecision::RejectNotLfgGroup: return "reject_not_lfg_group";
+        case TeleportRequestDecision::RejectMissingDungeon: return "reject_missing_dungeon";
+        case TeleportRequestDecision::RejectDead: return "reject_dead";
+    }
+    return "reject_unknown";
+}
+
+inline char const* ToString(CompanionCatchupDecision decision)
+{
+    switch (decision)
+    {
+        case CompanionCatchupDecision::Attempt: return "attempt";
+        case CompanionCatchupDecision::RejectMissingMember: return "reject_missing_member";
+        case CompanionCatchupDecision::SuppressAnchor: return "suppress_anchor";
+        case CompanionCatchupDecision::RejectNotPlayerbot: return "reject_not_playerbot";
+        case CompanionCatchupDecision::RejectRealPlayer: return "reject_real_player";
+        case CompanionCatchupDecision::SuppressSameInstance: return "suppress_same_instance";
+        case CompanionCatchupDecision::SuppressTeleportInProgress: return "suppress_teleport_in_progress";
+        case CompanionCatchupDecision::RejectDead: return "reject_dead";
+    }
+    return "reject_unknown";
+}
+}
+
+#endif
