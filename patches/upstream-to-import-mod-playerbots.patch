diff --git a/src/Bot/PlayerLocalPopulationPolicy.h b/src/Bot/PlayerLocalPopulationPolicy.h
new file mode 100644
index 0000000..7d16b05
--- /dev/null
+++ b/src/Bot/PlayerLocalPopulationPolicy.h
@@ -0,0 +1,150 @@
+/*
+ * Living Azeroth player-local and adaptive level-cohort population policy.
+ * Side-effect-free helpers; all game-object work stays on the world thread.
+ */
+#ifndef PLAYERBOTS_PLAYERLOCALPOPULATIONPOLICY_H
+#define PLAYERBOTS_PLAYERLOCALPOPULATIONPOLICY_H
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+
+namespace PlayerLocalPopulation
+{
+struct CandidateState
+{
+    bool randomBot = false;
+    bool sameFaction = false;
+    bool inWorld = false;
+    bool alive = false;
+    bool overworld = false;
+    bool teleporting = false;
+    bool rooted = false;
+    bool inCombat = false;
+    bool grouped = false;
+    bool inLfg = false;
+    bool inBattleground = false;
+    bool onTransport = false;
+    bool visibleAtSource = false;
+    bool coolingDown = false;
+    bool recentlyInteracted = false;
+    bool explicitlyProtected = false;
+};
+
+inline bool IsEligible(CandidateState const& state)
+{
+    return state.randomBot && state.sameFaction && state.inWorld && state.alive && state.overworld &&
+           !state.teleporting && !state.rooted && !state.inCombat && !state.grouped && !state.inLfg &&
+           !state.inBattleground && !state.onTransport && !state.visibleAtSource && !state.coolingDown &&
+           !state.recentlyInteracted && !state.explicitlyProtected;
+}
+
+inline std::uint32_t LevelDelta(std::uint32_t first, std::uint32_t second)
+{
+    return first > second ? first - second : second - first;
+}
+
+inline bool IsLevelMatched(std::uint32_t botLevel, std::uint32_t playerLevel, std::uint32_t maximumDelta)
+{
+    return LevelDelta(botLevel, playerLevel) <= maximumDelta;
+}
+
+inline bool CanPromote(std::uint32_t botLevel, std::uint32_t playerLevel, std::uint32_t maximumLevel)
+{
+    return botLevel < playerLevel && playerLevel <= maximumLevel;
+}
+
+inline std::uint32_t PromotionLevel(std::uint32_t playerLevel, std::uint32_t botId,
+                                    std::uint32_t preferredDelta, std::uint32_t maximumLevel)
+{
+    std::int32_t spread = static_cast<std::int32_t>(preferredDelta);
+    std::int32_t width = spread * 2 + 1;
+    std::int32_t offset = width > 0 ? static_cast<std::int32_t>(botId % width) - spread : 0;
+    std::int32_t desired = static_cast<std::int32_t>(playerLevel) + offset;
+    return static_cast<std::uint32_t>(std::clamp(desired, 1, static_cast<std::int32_t>(maximumLevel)));
+}
+
+inline std::uint32_t RelocationBudget(std::uint32_t nearby, std::uint32_t target,
+                                      std::uint32_t maximumPerCycle)
+{
+    return nearby >= target ? 0 : std::min(target - nearby, maximumPerCycle);
+}
+
+struct LevelWindow
+{
+    std::uint32_t lower = 1;
+    std::uint32_t upper = 1;
+
+    bool Contains(std::uint32_t level) const
+    {
+        return level >= lower && level <= upper;
+    }
+};
+
+inline LevelWindow AdaptiveLevelWindow(std::uint32_t playerLevel, std::uint32_t maximumLevel,
+                                       std::uint32_t windowLevels, std::uint32_t lowerSlack)
+{
+    maximumLevel = std::max<std::uint32_t>(1, maximumLevel);
+    windowLevels = std::clamp<std::uint32_t>(windowLevels, 1, maximumLevel);
+    playerLevel = std::clamp<std::uint32_t>(playerLevel, 1, maximumLevel);
+    std::uint32_t latestStart = maximumLevel - windowLevels + 1;
+    std::uint32_t desiredStart = playerLevel > lowerSlack ? playerLevel - lowerSlack : 1;
+    std::uint32_t lower = std::clamp<std::uint32_t>(desiredStart, 1, latestStart);
+    return {lower, lower + windowLevels - 1};
+}
+
+inline std::uint32_t CohortTarget(std::uint32_t onlineBots, std::uint32_t percent)
+{
+    percent = std::min<std::uint32_t>(percent, 100);
+    return (onlineBots * percent + 99) / 100;
+}
+
+inline std::size_t AnchorIndex(std::size_t cohortSlot, std::size_t playerCount)
+{
+    return playerCount ? cohortSlot % playerCount : 0;
+}
+
+inline std::uint32_t SpreadLevel(std::uint32_t lower, std::uint32_t upper, std::size_t ordinal)
+{
+    if (lower >= upper)
+        return lower;
+    return lower + static_cast<std::uint32_t>(ordinal % (static_cast<std::size_t>(upper - lower) + 1));
+}
+
+inline std::uint32_t CohortLevel(LevelWindow window, std::uint32_t playerLevel, std::size_t ordinal)
+{
+    playerLevel = std::clamp(playerLevel, window.lower, window.upper);
+    std::size_t bucket = ordinal % 20;
+
+    // 60% peers, 25% near-future players, 15% lower/background players.
+    if (bucket < 12)
+    {
+        std::uint32_t lower = playerLevel > 4 ? playerLevel - 4 : window.lower;
+        lower = std::max(lower, window.lower);
+        std::uint32_t upper = std::min(window.upper, playerLevel + 5);
+        return SpreadLevel(lower, upper, ordinal);
+    }
+    if (bucket < 17)
+    {
+        std::uint32_t lower = std::min(window.upper, playerLevel + 6);
+        if (lower <= window.upper && lower > playerLevel)
+            return SpreadLevel(lower, window.upper, ordinal);
+    }
+    else if (playerLevel > window.lower)
+    {
+        std::uint32_t upper = playerLevel > 5 ? playerLevel - 5 : window.lower;
+        upper = std::min(upper, window.upper);
+        if (upper >= window.lower)
+            return SpreadLevel(window.lower, upper, ordinal);
+    }
+    return SpreadLevel(window.lower, window.upper, ordinal);
+}
+
+inline std::uint32_t CohortMutationBudget(std::uint32_t matched, std::uint32_t target,
+                                          std::uint32_t maximumPerCycle)
+{
+    return matched >= target ? 0 : std::min(target - matched, maximumPerCycle);
+}
+}
+
+#endif
