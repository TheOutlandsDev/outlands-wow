+++ b/src/Ai/Base/Actions/LivingAzerothChatReply.h
@@ -0,0 +1,224 @@
+/*
+ * Context rendering for Living Azeroth Chat v2. Callers provide live objects
+ * for the duration of one reply only; this file stores no object pointers.
+ */
+
+#ifndef PLAYERBOT_LIVING_AZEROTH_CHAT_REPLY_H
+#define PLAYERBOT_LIVING_AZEROTH_CHAT_REPLY_H
+
+#include "ChatHelper.h"
+#include "Guild.h"
+#include "GuildMgr.h"
+#include "LivingAzerothChat.h"
+#include "ObjectMgr.h"
+#include "Player.h"
+#include "PlayerbotAI.h"
+#include "PlayerbotTextMgr.h"
+#include "Playerbots.h"
+
+#include <sstream>
+#include <string>
+#include <string_view>
+
+namespace LivingAzerothChat
+{
+inline std::string CurrentZone(PlayerbotAI* botAI)
+{
+    AreaTableEntry const* zone = botAI->GetCurrentZone();
+    return zone ? botAI->GetLocalizedAreaName(zone)
+                : PlayerbotTextMgr::instance().GetBotText("string_unknown_area");
+}
+
+inline std::string CurrentQuest(PlayerbotAI* botAI)
+{
+    auto const questIds = botAI->GetCurrentIncompleteQuestIds();
+    uint32 selectedQuestId = 0;
+    for (uint32 questId : questIds)
+    {
+        if (!selectedQuestId || questId < selectedQuestId)
+            selectedQuestId = questId;
+    }
+
+    if (!selectedQuestId)
+        return "";
+
+    Quest const* quest = sObjectMgr->GetQuestTemplate(selectedQuestId);
+    return quest ? quest->GetTitle() : "";
+}
+
+inline std::string PersonaGreeting(Persona persona, bool alliance)
+{
+    switch (persona)
+    {
+        case Persona::Sentinel:
+            return alliance ? "Well met" : "Strength and honor";
+        case Persona::Scout:
+            return "Good to see you";
+        case Persona::Scholar:
+            return "Greetings";
+        case Persona::Mercenary:
+            return "You look capable";
+        case Persona::Wanderer:
+            return "Safe roads";
+    }
+
+    return "Greetings";
+}
+
+inline std::string BuildReply(Player* bot, std::string_view incomingMessage, std::string const& speakerName)
+{
+    PlayerbotAI* botAI = GET_PLAYERBOT_AI(bot);
+    if (!botAI)
+        return "";
+
+    std::ostringstream identity;
+    identity << bot->GetGUID().ToString() << '|' << bot->GetName() << '|'
+             << static_cast<uint32>(bot->getRace()) << '|'
+             << static_cast<uint32>(bot->getClass()) << '|' << static_cast<uint32>(bot->getGender()) << '|'
+             << static_cast<uint32>(bot->GetTeamId());
+
+    Persona const persona = SelectPersona(identity.str());
+    Intent const intent = DetectIntent(incomingMessage);
+    uint32_t const variant = SelectVariant(identity.str(), incomingMessage, std::time(nullptr), 3);
+    std::string const speaker = speakerName.empty() ? "traveler" : speakerName;
+
+    bool const alliance = bot->GetTeamId() == TEAM_ALLIANCE;
+    std::string const faction = alliance ? "Alliance" : "Horde";
+    std::string const zone = CurrentZone(botAI);
+    std::string const className = botAI->GetChatHelper()->FormatClass(bot->getClass());
+    std::string const role = PlayerbotAI::IsTank(bot, true) ? "tank"
+                               : (PlayerbotAI::IsHeal(bot, true) ? "healer" : "damage");
+    std::string const quest = CurrentQuest(botAI);
+    std::ostringstream response;
+
+    switch (intent)
+    {
+        case Intent::Greeting:
+            if (variant == 0)
+                response << PersonaGreeting(persona, alliance) << ", " << speaker << ". I'm " << bot->GetName()
+                         << ", a level " << bot->GetLevel() << ' ' << className << " in " << zone << '.';
+            else if (variant == 1)
+                response << "Hey, " << speaker << ". " << bot->GetName() << " here - I'm working around " << zone
+                         << " today.";
+            else
+                response << "Good to meet you, " << speaker << ". I'm " << bot->GetName() << ", " << role
+                         << " for the " << faction << '.';
+            break;
+        case Intent::Thanks:
+            if (variant == 0)
+                response << "Anytime, " << speaker << ". Safe travels.";
+            else if (variant == 1)
+                response << "Glad I could help, " << speaker << '.';
+            else
+                response << "You got it, " << speaker << ". Watch your back out there.";
+            break;
+        case Intent::Goodbye:
+            if (variant == 0)
+                response << "Safe travels, " << speaker << ". Perhaps our paths will cross again.";
+            else if (variant == 1)
+                response << "See you on the road, " << speaker << '.';
+            else
+                response << "Until next time, " << speaker << ". Stay sharp.";
+            break;
+        case Intent::Location:
+            if (variant == 0)
+                response << "I'm in " << zone << " right now, " << speaker << '.';
+            else if (variant == 1)
+                response << "You'll find me around " << zone << ", " << speaker << '.';
+            else
+                response << "I'm traveling through " << zone << " at the moment.";
+            break;
+        case Intent::Activity:
+            if (bot->IsInCombat())
+                response << "I'm fighting in " << zone << ". Give me a moment, " << speaker << '.';
+            else if (!quest.empty())
+                response << (variant == 0 ? "I'm working on " : "I'm making progress on ") << quest << " in "
+                         << zone << '.';
+            else
+                response << (variant == 0 ? "I'm traveling through " : "I'm keeping busy around ") << zone
+                         << " and looking for useful work.";
+            break;
+        case Intent::Identity:
+            if (variant == 0)
+                response << "I'm " << bot->GetName() << ", a level " << bot->GetLevel() << ' ' << className
+                         << " with the " << faction << '.';
+            else if (variant == 1)
+                response << bot->GetName() << ". I work as " << role << " and I'm currently in " << zone << '.';
+            else
+                response << "Name's " << bot->GetName() << ". I'm a " << className << " traveling for the "
+                         << faction << '.';
+            break;
+        case Intent::Level:
+            response << "I'm level " << bot->GetLevel() << " - a " << className << " built for " << role << '.';
+            break;
+        case Intent::Quest:
+            if (!quest.empty())
+                response << (variant == 0 ? "I'm currently working on " : "My focus right now is ") << quest
+                         << " in " << zone << '.';
+            else
+                response << "Nothing active right now. I'm looking for work in " << zone << '.';
+            break;
+        case Intent::Group:
+            if (bot->GetGroup())
+                response << "I'm already grouped, filling the " << role << " role near " << zone << '.';
+            else
+                response << (variant == 0 ? "I'm available as " : "I can join as ") << role << ". I'm level "
+                         << bot->GetLevel() << " in " << zone << '.';
+            break;
+        case Intent::Trade:
+            response << "Link the item with WTB, " << speaker << ", and I'll check what I have.";
+            break;
+        case Intent::Role:
+            response << "I'm a level " << bot->GetLevel() << ' ' << className << ", built for " << role << '.';
+            break;
+        case Intent::Help:
+            response << "Ask me who I am, my level, quest, group role, location, guild, faction, combat, or trade.";
+            break;
+        case Intent::Guild:
+        {
+            if (bot->GetGuildId())
+            {
+                Guild* guild = sGuildMgr->GetGuildById(bot->GetGuildId());
+                if (guild)
+                    response << "I'm with " << guild->GetName() << ". My standing comes from what I do in the world.";
+                else
+                    response << "I belong to a guild. My standing comes from what I do in the world.";
+            }
+            else
+                response << "I'm not sworn to a guild yet. For now, I fight for the " << faction << '.';
+            break;
+        }
+        case Intent::Faction:
+            response << "My loyalty is with the " << faction << ". You'll see it in where I travel and who I fight.";
+            break;
+        case Intent::Combat:
+            if (bot->IsInCombat())
+                response << "I'm in combat now in " << zone << '.';
+            else
+                response << "No fight at this moment, but I'm ready to defend the " << faction << '.';
+            break;
+        case Intent::Unknown:
+            if (variant == 0)
+                response << "I didn't quite catch that, " << speaker
+                         << ". Ask me where I am, what I'm doing, or about quests and groups.";
+            else if (variant == 1)
+                response << "Say that another way, " << speaker << "? I can tell you what I'm working on.";
+            else
+                response << "Not sure I followed. Ask me about my level, location, guild, or current quest.";
+            break;
+    }
+
+    std::string result = response.str();
+    if (result.size() > 255)
+    {
+        std::size_t cut = 255;
+        while (cut > 0 && (static_cast<unsigned char>(result[cut]) & 0xC0) == 0x80)
+            --cut;
+        result.resize(cut);
+    }
+
+    return result;
+}
+}
+
+#endif
