@@ -0,0 +1,292 @@
+/*
+ * Living Azeroth Chat v2 contains only bounded, in-memory chat classification.
+ * It must remain safe to call from the playerbot update path: no database,
+ * filesystem, lock, network, or external-model work belongs here.
+ */
+
+#ifndef PLAYERBOT_LIVING_AZEROTH_CHAT_H
+#define PLAYERBOT_LIVING_AZEROTH_CHAT_H
+
+#include <array>
+#include <atomic>
+#include <cctype>
+#include <cstdint>
+#include <ctime>
+#include <initializer_list>
+#include <string>
+#include <string_view>
+
+namespace LivingAzerothChat
+{
+enum class Intent
+{
+    Greeting,
+    Thanks,
+    Goodbye,
+    Location,
+    Activity,
+    Identity,
+    Level,
+    Quest,
+    Group,
+    Trade,
+    Role,
+    Help,
+    Guild,
+    Faction,
+    Combat,
+    Unknown
+};
+
+enum class Persona
+{
+    Sentinel,
+    Scout,
+    Scholar,
+    Mercenary,
+    Wanderer
+};
+
+inline std::string Normalize(std::string_view input)
+{
+    std::string result;
+    result.reserve(input.size() > 255 ? 255 : input.size());
+    bool pendingSpace = false;
+    std::size_t const length = input.size() > 255 ? 255 : input.size();
+
+    for (std::size_t index = 0; index < length; ++index)
+    {
+        unsigned char const character = static_cast<unsigned char>(input[index]);
+        if (std::isalnum(character))
+        {
+            if (pendingSpace && !result.empty())
+                result.push_back(' ');
+
+            result.push_back(static_cast<char>(std::tolower(character)));
+            pendingSpace = false;
+        }
+        else
+            pendingSpace = !result.empty();
+    }
+
+    return result;
+}
+
+inline bool ContainsToken(std::string_view normalized, std::string_view token)
+{
+    if (token.empty())
+        return false;
+
+    std::size_t position = normalized.find(token);
+    while (position != std::string_view::npos)
+    {
+        bool const validStart = position == 0 || normalized[position - 1] == ' ';
+        std::size_t const end = position + token.size();
+        bool const validEnd = end == normalized.size() || normalized[end] == ' ';
+        if (validStart && validEnd)
+            return true;
+
+        position = normalized.find(token, position + 1);
+    }
+
+    return false;
+}
+
+inline bool ContainsAny(std::string_view normalized, std::initializer_list<std::string_view> tokens)
+{
+    for (std::string_view token : tokens)
+        if (ContainsToken(normalized, token))
+            return true;
+
+    return false;
+}
+
+inline bool StartsWithToken(std::string_view normalized, std::string_view token)
+{
+    return normalized == token ||
+           (normalized.size() > token.size() && normalized.starts_with(token) && normalized[token.size()] == ' ');
+}
+
+inline bool IsCommand(std::string_view input)
+{
+    std::string const normalized = Normalize(input);
+    for (std::string_view command : { "follow", "stay", "attack", "pull", "flee", "reset", "cast",
+                                      "accept", "destroy", "join", "leave", "repair", "summon", "guard" })
+        if (StartsWithToken(normalized, command))
+            return true;
+
+    return false;
+}
+
+inline Intent DetectIntent(std::string_view input)
+{
+    std::string const normalized = Normalize(input);
+
+    if (normalized.find("who are you") != std::string::npos ||
+        normalized.find("what is your name") != std::string::npos ||
+        normalized.find("what s your name") != std::string::npos)
+        return Intent::Identity;
+    if (ContainsAny(normalized, { "level", "lvl" }))
+        return Intent::Level;
+    if (normalized.find("where are you") != std::string::npos ||
+        ContainsAny(normalized, { "where", "location", "zone" }))
+        return Intent::Location;
+    if (ContainsAny(normalized, { "quest", "questing", "objective" }))
+        return Intent::Quest;
+    if (ContainsAny(normalized, { "group", "party", "invite", "dungeon", "lfg", "lfm", "raid" }))
+        return Intent::Group;
+    if (ContainsAny(normalized, { "trade", "auction", "buy", "sell", "wtb", "wts", "item" }))
+        return Intent::Trade;
+    if (ContainsAny(normalized, { "guild", "rank" }))
+        return Intent::Guild;
+    if (ContainsAny(normalized, { "alliance", "horde", "faction" }))
+        return Intent::Faction;
+    if (ContainsAny(normalized, { "fight", "fighting", "combat", "attack", "war", "pvp" }))
+        return Intent::Combat;
+    if (ContainsAny(normalized, { "class", "role", "spec", "tank", "healer", "heal", "dps" }))
+        return Intent::Role;
+    if (normalized.find("what are you doing") != std::string::npos ||
+        normalized.find("how are you") != std::string::npos ||
+        normalized.find("what s up") != std::string::npos ||
+        ContainsAny(normalized, { "doing", "busy", "status", "up" }))
+        return Intent::Activity;
+    if (ContainsAny(normalized, { "help", "commands" }))
+        return Intent::Help;
+    if (ContainsAny(normalized, { "thanks", "thank", "ty" }))
+        return Intent::Thanks;
+    if (ContainsAny(normalized, { "bye", "goodbye", "later", "farewell" }))
+        return Intent::Goodbye;
+    if (ContainsAny(normalized, { "hello", "hi", "hey", "greetings", "wazzup" }))
+        return Intent::Greeting;
+
+    return Intent::Unknown;
+}
+
+inline char const* IntentName(Intent intent)
+{
+    switch (intent)
+    {
+        case Intent::Greeting:
+            return "greeting";
+        case Intent::Thanks:
+            return "thanks";
+        case Intent::Goodbye:
+            return "goodbye";
+        case Intent::Location:
+            return "location";
+        case Intent::Activity:
+            return "activity";
+        case Intent::Identity:
+            return "identity";
+        case Intent::Level:
+            return "level";
+        case Intent::Quest:
+            return "quest";
+        case Intent::Group:
+            return "group";
+        case Intent::Trade:
+            return "trade";
+        case Intent::Role:
+            return "role";
+        case Intent::Help:
+            return "help";
+        case Intent::Guild:
+            return "guild";
+        case Intent::Faction:
+            return "faction";
+        case Intent::Combat:
+            return "combat";
+        case Intent::Unknown:
+            return "unknown";
+    }
+
+    return "unknown";
+}
+
+inline uint64_t StableHash(std::string_view input)
+{
+    uint64_t hash = 14695981039346656037ULL;
+    for (unsigned char character : input)
+    {
+        hash ^= character;
+        hash *= 1099511628211ULL;
+    }
+
+    return hash;
+}
+
+inline Persona SelectPersona(std::string_view stableIdentity)
+{
+    return static_cast<Persona>(StableHash(stableIdentity) % 5);
+}
+
+inline uint32_t SelectVariant(
+    std::string_view stableIdentity,
+    std::string_view incomingMessage,
+    std::time_t now,
+    uint32_t choices)
+{
+    if (!choices)
+        return 0;
+
+    uint64_t hash = StableHash(stableIdentity);
+    uint64_t const messageHash = StableHash(Normalize(incomingMessage));
+    uint64_t const timeBucket = now > 0 ? static_cast<uint64_t>(now) / 300ULL : 0;
+    hash ^= messageHash + 0x9E3779B97F4A7C15ULL + (hash << 6) + (hash >> 2);
+    hash ^= timeBucket + 0x9E3779B97F4A7C15ULL + (hash << 6) + (hash >> 2);
+    return static_cast<uint32_t>(hash % choices);
+}
+
+class ReplyArbiter
+{
+public:
+    static bool TryClaim(std::string_view conversationKey, std::time_t now, uint32_t ttlSeconds = 5)
+    {
+        uint64_t const keyHash = StableHash(conversationKey);
+        uint32_t fingerprint = static_cast<uint32_t>(keyHash >> 32);
+        if (!fingerprint)
+            fingerprint = 1;
+        uint32_t const expires = static_cast<uint32_t>(now) + (ttlSeconds ? ttlSeconds : 1);
+        uint64_t const desired = (static_cast<uint64_t>(fingerprint) << 32) | expires;
+        auto& claims = GetClaims();
+
+        for (uint8_t probe = 0; probe < 8; ++probe)
+        {
+            auto& claim = claims[(keyHash + probe) % claims.size()];
+            for (uint8_t attempt = 0; attempt < 3; ++attempt)
+            {
+                uint64_t expected = claim.load(std::memory_order_relaxed);
+                uint32_t const currentFingerprint = static_cast<uint32_t>(expected >> 32);
+                uint32_t const currentExpiry = static_cast<uint32_t>(expected & 0xFFFFFFFFULL);
+                if (expected && static_cast<uint32_t>(now) < currentExpiry)
+                {
+                    if (currentFingerprint == fingerprint)
+                        return false;
+                    break;
+                }
+
+                if (claim.compare_exchange_weak(
+                        expected, desired, std::memory_order_acq_rel, std::memory_order_relaxed))
+                    return true;
+            }
+        }
+
+        return false;
+    }
+
+    static void ResetForTests()
+    {
+        for (auto& claim : GetClaims())
+            claim.store(0, std::memory_order_relaxed);
+    }
+
+private:
+    static std::array<std::atomic<uint64_t>, 4096>& GetClaims()
+    {
+        static std::array<std::atomic<uint64_t>, 4096> claims{};
+        return claims;
+    }
+};
+}
+
+#endif
