+void RandomPlayerbotMgr::UpdateAdaptiveLevelCohort()
+{
+    using namespace PlayerLocalPopulation;
+
+    time_t now = time(nullptr);
+    AdaptiveLevelCohortTimer = now;
+
+    std::vector<Player*> realPlayers;
+    for (Player* player : players)
+    {
+        if (player && player->IsInWorld() && player->IsAlive() && !player->IsGameMaster() &&
+            !player->IsBeingTeleported())
+            realPlayers.push_back(player);
+    }
+    std::sort(realPlayers.begin(), realPlayers.end(), [](Player* left, Player* right)
+              { return left->GetGUID().GetCounter() < right->GetGUID().GetCounter(); });
+
+    std::vector<Player*> bots;
+    bots.reserve(playerBots.size());
+    for (auto const& [guid, bot] : playerBots)
+        if (bot)
+            bots.push_back(bot);
+    std::sort(bots.begin(), bots.end(), [](Player* left, Player* right)
+              { return left->GetGUID().GetCounter() < right->GetGUID().GetCounter(); });
+
+    if (realPlayers.empty() || bots.empty())
+    {
+        LOG_INFO("playerbots", "LA24_LEVEL_COHORT action=skip humans={} online_bots={}",
+                 realPlayers.size(), bots.size());
+        return;
+    }
+
+    uint32 target = CohortTarget(static_cast<uint32>(bots.size()),
+                                 sPlayerbotAIConfig.adaptiveLevelCohortTargetPercent);
+    target = std::min<uint32>(target, static_cast<uint32>(bots.size()));
+
+    struct Candidate
+    {
+        Player* bot;
+        Player* anchor;
+        LevelWindow window;
+        uint32 desiredLevel;
+        size_t slot;
+    };
+    std::vector<Candidate> candidates;
+    uint32 matched = 0;
+
+    for (size_t slot = 0; slot < target; ++slot)
+    {
+        Player* bot = bots[slot];
+        Player* anchor = realPlayers[AnchorIndex(slot, realPlayers.size())];
+        LevelWindow window = AdaptiveLevelWindow(anchor->GetLevel(), DEFAULT_MAX_LEVEL,
+            sPlayerbotAIConfig.adaptiveLevelCohortWindowLevels,
+            sPlayerbotAIConfig.adaptiveLevelCohortLowerSlack);
+        if (window.Contains(bot->GetLevel()))
+        {
+            ++matched;
+            continue;
+        }
+
+        bool visibleAtSource = false;
+        if (bot->IsInWorld())
+        {
+            WorldPosition botPosition(bot);
+            float visibilityDistance = static_cast<float>(sPlayerbotAIConfig.BotActiveAloneForceWhenInRadius);
+            for (Player* realPlayer : realPlayers)
+            {
+                if (realPlayer->GetMapId() == bot->GetMapId() &&
+                    botPosition.sqDistance2d(WorldPosition(realPlayer)) < visibilityDistance * visibilityDistance)
+                {
+                    visibleAtSource = true;
+                    break;
+                }
+            }
+        }
+
+        uint32 botId = bot->GetGUID().GetCounter();
+        CandidateState state;
+        state.randomBot = IsRandomBot(bot);
+        state.sameFaction = true;
+        state.inWorld = bot->IsInWorld();
+        state.alive = bot->IsAlive();
+        state.overworld = bot->GetMap() && !bot->GetMap()->IsDungeon() &&
+                          !bot->GetMap()->IsBattlegroundOrArena();
+        state.teleporting = bot->IsBeingTeleported();
+        state.rooted = bot->IsRooted();
+        state.inCombat = bot->IsInCombat();
+        state.grouped = bot->GetGroup() != nullptr;
+        state.inLfg = sLFGMgr->GetState(bot->GetGUID()) != lfg::LFG_STATE_NONE;
+        state.inBattleground = bot->InBattlegroundQueue() || bot->InBattleground() || bot->InArena();
+        state.onTransport = bot->HasUnitMovementFlag(MOVEMENTFLAG_ONTRANSPORT);
+        state.visibleAtSource = visibleAtSource;
+        auto adaptiveCooldown = adaptiveLevelCohortCooldown.find(botId);
+        auto localCooldown = playerLocalRelocationCooldown.find(botId);
+        state.coolingDown =
+            (adaptiveCooldown != adaptiveLevelCohortCooldown.end() && adaptiveCooldown->second > now) ||
+            (localCooldown != playerLocalRelocationCooldown.end() && localCooldown->second > now);
+
+        if (IsEligible(state))
+            candidates.push_back({bot, anchor, window,
+                CohortLevel(window, anchor->GetLevel(), slot), slot});
+    }
+
+    uint32 budget = CohortMutationBudget(matched, target,
+        sPlayerbotAIConfig.adaptiveLevelCohortMaxChangesPerCycle);
+    uint32 changed = 0;
+    for (Candidate const& candidate : candidates)
+    {
+        if (!budget)
+            break;
+
+        Player* bot = candidate.bot;
+        uint32 botId = bot->GetGUID().GetCounter();
+        uint32 oldLevel = bot->GetLevel();
+        PlayerbotFactory(bot, candidate.desiredLevel).Randomize(true);
+        adaptiveLevelCohortCooldown[botId] =
+            now + sPlayerbotAIConfig.adaptiveLevelCohortChangeCooldownSeconds;
+        playerLocalRelocationCooldown[botId] =
+            now + sPlayerbotAIConfig.adaptiveLevelCohortChangeCooldownSeconds;
+        --budget;
+        ++changed;
+
+        LOG_INFO("playerbots",
+                 "LA24_LEVEL_COHORT action=level_change bot={} old_level={} new_level={} "
+                 "anchor_player={} anchor_level={} window={}-{} slot={} cooldown_seconds={}",
+                 bot->GetName(), oldLevel, bot->GetLevel(), candidate.anchor->GetName(),
+                 candidate.anchor->GetLevel(), candidate.window.lower, candidate.window.upper,
+                 candidate.slot, sPlayerbotAIConfig.adaptiveLevelCohortChangeCooldownSeconds);
+    }
+
+    LOG_INFO("playerbots",
+             "LA24_LEVEL_COHORT action=summary humans={} online_bots={} target={} matched={} "
+             "eligible={} changed={} remaining_gap={}",
+             realPlayers.size(), bots.size(), target, matched, candidates.size(), changed,
+             target > matched + changed ? target - matched - changed : 0);
+}
+void RandomPlayerbotMgr::UpdatePlayerLocalPopulation()
+{
+    using namespace PlayerLocalPopulation;
+
+    PlayerLocalPopulationTimer = time(nullptr);
+    uint32 relocationsRemaining = sPlayerbotAIConfig.playerLocalPopulationMaxRelocationsPerCycle;
+    uint32 totalRelocated = 0;
+    uint32 totalPromoted = 0;
+
+    std::vector<Player*> realPlayers;
+    for (Player* player : players)
+    {
+        if (player && player->IsInWorld() && player->IsAlive() && !player->IsGameMaster() &&
+            !player->IsBeingTeleported() && player->GetMap() && !player->GetMap()->IsDungeon() &&
+            !player->GetMap()->IsBattlegroundOrArena())
+            realPlayers.push_back(player);
+    }
+    std::sort(realPlayers.begin(), realPlayers.end(), [](Player* left, Player* right)
+              { return left->GetGUID().GetCounter() < right->GetGUID().GetCounter(); });
+
+    std::unordered_set<uint32> usedBots;
+    for (Player* player : realPlayers)
+    {
+        WorldPosition playerPosition(player);
+        float maximumDistance = static_cast<float>(sPlayerbotAIConfig.playerLocalPopulationMaximumArrivalDistance);
+        uint32 nearby = 0;
+
+        struct Candidate
+        {
+            Player* bot;
+            bool matched;
+            uint32 levelDelta;
+        };
+        std::vector<Candidate> candidates;
+
+        for (auto const& [guid, bot] : playerBots)
+        {
+            if (!bot)
+                continue;
+
+            uint32 botId = guid.GetCounter();
+            bool sameMap = bot->IsInWorld() && bot->GetMapId() == player->GetMapId();
+            bool sameZone = sameMap && bot->GetZoneId() == player->GetZoneId();
+            bool sameFaction = bot->GetTeamId() == player->GetTeamId();
+            bool matched = IsLevelMatched(bot->GetLevel(), player->GetLevel(),
+                                          sPlayerbotAIConfig.playerLocalPopulationMaximumLevelDelta);
+            bool nearbyBot = sameFaction && sameZone && matched && !bot->GetGroup() &&
+                             playerPosition.sqDistance2d(WorldPosition(bot)) <= maximumDistance * maximumDistance;
+            if (nearbyBot)
+                ++nearby;
+
+            bool visibleAtSource = false;
+            if (bot->IsInWorld())
+            {
+                WorldPosition botPosition(bot);
+                float visibilityDistance = static_cast<float>(sPlayerbotAIConfig.BotActiveAloneForceWhenInRadius);
+                for (Player* realPlayer : realPlayers)
+                {
+                    if (realPlayer->GetMapId() == bot->GetMapId() &&
+                        botPosition.sqDistance2d(WorldPosition(realPlayer)) < visibilityDistance * visibilityDistance)
+                    {
+                        visibleAtSource = true;
+                        break;
+                    }
+                }
+            }
+
+            CandidateState state;
+            state.randomBot = IsRandomBot(bot);
+            state.sameFaction = sameFaction;
+            state.inWorld = bot->IsInWorld();
+            state.alive = bot->IsAlive();
+            state.overworld = bot->GetMap() && !bot->GetMap()->IsDungeon() && !bot->GetMap()->IsBattlegroundOrArena();
+            state.teleporting = bot->IsBeingTeleported();
+            state.rooted = bot->IsRooted();
+            state.inCombat = bot->IsInCombat();
+            state.grouped = bot->GetGroup() != nullptr;
+            state.inLfg = sLFGMgr->GetState(bot->GetGUID()) != lfg::LFG_STATE_NONE;
+            state.inBattleground = bot->InBattlegroundQueue() || bot->InBattleground() || bot->InArena();
+            state.onTransport = bot->HasUnitMovementFlag(MOVEMENTFLAG_ONTRANSPORT);
+            state.visibleAtSource = visibleAtSource;
+            auto cooldown = playerLocalRelocationCooldown.find(botId);
+            state.coolingDown = cooldown != playerLocalRelocationCooldown.end() && cooldown->second > time(nullptr);
+
+            if (!usedBots.count(botId) && IsEligible(state) &&
+                (matched || CanPromote(bot->GetLevel(), player->GetLevel(), DEFAULT_MAX_LEVEL)))
+            {
+                candidates.push_back({bot, matched, LevelDelta(bot->GetLevel(), player->GetLevel())});
+            }
+        }
+
+        uint32 budget = std::min(RelocationBudget(nearby, sPlayerbotAIConfig.playerLocalPopulationTarget,
+                                                   sPlayerbotAIConfig.playerLocalPopulationMaxRelocationsPerCycle),
+                                 relocationsRemaining);
+        std::sort(candidates.begin(), candidates.end(), [](Candidate const& left, Candidate const& right)
+                  {
+                      if (left.matched != right.matched)
+                          return left.matched > right.matched;
+                      if (left.levelDelta != right.levelDelta)
+                          return left.levelDelta < right.levelDelta;
+                      return left.bot->GetGUID().GetCounter() < right.bot->GetGUID().GetCounter();
+                  });
+
+        uint32 relocatedForPlayer = 0;
+        uint32 promotedForPlayer = 0;
+        for (Candidate const& candidate : candidates)
+        {
+            if (!budget)
+                break;
+
+            Player* bot = candidate.bot;
+            uint32 botId = bot->GetGUID().GetCounter();
+            --budget;
+            --relocationsRemaining;
+            bool promoted = false;
+            if (!candidate.matched)
+            {
+                uint32 newLevel = PromotionLevel(player->GetLevel(), botId,
+                                                 sPlayerbotAIConfig.playerLocalPopulationPreferredLevelDelta,
+                                                 DEFAULT_MAX_LEVEL);
+                newLevel = std::max<uint32>(newLevel, bot->GetLevel());
+                PlayerbotFactory(bot, newLevel).Randomize(true);
+                promoted = true;
+            }
+
+            if (!RelocateBotNearPlayer(bot, player))
+            {
+                if (promoted)
+                    playerLocalRelocationCooldown[botId] = time(nullptr) +
+                        sPlayerbotAIConfig.playerLocalPopulationRelocationCooldownSeconds;
+                LOG_INFO("playerbots",
+                         "LA23_LOCAL_POPULATION action=arrival_failed player={} bot={} bot_level={} zone={} "
+                         "promoted={}",
+                         player->GetName(), bot->GetName(), bot->GetLevel(), player->GetZoneId(), promoted);
+                continue;
+            }
+
+            usedBots.insert(botId);
+            playerLocalRelocationCooldown[botId] = time(nullptr) +
+                sPlayerbotAIConfig.playerLocalPopulationRelocationCooldownSeconds;
+            ++relocatedForPlayer;
+            ++totalRelocated;
+            if (promoted)
+            {
+                ++promotedForPlayer;
+                ++totalPromoted;
+            }
+
