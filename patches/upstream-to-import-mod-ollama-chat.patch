diff --git a/tests/telemetry_store_test.cpp b/tests/telemetry_store_test.cpp
new file mode 100644
index 0000000..06d448d
--- /dev/null
+++ b/tests/telemetry_store_test.cpp
@@ -0,0 +1,220 @@
+#include "mod-ollama-chat_telemetry.h"
+#include <nlohmann/json.hpp>
+#include <cassert>
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+#include <string>
+#include <vector>
+
+namespace fs = std::filesystem;
+using json = nlohmann::json;
+
+std::string ReadAll(fs::path const& path)
+{
+    std::ifstream input(path, std::ios::in | std::ios::binary);
+    return std::string(std::istreambuf_iterator<char>(input), std::istreambuf_iterator<char>());
+}
+
+std::vector<json> Records(fs::path const& path)
+{
+    std::vector<json> result;
+    std::ifstream input(path, std::ios::in | std::ios::binary);
+    std::string line;
+    while (std::getline(input, line))
+        if (!line.empty())
+            result.push_back(json::parse(line));
+    return result;
+}
+
+json Find(std::vector<json> const& records, uint64_t requestId)
+{
+    for (json const& record : records)
+        if (record.value("request_id", 0ULL) == requestId)
+            return record;
+    assert(false);
+    return json();
+}
+
+int main(int argc, char** argv)
+{
+    assert(argc == 2);
+    fs::path root(argv[1]);
+    fs::create_directories(root / "events");
+    fs::create_directories(root / "exports");
+    fs::path key = root / "pseudonym.key";
+    std::ofstream(key) << "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
+
+    fs::path expired = root / "events" / "retention.jsonl";
+    std::ofstream(expired) << json({{"expires_unix", 1}, {"marker", "expired"}}).dump() << std::endl
+                           << json({{"expires_unix", 4102444800LL}, {"marker", "live"}}).dump() << std::endl;
+
+    OllamaChatTelemetry::Settings settings;
+    settings.enabled = true;
+    settings.captureSharedChannels = true;
+    settings.captureWhispers = false;
+    settings.maxQueue = 16;
+    settings.rawRetentionDays = 14;
+    settings.dataDirectory = root.string();
+    settings.pseudonymKeyFile = key.string();
+    settings.modelVersion = "offline-test";
+    settings.promptVersion = "la25-v5";
+    settings.policyVersion = "la25-v5";
+    assert(g_OllamaChatTelemetry.Start(settings));
+    assert(ReadAll(expired).find("expired") == std::string::npos);
+    fs::remove(expired);
+
+    OllamaChatTelemetry::ConversationEvent base;
+    base.playerGuid = 123456789;
+    base.botGuid = 987654321;
+    base.channel = 4;
+    base.channelName = "Guild";
+    base.playerName = "Testmage";
+    base.botName = "Brann";
+    base.playerText = "good evening everyone";
+    base.botText = "Evening! How is questing going?";
+    base.deliveryState = "delivered";
+    base.receivedUnixMs = 1787781600000ULL;
+    base.latencyMs = 842;
+    base.requestId = 1000;
+    assert(g_OllamaChatTelemetry.Record(base));
+
+    assert(g_OllamaChatTelemetry.SetConsent(base.playerGuid, true));
+
+    OllamaChatTelemetry::ConversationEvent redacted = base;
+    redacted.requestId = 1001;
+    redacted.channel = 1;
+    redacted.playerText = "email player@example.com from 26.73.175.54";
+    redacted.botText = "visit https://example.com";
+    assert(g_OllamaChatTelemetry.Record(redacted));
+
+    OllamaChatTelemetry::ConversationEvent command = base;
+    command.requestId = 1002;
+    command.playerText = ".account password tester secret";
+    assert(g_OllamaChatTelemetry.Record(command));
+
+    OllamaChatTelemetry::ConversationEvent secret = base;
+    secret.requestId = 1003;
+    secret.playerText = "api_key=abcdefghijklmnopqrstuvwxyz123456";
+    assert(g_OllamaChatTelemetry.Record(secret));
+
+    OllamaChatTelemetry::ConversationEvent shared = base;
+    shared.requestId = 1004;
+    shared.playerText = "guild text retained after consent";
+    shared.botText = "guild response retained";
+    assert(g_OllamaChatTelemetry.Record(shared));
+
+    OllamaChatTelemetry::ConversationEvent whisper = base;
+    whisper.requestId = 1005;
+    whisper.channel = 7;
+    whisper.playerText = "private player whisper";
+    whisper.botText = "private bot whisper";
+    assert(g_OllamaChatTelemetry.Record(whisper));
+
+    OllamaChatTelemetry::ConversationEvent suppressed = base;
+    suppressed.requestId = 1006;
+    suppressed.deliveryState = "suppressed";
+    suppressed.suppressionReason = "duplicate_reply";
+    assert(g_OllamaChatTelemetry.Record(suppressed));
+
+    assert(g_OllamaChatTelemetry.AddFeedback(base.playerGuid, OllamaChatTelemetry::Feedback::Good));
+    assert(g_OllamaChatTelemetry.RequestExport(base.playerGuid));
+    g_OllamaChatTelemetry.Stop();
+
+    fs::path eventFile;
+    for (auto const& candidate : fs::directory_iterator(root / "events"))
+        if (candidate.path().extension() == ".jsonl")
+            eventFile = candidate.path();
+    assert(!eventFile.empty());
+
+    std::string retained = ReadAll(eventFile);
+    assert(retained.find("123456789") == std::string::npos);
+    assert(retained.find("987654321") == std::string::npos);
+    assert(retained.find("player@example.com") == std::string::npos);
+    assert(retained.find("26.73.175.54") == std::string::npos);
+    assert(retained.find("private player whisper") == std::string::npos);
+    assert(retained.find("[redacted-email]") != std::string::npos);
+
+    std::vector<json> records = Records(eventFile);
+    json noConsent = Find(records, 1000);
+    assert(noConsent["schema_version"] == 2);
+    assert(noConsent["consent_state"] == "not_granted");
+    assert(noConsent["privacy_reason"] == "consent_not_granted");
+    assert(noConsent["text_mode"] == "metadata_only");
+    assert(noConsent["player_name"] == "");
+    assert(noConsent["bot_name"] == "Brann");
+
+    json delivered = Find(records, 1001);
+    assert(delivered["delivery_state"] == "delivered");
+    assert(delivered["latency_ms"] == 842);
+    assert(delivered["player_name"] == "Testmage");
+    assert(delivered["bot_name"] == "Brann");
+
+    assert(Find(records, 1002)["privacy_reason"] == "sensitive_content_omitted");
+    assert(Find(records, 1004)["player_text"] == "guild text retained after consent");
+    assert(Find(records, 1005)["privacy_reason"] == "whisper_excluded");
+    assert(Find(records, 1006)["suppression_reason"] == "duplicate_reply");
+
+    auto counters = g_OllamaChatTelemetry.GetCounters();
+    assert(counters.accepted == 7);
+    assert(counters.noConsent == 1);
+    assert(counters.metadataOnly == 4);
+    assert(counters.redacted >= 1);
+    assert(counters.rejectedSensitive == 2);
+    assert(counters.writeFailed == 0);
+
+    assert(g_OllamaChatTelemetry.Start(settings));
+    assert(g_OllamaChatTelemetry.RequestDelete(base.playerGuid));
+    g_OllamaChatTelemetry.Stop();
+    assert(!fs::exists(eventFile));
+
+    fs::path defaultRoot = root / "default-on";
+    OllamaChatTelemetry::Settings defaultSettings = settings;
+    defaultSettings.defaultConsent = true;
+    defaultSettings.dataDirectory = defaultRoot.string();
+    defaultSettings.policyVersion = "la25-v6-default-on";
+    assert(g_OllamaChatTelemetry.Start(defaultSettings));
+
+    OllamaChatTelemetry::ConversationEvent defaultEnabled = base;
+    defaultEnabled.playerGuid = 555555555;
+    defaultEnabled.requestId = 2000;
+    defaultEnabled.playerText = "captured by the realm default";
+    assert(g_OllamaChatTelemetry.IsConsented(defaultEnabled.playerGuid));
+    assert(!g_OllamaChatTelemetry.HasConsentOverride(defaultEnabled.playerGuid));
+    assert(g_OllamaChatTelemetry.Record(defaultEnabled));
+
+    assert(g_OllamaChatTelemetry.SetConsent(defaultEnabled.playerGuid, false));
+    assert(!g_OllamaChatTelemetry.IsConsented(defaultEnabled.playerGuid));
+    assert(g_OllamaChatTelemetry.HasConsentOverride(defaultEnabled.playerGuid));
+    OllamaChatTelemetry::ConversationEvent explicitlyDisabled = defaultEnabled;
+    explicitlyDisabled.requestId = 2001;
+    explicitlyDisabled.playerText = "must not be retained after opt out";
+    assert(g_OllamaChatTelemetry.Record(explicitlyDisabled));
+    g_OllamaChatTelemetry.Stop();
+
+    fs::path defaultEventFile;
+    for (auto const& candidate : fs::directory_iterator(defaultRoot / "events"))
+        if (candidate.path().extension() == ".jsonl")
+            defaultEventFile = candidate.path();
+    assert(!defaultEventFile.empty());
+    std::vector<json> defaultRecords = Records(defaultEventFile);
+    json defaultRecord = Find(defaultRecords, 2000);
+    assert(defaultRecord["consent_state"] == "granted");
+    assert(defaultRecord["consent_source"] == "default");
+    assert(defaultRecord["player_text"] == "captured by the realm default");
+    json optOutRecord = Find(defaultRecords, 2001);
+    assert(optOutRecord["consent_state"] == "not_granted");
+    assert(optOutRecord["consent_source"] == "explicit");
+    assert(optOutRecord["text_mode"] == "metadata_only");
+    assert(optOutRecord["player_text"] == "");
+
+    assert(g_OllamaChatTelemetry.Start(defaultSettings));
+    assert(!g_OllamaChatTelemetry.IsConsented(defaultEnabled.playerGuid));
+    assert(g_OllamaChatTelemetry.HasConsentOverride(defaultEnabled.playerGuid));
+    g_OllamaChatTelemetry.Stop();
+
+    std::cout << "PASS accepted=" << counters.accepted
+              << " metadata_only=" << counters.metadataOnly
+              << " rejected_sensitive=" << counters.rejectedSensitive << std::endl;
+    return 0;
+}
