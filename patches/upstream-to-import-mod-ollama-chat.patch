+        case CHAT_MSG_YELL:
+            return SRC_YELL_LOCAL;
+        case CHAT_MSG_WHISPER:
+        case CHAT_MSG_WHISPER_FOREIGN:
+        case CHAT_MSG_WHISPER_INFORM:
+            return SRC_WHISPER_LOCAL;
+        case CHAT_MSG_CHANNEL:
+            return SRC_GENERAL_LOCAL;
