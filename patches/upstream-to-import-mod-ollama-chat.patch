@@ -0,0 +1,152 @@
+#ifndef MOD_OLLAMA_CHAT_TELEMETRY_H
+#define MOD_OLLAMA_CHAT_TELEMETRY_H
+
+#include <atomic>
+#include <condition_variable>
+#include <cstdint>
+#include <deque>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <unordered_map>
+
+namespace OllamaChatTelemetry
+{
+enum class Feedback : uint8_t
+{
+    Good,
+    Wrong,
+    Repetitive,
+    Unnatural,
+    Forgot,
+    Unsafe
+};
+
+struct Settings
+{
+    bool enabled = false;
+    bool defaultConsent = false;
+    bool captureSharedChannels = false;
+    bool captureWhispers = false;
+    uint32_t maxQueue = 256;
+    uint32_t maxTextBytes = 240;
+    uint32_t rawRetentionDays = 30;
+    std::string dataDirectory;
+    std::string pseudonymKeyFile;
+    std::string policyVersion = "la25-v1";
+    std::string modelVersion;
+    std::string promptVersion = "la25-v1";
+};
+
+struct ConversationEvent
+{
+    uint64_t requestId = 0;
+    uint64_t playerGuid = 0;
+    uint64_t botGuid = 0;
+    uint32_t mapId = 0;
+    uint32_t zoneId = 0;
+    uint8_t playerLevel = 0;
+    uint8_t playerClass = 0;
+    bool inGroup = false;
+    bool inDungeon = false;
+    uint8_t channel = 0;
+    std::string channelName;
+    std::string playerName;
+    std::string botName;
+    std::string playerText;
+    std::string botText;
+    std::string lifecycleState = "completed";
+    std::string deliveryState = "unknown";
+    std::string suppressionReason;
+    std::string privacyReason;
+    uint64_t receivedUnixMs = 0;
+    uint32_t latencyMs = 0;
+    bool consentGranted = false;
+    std::string consentSource = "default";
+    bool metadataOnly = false;
+    bool redactionApplied = false;
+};
+
+struct Counters
+{
+    uint64_t accepted = 0;
+    uint64_t noConsent = 0;
+    uint64_t metadataOnly = 0;
+    uint64_t redacted = 0;
+    uint64_t rejectedSensitive = 0;
+    uint64_t queueFull = 0;
+    uint64_t writeFailed = 0;
+};
+
+class Store
+{
+public:
+    Store();
+    ~Store();
+
+    Store(Store const&) = delete;
+    Store& operator=(Store const&) = delete;
+
+    bool Start(Settings settings);
+    void Stop();
+    bool IsRunning() const;
+    bool IsConsented(uint64_t playerGuid) const;
+    bool HasConsentOverride(uint64_t playerGuid) const;
+    bool SetConsent(uint64_t playerGuid, bool enabled);
+    bool RequestDelete(uint64_t playerGuid);
+    bool RequestExport(uint64_t playerGuid);
+    bool Record(ConversationEvent event);
+    bool AddFeedback(uint64_t playerGuid, Feedback feedback);
+    Counters GetCounters() const;
+
+    // Pure helper exposed for isolated offline tests.
+    static std::string FeedbackName(Feedback feedback);
+    static bool SanitizeText(std::string const& input, uint32_t maxBytes,
+        std::string& output, bool& changed);
+
+private:
+    enum class WorkType : uint8_t { Event, Consent, Delete, Export, Feedback, Stop };
+    struct WorkItem
+    {
+        WorkType type = WorkType::Event;
+        ConversationEvent event;
+        std::string playerId;
+        bool consent = false;
+        Feedback feedback = Feedback::Good;
+    };
+
+    bool Enqueue(WorkItem item);
+    void WorkerLoop();
+    bool LoadKey();
+    bool LoadConsent();
+    std::string Pseudonym(uint64_t rawGuid) const;
+    bool WriteEvent(ConversationEvent const& event, std::string const& playerId);
+    bool WriteControl(WorkItem const& item);
+    bool DeletePlayerData(std::string const& playerId);
+    bool ExportPlayerData(std::string const& playerId);
+    void ApplyRetention();
+
+    Settings _settings;
+    std::string _secret;
+    mutable std::mutex _stateMutex;
+    std::unordered_map<std::string, bool> _consent;
+    std::unordered_map<std::string, uint64_t> _lastRequestByPlayer;
+    mutable std::mutex _queueMutex;
+    std::condition_variable _queueCv;
+    std::deque<WorkItem> _queue;
+    std::thread _worker;
+    bool _accepting = false;
+    bool _running = false;
+    std::atomic<uint64_t> _accepted{0};
+    std::atomic<uint64_t> _noConsent{0};
+    std::atomic<uint64_t> _metadataOnly{0};
+    std::atomic<uint64_t> _redacted{0};
+    std::atomic<uint64_t> _rejectedSensitive{0};
+    std::atomic<uint64_t> _queueFull{0};
+    std::atomic<uint64_t> _writeFailed{0};
+};
+}
+
+extern OllamaChatTelemetry::Store g_OllamaChatTelemetry;
+
+#endif
diff --git a/src/mod-ollama-chat_winhttp.cpp b/src/mod-ollama-chat_winhttp.cpp
