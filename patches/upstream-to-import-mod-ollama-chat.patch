+#ifndef LA25_TEST_HMAC_H
+#define LA25_TEST_HMAC_H
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <openssl/hmac.h>
+#include <string>
+#include <vector>
+
+using uint8 = uint8_t;
+
+namespace Acore::Crypto
+{
+struct HMAC_SHA256
+{
+    using Digest = std::array<uint8_t, 32>;
+
+    HMAC_SHA256(uint8_t const* seed, std::size_t length) : _seed(seed, seed + length) {}
+
+    void UpdateData(std::string const& data)
+    {
+        _data.insert(_data.end(), data.begin(), data.end());
+    }
+
+    void Finalize()
+    {
+        unsigned int length = 0;
+        HMAC(EVP_sha256(), _seed.data(), static_cast<int>(_seed.size()),
+            _data.data(), _data.size(), _digest.data(), &length);
+    }
+
+    Digest const& GetDigest() const { return _digest; }
+
+    template <typename Seed, typename Data>
+    static Digest GetDigestOf(Seed const& seed, Data const& data)
+    {
+        Digest result{};
+        unsigned int length = 0;
+        HMAC(EVP_sha256(), seed.data(), static_cast<int>(seed.size()),
+            reinterpret_cast<unsigned char const*>(data.data()), data.size(),
+            result.data(), &length);
+        return result;
+    }
+
+private:
+    std::vector<uint8_t> _seed;
+    std::vector<uint8_t> _data;
+    Digest _digest{};
+};
+}
+#endif
