index 0000000..f381117
--- /dev/null
+++ b/src/mod-ollama-chat_winhttp.cpp
@@ -0,0 +1,201 @@
+#ifdef _WIN32
+
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#include <winhttp.h>
+#pragma comment(lib, "winhttp.lib")
+
+#include "mod-ollama-chat_winhttp.h"
+#include "mod-ollama-chat_config.h"
+#include "Log.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cstdint>
+#include <limits>
+#include <string>
+
+namespace
+{
+class ScopedHandle
+{
+public:
+    explicit ScopedHandle(HINTERNET value = nullptr) : _value(value) { }
+    ~ScopedHandle() { if (_value) WinHttpCloseHandle(_value); }
+    ScopedHandle(ScopedHandle const&) = delete;
+    ScopedHandle& operator=(ScopedHandle const&) = delete;
+    operator HINTERNET() const { return _value; }
+    explicit operator bool() const { return _value != nullptr; }
+
+private:
+    HINTERNET _value;
+};
+
+std::wstring ToWide(std::string const& value)
+{
+    if (value.empty())
+        return {};
+    int length = MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, value.data(),
+        static_cast<int>(value.size()), nullptr, 0);
+    if (length <= 0)
+        return {};
+    std::wstring result(static_cast<size_t>(length), L'\0');
+    if (MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, value.data(),
+        static_cast<int>(value.size()), result.data(), length) != length)
+        return {};
+    return result;
+}
+
+DWORD TimeoutMs(uint32_t configuredSeconds)
+{
+    uint32_t total = std::max<uint32_t>(1, g_TotalTimeoutSeconds);
+    return std::min(std::max<uint32_t>(1, configuredSeconds), total) * 1000;
+}
+
+void LogFailure(char const* operation)
+{
+    LOG_ERROR("server.loading", "[Ollama Chat] WinHTTP {} failed; error={}", operation, GetLastError());
+}
+}
+
+std::string PostOllamaWithWinHttp(std::string const& url, std::string const& jsonData)
+{
+    constexpr size_t MaxResponseBytes = 1024 * 1024;
+    std::wstring wideUrl = ToWide(url);
+    if (wideUrl.empty())
+    {
+        LOG_ERROR("server.loading", "[Ollama Chat] WinHTTP rejected configured URL");
+        return {};
+    }
+
+    URL_COMPONENTS parts{};
+    parts.dwStructSize = sizeof(parts);
+    parts.dwSchemeLength = static_cast<DWORD>(-1);
+    parts.dwHostNameLength = static_cast<DWORD>(-1);
+    parts.dwUrlPathLength = static_cast<DWORD>(-1);
+    parts.dwExtraInfoLength = static_cast<DWORD>(-1);
+    if (!WinHttpCrackUrl(wideUrl.c_str(), 0, 0, &parts))
+    {
+        LogFailure("URL parse");
+        return {};
+    }
+
+    std::wstring host(parts.lpszHostName, parts.dwHostNameLength);
+    std::wstring path;
+    if (parts.dwUrlPathLength)
+        path.assign(parts.lpszUrlPath, parts.dwUrlPathLength);
+    if (parts.dwExtraInfoLength)
+        path.append(parts.lpszExtraInfo, parts.dwExtraInfoLength);
+    if (path.empty())
+        path = L"/";
+
+    ScopedHandle session(WinHttpOpen(L"AzerothCore-OllamaChat/2.0",
+        WINHTTP_ACCESS_TYPE_NO_PROXY, WINHTTP_NO_PROXY_NAME, WINHTTP_NO_PROXY_BYPASS, 0));
+    if (!session)
+    {
+        LogFailure("session open");
+        return {};
+    }
+
+    if (!WinHttpSetTimeouts(session, TimeoutMs(g_ConnectTimeoutSeconds),
+        TimeoutMs(g_ConnectTimeoutSeconds), TimeoutMs(g_WriteTimeoutSeconds),
+        TimeoutMs(g_ReadTimeoutSeconds)))
+    {
+        LogFailure("timeout setup");
+        return {};
+    }
+
+    ScopedHandle connection(WinHttpConnect(session, host.c_str(), parts.nPort, 0));
+    if (!connection)
+    {
+        LogFailure("connect");
+        return {};
+    }
+
+    DWORD flags = parts.nScheme == INTERNET_SCHEME_HTTPS ? WINHTTP_FLAG_SECURE : 0;
+    ScopedHandle request(WinHttpOpenRequest(connection, L"POST", path.c_str(), nullptr,
+        WINHTTP_NO_REFERER, WINHTTP_DEFAULT_ACCEPT_TYPES, flags));
+    if (!request)
+    {
+        LogFailure("request open");
+        return {};
+    }
+
+    if (jsonData.size() > static_cast<size_t>(std::numeric_limits<DWORD>::max()))
+    {
+        LOG_ERROR("server.loading", "[Ollama Chat] WinHTTP request exceeded size limit");
+        return {};
+    }
+
+    wchar_t const* headers = L"Content-Type: application/json\r\nAccept: application/json\r\n";
+    auto started = std::chrono::steady_clock::now();
+    if (!WinHttpSendRequest(request, headers, static_cast<DWORD>(-1),
+        const_cast<char*>(jsonData.data()), static_cast<DWORD>(jsonData.size()),
+        static_cast<DWORD>(jsonData.size()), 0))
+    {
+        LogFailure("send");
+        return {};
+    }
+    if (!WinHttpReceiveResponse(request, nullptr))
+    {
+        LogFailure("receive");
+        return {};
+    }
+
+    DWORD status = 0;
+    DWORD statusBytes = sizeof(status);
+    if (!WinHttpQueryHeaders(request, WINHTTP_QUERY_STATUS_CODE | WINHTTP_QUERY_FLAG_NUMBER,
+        WINHTTP_HEADER_NAME_BY_INDEX, &status, &statusBytes, WINHTTP_NO_HEADER_INDEX) || status != 200)
+    {
+        LOG_ERROR("server.loading", "[Ollama Chat] WinHTTP response status={}", status);
+        return {};
+    }
+
+    std::string response;
+    for (;;)
+    {
+        DWORD available = 0;
+        if (!WinHttpQueryDataAvailable(request, &available))
+        {
+            LogFailure("response query");
+            return {};
+        }
+        if (!available)
+            break;
+        if (response.size() + available > MaxResponseBytes)
+        {
+            LOG_ERROR("server.loading", "[Ollama Chat] WinHTTP response exceeded {} bytes", MaxResponseBytes);
+            return {};
+        }
+
+        size_t offset = response.size();
+        response.resize(offset + available);
+        DWORD read = 0;
+        if (!WinHttpReadData(request, response.data() + offset, available, &read))
+        {
+            LogFailure("response read");
+            return {};
+        }
+        response.resize(offset + read);
+
+        auto elapsed = std::chrono::duration_cast<std::chrono::seconds>(
+            std::chrono::steady_clock::now() - started).count();
+        if (elapsed > static_cast<int64_t>(std::max<uint32_t>(1, g_TotalTimeoutSeconds)))
+        {
+            LOG_ERROR("server.loading", "[Ollama Chat] WinHTTP total timeout exceeded");
+            return {};
+        }
+    }
+
+    if (g_DebugEnabled)
+        LOG_INFO("server.loading", "[Ollama Chat] WinHTTP request successful, response length: {}", response.size());
+    return response;
+}
+
+#endif
+
