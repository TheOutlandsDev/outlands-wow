diff --git a/src/mod-ollama-chat_social.h b/src/mod-ollama-chat_social.h
new file mode 100644
index 0000000..ee27007
--- /dev/null
+++ b/src/mod-ollama-chat_social.h
@@ -0,0 +1,318 @@
+#pragma once
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <ctime>
+#include <optional>
+#include <unordered_map>
+#include <unordered_set>
+
+namespace OllamaChatSocial
+{
+using Guid = std::uint64_t;
+
+struct ChannelKey
+{
+    std::uint8_t source = 0;
+    std::uint64_t scope = 0;
+    std::uint8_t faction = 0;
+
+    bool operator==(ChannelKey const& other) const
+    {
+        return source == other.source && scope == other.scope && faction == other.faction;
+    }
+};
+
+struct ChannelKeyHash
+{
+    std::size_t operator()(ChannelKey const& key) const
+    {
+        std::size_t value = static_cast<std::size_t>(key.scope ^ (key.scope >> 32));
+        value ^= static_cast<std::size_t>(key.source) << 1;
+        value ^= static_cast<std::size_t>(key.faction) << 9;
+        return value;
+    }
+};
+
+struct Settings
+{
+    bool enabled = true;
+    std::uint32_t threadTtlSeconds = 180;
+    std::uint32_t followUpCooldownSeconds = 90;
+    std::uint32_t humanQuietSeconds = 120;
+    std::uint32_t ambientCooldownSeconds = 900;
+    std::uint32_t ambientHourlyBudget = 2;
+    std::uint8_t maxDepth = 2;
+    std::uint8_t maxBotParticipants = 3;
+    std::size_t maxThreads = 256;
+    std::size_t maxChannels = 128;
+};
+
+class Coordinator
+{
+public:
+    explicit Coordinator(Settings settings = {}) : settings_(Sanitize(settings)) { }
+
+    void Configure(Settings settings)
+    {
+        settings_ = Sanitize(settings);
+        EnforceLimits();
+    }
+
+    bool Enabled() const { return settings_.enabled; }
+
+    void Clear()
+    {
+        threads_.clear();
+        channels_.clear();
+        nextThreadId_ = 1;
+    }
+
+    void ObserveHumanPresence(ChannelKey const& key, std::time_t now)
+    {
+        if (!settings_.enabled || !Valid(key))
+            return;
+        ChannelState& channel = TouchChannel(key, now);
+        if (!channel.presenceInitialized)
+        {
+            channel.presenceInitialized = true;
+            channel.lastHumanAt = now;
+        }
+    }
+
+    void ObserveHumanActivity(ChannelKey const& key, std::time_t now)
+    {
+        if (!settings_.enabled || !Valid(key))
+            return;
+        ChannelState& channel = TouchChannel(key, now);
+        channel.presenceInitialized = true;
+        channel.lastHumanAt = now;
+    }
+
+    std::uint64_t BeginHumanTurn(ChannelKey const& key, Guid humanGuid, Guid primaryBotGuid,
+                                 std::time_t now)
+    {
+        if (!settings_.enabled || !Valid(key) || !humanGuid || !primaryBotGuid)
+            return 0;
+        ChannelState& channel = TouchChannel(key, now);
+        channel.presenceInitialized = true;
+        channel.lastHumanAt = now;
+
+        std::uint64_t id = nextThreadId_++;
+        if (!id)
+            id = nextThreadId_++;
+        ThreadState thread;
+        thread.id = id;
+        thread.key = key;
+        thread.humanGuid = humanGuid;
+        thread.startedAt = now;
+        thread.lastActivityAt = now;
+        thread.botParticipants.insert(primaryBotGuid);
+        threads_[id] = std::move(thread);
+        EnforceLimits();
+        return id;
+    }
+
+    bool ReserveFollowUp(std::uint64_t threadId, Guid botGuid, std::time_t now)
+    {
+        if (!settings_.enabled || !threadId || !botGuid)
+            return false;
+        auto found = threads_.find(threadId);
+        if (found == threads_.end())
+            return false;
+        ThreadState& thread = found->second;
+        if (Expired(thread, now) || thread.depth >= settings_.maxDepth ||
+            thread.botParticipants.count(botGuid) ||
+            thread.botParticipants.size() >= settings_.maxBotParticipants)
+            return false;
+
+        ChannelState& channel = TouchChannel(thread.key, now);
+        if (channel.lastFollowUpAt && (now < channel.lastFollowUpAt ||
+            static_cast<std::uint64_t>(now - channel.lastFollowUpAt) <
+                settings_.followUpCooldownSeconds))
+            return false;
+
+        ++thread.depth;
+        thread.botParticipants.insert(botGuid);
+        thread.lastActivityAt = now;
+        channel.lastFollowUpAt = now;
+        return true;
+    }
+
+    bool ReserveAmbient(ChannelKey const& key, std::time_t now)
+    {
+        if (!settings_.enabled || !Valid(key))
+            return false;
+        ChannelState& channel = TouchChannel(key, now);
+        if (!channel.presenceInitialized)
+        {
+            channel.presenceInitialized = true;
+            channel.lastHumanAt = now;
+            return false;
+        }
+        if (now < channel.lastHumanAt ||
+            static_cast<std::uint64_t>(now - channel.lastHumanAt) < settings_.humanQuietSeconds)
+            return false;
+        if (channel.lastAmbientAt && (now < channel.lastAmbientAt ||
+            static_cast<std::uint64_t>(now - channel.lastAmbientAt) <
+                settings_.ambientCooldownSeconds))
+            return false;
+        if (!channel.hourWindowAt || now < channel.hourWindowAt ||
+            static_cast<std::uint64_t>(now - channel.hourWindowAt) >= 3600)
+        {
+            channel.hourWindowAt = now;
+            channel.ambientCount = 0;
+        }
+        if (channel.ambientCount >= settings_.ambientHourlyBudget)
+            return false;
+        ++channel.ambientCount;
+        channel.lastAmbientAt = now;
+        channel.lastTouched = now;
+        return true;
+    }
+
+    bool IsThreadActive(std::uint64_t threadId, std::time_t now) const
+    {
+        auto found = threads_.find(threadId);
+        return found != threads_.end() && !Expired(found->second, now);
+    }
+
+    std::size_t ThreadCount() const { return threads_.size(); }
+    std::size_t ChannelCount() const { return channels_.size(); }
+
+    void Expire(std::time_t now)
+    {
+        for (auto itr = threads_.begin(); itr != threads_.end();)
+        {
+            if (Expired(itr->second, now))
+                itr = threads_.erase(itr);
+            else
+                ++itr;
+        }
+        std::uint64_t channelTtl = std::max<std::uint64_t>(
+            3600, static_cast<std::uint64_t>(settings_.ambientCooldownSeconds) * 4);
+        for (auto itr = channels_.begin(); itr != channels_.end();)
+        {
+            if (now >= itr->second.lastTouched &&
+                static_cast<std::uint64_t>(now - itr->second.lastTouched) > channelTtl)
+                itr = channels_.erase(itr);
+            else
+                ++itr;
+        }
+    }
+
+private:
+    struct ThreadState
+    {
+        std::uint64_t id = 0;
+        ChannelKey key;
+        Guid humanGuid = 0;
+        std::time_t startedAt = 0;
+        std::time_t lastActivityAt = 0;
+        std::uint8_t depth = 0;
+        std::unordered_set<Guid> botParticipants;
+    };
+
+    struct ChannelState
+    {
+        bool presenceInitialized = false;
+        std::time_t lastHumanAt = 0;
+        std::time_t lastFollowUpAt = 0;
+        std::time_t lastAmbientAt = 0;
+        std::time_t hourWindowAt = 0;
+        std::time_t lastTouched = 0;
+        std::uint32_t ambientCount = 0;
+    };
+
+    static Settings Sanitize(Settings settings)
+    {
+        settings.threadTtlSeconds = std::clamp<std::uint32_t>(
+            settings.threadTtlSeconds, 30, 900);
+        settings.followUpCooldownSeconds = std::clamp<std::uint32_t>(
+            settings.followUpCooldownSeconds, 5, 900);
+        settings.humanQuietSeconds = std::clamp<std::uint32_t>(
+            settings.humanQuietSeconds, 15, 1800);
+        settings.ambientCooldownSeconds = std::clamp<std::uint32_t>(
+            settings.ambientCooldownSeconds, 60, 7200);
+        settings.ambientHourlyBudget = std::clamp<std::uint32_t>(
+            settings.ambientHourlyBudget, 1, 12);
+        settings.maxDepth = std::clamp<std::uint8_t>(settings.maxDepth, 1, 4);
+        settings.maxBotParticipants = std::clamp<std::uint8_t>(
+            settings.maxBotParticipants, 2, 4);
+        settings.maxThreads = std::clamp<std::size_t>(settings.maxThreads, 8, 1024);
+        settings.maxChannels = std::clamp<std::size_t>(settings.maxChannels, 2, 512);
+        return settings;
+    }
+
+    static bool Valid(ChannelKey const& key)
+    {
+        return key.source != 0 && key.scope != 0;
+    }
+
+    bool Expired(ThreadState const& thread, std::time_t now) const
+    {
+        return now < thread.lastActivityAt ||
+            static_cast<std::uint64_t>(now - thread.lastActivityAt) >
+                settings_.threadTtlSeconds;
+    }
+
+    ChannelState& TouchChannel(ChannelKey const& key, std::time_t now)
+    {
+        auto found = channels_.find(key);
+        if (found == channels_.end())
+        {
+            while (channels_.size() >= settings_.maxChannels)
+            {
+                auto oldest = std::min_element(channels_.begin(), channels_.end(),
+                    [](auto const& left, auto const& right)
+                    {
+                        return left.second.lastTouched < right.second.lastTouched;
+                    });
+                if (oldest == channels_.end())
+                    break;
+                channels_.erase(oldest);
+            }
+            found = channels_.emplace(key, ChannelState{}).first;
+        }
+        found->second.lastTouched = std::max(found->second.lastTouched, now);
+        return found->second;
+    }
+
+    void EnforceLimits()
+    {
+        while (threads_.size() > settings_.maxThreads)
+        {
+            auto oldest = std::min_element(threads_.begin(), threads_.end(),
+                [](auto const& left, auto const& right)
+                {
+                    return left.second.lastActivityAt < right.second.lastActivityAt;
+                });
+            if (oldest == threads_.end())
+                break;
+            threads_.erase(oldest);
+        }
+        EnforceChannelLimit();
+    }
+
+    void EnforceChannelLimit()
+    {
+        while (channels_.size() > settings_.maxChannels)
+        {
+            auto oldest = std::min_element(channels_.begin(), channels_.end(),
+                [](auto const& left, auto const& right)
+                {
+                    return left.second.lastTouched < right.second.lastTouched;
+                });
+            if (oldest == channels_.end())
+                break;
+            channels_.erase(oldest);
+        }
+    }
+
+    Settings settings_;
+    std::uint64_t nextThreadId_ = 1;
+    std::unordered_map<std::uint64_t, ThreadState> threads_;
+    std::unordered_map<ChannelKey, ChannelState, ChannelKeyHash> channels_;
+};
+}
