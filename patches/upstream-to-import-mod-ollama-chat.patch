+bool Store::Start(Settings settings)
+{
+    {
+        std::lock_guard<std::mutex> lock(_queueMutex);
+        if (_running)
+            return true;
+    }
+
+    if (!settings.enabled)
+    {
+        LOG_INFO("server.loading", "[Ollama Chat Telemetry] disabled_by_config");
+        return true;
+    }
+
+    settings.maxQueue = std::clamp<uint32_t>(settings.maxQueue, 16, 4096);
+    settings.maxTextBytes = std::clamp<uint32_t>(settings.maxTextBytes, 32, 1024);
+    settings.rawRetentionDays = std::clamp<uint32_t>(settings.rawRetentionDays, 1, 365);
+    _settings = std::move(settings);
+
+    if (_settings.dataDirectory.empty() || _settings.pseudonymKeyFile.empty())
+    {
+        LOG_ERROR("server.loading", "[Ollama Chat Telemetry] start_failed reason=missing_path");
+        return false;
+    }
+
+    if (!LoadKey())
+        return false;
+
+    try
+    {
+        fs::create_directories(fs::path(_settings.dataDirectory) / "events");
+        fs::create_directories(fs::path(_settings.dataDirectory) / "control");
+        fs::create_directories(fs::path(_settings.dataDirectory) / "exports");
+    }
+    catch (std::exception const& ex)
+    {
+        LOG_ERROR("server.loading", "[Ollama Chat Telemetry] start_failed reason=directory error={}", ex.what());
+        return false;
+    }
+
+    if (!LoadConsent())
+        return false;
+
+    ApplyRetention();
+    {
+        std::lock_guard<std::mutex> lock(_queueMutex);
+        _accepting = true;
+        _running = true;
+    }
+    _worker = std::thread(&Store::WorkerLoop, this);
+    LOG_INFO("server.loading",
+        "[Ollama Chat Telemetry] started worker_count=1 max_queue={} retention_days={} default_consent={} "
+        "shared_text={} whisper_text={}",
+        _settings.maxQueue, _settings.rawRetentionDays, _settings.defaultConsent,
+        _settings.captureSharedChannels, _settings.captureWhispers);
+    return true;
+}
+
+void Store::Stop()
+{
+    {
+        std::lock_guard<std::mutex> lock(_queueMutex);
+        if (!_running)
+            return;
+        _accepting = false;
+        WorkItem stop;
+        stop.type = WorkType::Stop;
+        _queue.emplace_back(std::move(stop));
+    }
+    _queueCv.notify_one();
+    if (_worker.joinable())
+        _worker.join();
+    {
+        std::lock_guard<std::mutex> lock(_queueMutex);
+        _queue.clear();
+        _running = false;
+    }
+    LOG_INFO("server.loading",
+        "[Ollama Chat Telemetry] stopped accepted={} no_consent={} metadata_only={} redacted={} "
+        "rejected_sensitive={} queue_full={} write_failed={}",
+        _accepted.load(), _noConsent.load(), _metadataOnly.load(), _redacted.load(),
+        _rejectedSensitive.load(), _queueFull.load(), _writeFailed.load());
+}
