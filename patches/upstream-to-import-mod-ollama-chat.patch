+OllamaChat.ConversationContinuity.MaxTurnsPerPlayer = 8
+OllamaChat.ConversationContinuity.MaxRecentReplies = 8
+OllamaChat.ConversationContinuity.MaxMessageBytes = 240
+OllamaChat.ConversationContinuity.MaxContextBytes = 1200
+
 # OllamaChat.EnableChatBotSnapshotTemplate
