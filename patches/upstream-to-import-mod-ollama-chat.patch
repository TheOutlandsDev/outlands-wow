+
+// Definition of the configuration WorldScript.
+OllamaChatConfigWorldScript::OllamaChatConfigWorldScript() : WorldScript("OllamaChatConfigWorldScript") { }
+
+void OllamaChatConfigWorldScript::OnStartup()
+{
+    LoadOllamaChatConfig();
+    ConfigureSocialConversation();
+
+    if (g_EnableRandomChatter || g_EnableEventChatter || g_EnableSentimentTracking || g_EnableTypingSimulation)
+    {
+        LOG_WARN("server.loading", "[Ollama Chat] LA21 reply-only safety profile disabled random, event, sentiment, "
+            "and typing systems");
+        g_EnableRandomChatter = false;
+        g_EnableEventChatter = false;
+        g_EnableSentimentTracking = false;
+        g_EnableTypingSimulation = false;
+    }
+
+    OllamaChatTelemetry::Settings telemetrySettings;
+    telemetrySettings.enabled = g_EnableConversationTelemetry;
+    telemetrySettings.defaultConsent = g_TelemetryDefaultConsent;
+    telemetrySettings.captureSharedChannels = g_TelemetryCaptureSharedChannels;
+    telemetrySettings.captureWhispers = g_TelemetryCaptureWhispers;
+    telemetrySettings.maxQueue = g_TelemetryMaxQueue;
+    telemetrySettings.maxTextBytes = g_TelemetryMaxTextBytes;
+    telemetrySettings.rawRetentionDays = g_TelemetryRawRetentionDays;
+    telemetrySettings.dataDirectory = g_TelemetryDataDirectory;
+    telemetrySettings.pseudonymKeyFile = g_TelemetryPseudonymKeyFile;
+    telemetrySettings.policyVersion = g_TelemetryPolicyVersion;
+    telemetrySettings.modelVersion = g_OllamaModel;
+    telemetrySettings.promptVersion = g_TelemetryPromptVersion;
+    if (!g_OllamaChatTelemetry.Start(std::move(telemetrySettings)))
+    {
+        g_EnableConversationTelemetry = false;
+        LOG_ERROR("server.loading", "[Ollama Chat Telemetry] disabled_after_start_failure");
+    }
+
+    if (g_Enable && !g_queryManager.Start())
+        LOG_ERROR("server.loading", "[Ollama Chat] Scheduler failed to start");
+
+    if (g_Enable && sConfigMgr->GetOption<bool>("OllamaChat.BackendProbe.Enable", false))
+    {
+        std::string prompt = sConfigMgr->GetOption<std::string>(
+            "OllamaChat.BackendProbe.Prompt", "Reply briefly to confirm the backend is ready.");
+        uint64_t requestId = 0;
+        QuerySubmitResult submitResult = SubmitQuery(prompt, 0xFFFFFFFFFFFFFFF0ULL, 0xFFFFFFFFFFFFFFE0ULL,
+            [](uint64_t completedRequestId, std::string response)
+        {
+            if (response.empty())
+            {
+                LOG_ERROR("server.loading", "[Ollama Chat] request_id={} result=backend_probe_fail response_bytes=0",
+                    completedRequestId);
+                return;
+            }
+
+            LOG_INFO("server.loading", "[Ollama Chat] request_id={} result=backend_probe_pass response_bytes={}",
+                completedRequestId, response.size());
+        }, requestId);
+        if (submitResult != QuerySubmitResult::Accepted)
+            LOG_ERROR("server.loading", "[Ollama Chat] request_id={} result=backend_probe_submit_failed reason={}",
+                requestId, QuerySubmitResultName(submitResult));
+    }
+
+    LoadBotPersonalityList();
+    LoadBotConversationHistoryFromDB();
+    InitializeSentimentTracking();
+
+    // Initialize RAG system if enabled
+    if (g_EnableRAG) {
+        if (g_RAGSystem) {
+            delete g_RAGSystem;
+        }
+        g_RAGSystem = new OllamaRAGSystem();
+        if (!g_RAGSystem->Initialize()) {
+            LOG_ERROR("server.loading", "[Ollama Chat] Failed to initialize RAG system");
+            delete g_RAGSystem;
+            g_RAGSystem = nullptr;
+        } else {
+            LOG_INFO("server.loading", "[Ollama Chat] RAG system initialized successfully");
+        }
+    }
+}
+
+void OllamaChatConfigWorldScript::OnUpdate(uint32 diff)
+{
+    g_queryManager.DrainCompletions();
+    UpdateSocialConversation(diff);
+    time_t now = time(nullptr);
+    if (g_ConversationHistorySaveInterval > 0 &&
+        difftime(now, g_LastHistorySaveTime) >= g_ConversationHistorySaveInterval * 60)
+    {
+        SaveBotConversationHistoryToDB();
+        g_LastHistorySaveTime = now;
+    }
+
+    static time_t lastExpiry = 0;
+    if (difftime(now, lastExpiry) >= 60)
+    {
+        g_ConversationContinuity.Expire(now);
+        lastExpiry = now;
+    }
+}
+
+void OllamaChatConfigWorldScript::OnShutdown()
+{
+    g_queryManager.Stop();
+    ResetSocialConversation();
+    g_OllamaChatTelemetry.Stop();
+    SaveBotConversationHistoryToDB();
+
+    // Clean up RAG system
+    if (g_RAGSystem) {
+        delete g_RAGSystem;
+        g_RAGSystem = nullptr;
+        LOG_INFO("server.loading", "[Ollama Chat] RAG system cleaned up");
+    }
+}
