+#include "mod-ollama-chat_social.h"
+
+#include <cassert>
+#include <iostream>
+
+int main()
+{
+    OllamaChatSocial::Settings settings;
+    settings.threadTtlSeconds = 60;
+    settings.followUpCooldownSeconds = 30;
+    settings.humanQuietSeconds = 15;
+    settings.ambientCooldownSeconds = 60;
+    settings.ambientHourlyBudget = 2;
+    settings.maxDepth = 2;
+    settings.maxBotParticipants = 3;
+    settings.maxThreads = 8;
+    settings.maxChannels = 2;
+
+    OllamaChatSocial::Coordinator coordinator(settings);
+    OllamaChatSocial::ChannelKey allianceGuild{4, 100, 0};
+    OllamaChatSocial::ChannelKey hordeGuild{4, 200, 1};
+
+    coordinator.ObserveHumanPresence(allianceGuild, 100);
+    assert(!coordinator.ReserveAmbient(allianceGuild, 114));
+    assert(coordinator.ReserveAmbient(allianceGuild, 115));
+    assert(!coordinator.ReserveAmbient(allianceGuild, 116));
+    assert(coordinator.ReserveAmbient(allianceGuild, 175));
+    assert(!coordinator.ReserveAmbient(allianceGuild, 235));
+
+    std::uint64_t thread = coordinator.BeginHumanTurn(allianceGuild, 1, 10, 1000);
+    assert(thread != 0);
+    assert(coordinator.ReserveFollowUp(thread, 20, 1000));
+    assert(!coordinator.ReserveFollowUp(thread, 20, 1030));
+    assert(coordinator.ReserveFollowUp(thread, 30, 1030));
+    assert(!coordinator.ReserveFollowUp(thread, 40, 1060));
+    assert(coordinator.IsThreadActive(thread, 1090));
+    coordinator.Expire(1091);
+    assert(!coordinator.IsThreadActive(thread, 1091));
+
+    std::uint64_t other = coordinator.BeginHumanTurn(hordeGuild, 2, 50, 1100);
+    assert(other != 0);
+    assert(coordinator.ReserveFollowUp(other, 60, 1100));
+    assert(coordinator.ChannelCount() == 2);
+
+    OllamaChatSocial::Settings participantSettings = settings;
+    participantSettings.maxDepth = 3;
+    participantSettings.maxBotParticipants = 2;
+    participantSettings.followUpCooldownSeconds = 5;
+    OllamaChatSocial::Coordinator participantCoordinator(participantSettings);
+    std::uint64_t capped = participantCoordinator.BeginHumanTurn(allianceGuild, 3, 70, 2000);
+    assert(participantCoordinator.ReserveFollowUp(capped, 80, 2000));
+    assert(!participantCoordinator.ReserveFollowUp(capped, 90, 2005));
+
+    coordinator.Clear();
+    assert(coordinator.ThreadCount() == 0);
+    assert(coordinator.ChannelCount() == 0);
+
+    std::cout << "PASS boundary_isolation=1 depth_limit=1 participant_limit=1 cooldown=1 expiry=1 "
+                 "ambient_quiet=1 ambient_budget=1"
+              << std::endl;
+    return 0;
+}
