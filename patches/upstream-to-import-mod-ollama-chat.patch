+void ConfigureSocialConversation()
+{
+    OllamaChatSocial::Settings settings;
+    settings.enabled = g_EnableSocialConversation;
+    settings.threadTtlSeconds = g_SocialThreadTtlSeconds;
+    settings.followUpCooldownSeconds = g_SocialFollowUpCooldownSeconds;
+    settings.humanQuietSeconds = g_SocialHumanQuietSeconds;
+    settings.ambientCooldownSeconds = g_SocialAmbientCooldownSeconds;
