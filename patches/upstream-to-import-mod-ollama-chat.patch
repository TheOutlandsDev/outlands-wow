+#ifndef MOD_OLLAMA_CHAT_CONTINUITY_H
+#define MOD_OLLAMA_CHAT_CONTINUITY_H
+
+#include <algorithm>
+#include <cctype>
+#include <cstddef>
+#include <cstdint>
+#include <ctime>
+#include <deque>
+#include <optional>
+#include <sstream>
+#include <string>
+#include <unordered_map>
+#include <unordered_set>
+#include <utility>
+#include <vector>
+
+namespace OllamaChatContinuity
+{
+using Guid = std::uint64_t;
+
+struct Settings
+{
+    bool enabled = true;
+    std::uint32_t stickyResponderSeconds = 1800;
+    std::uint32_t memoryTtlSeconds = 604800;
+    std::size_t maxPlayers = 512;
+    std::size_t maxTurnsPerPlayer = 8;
+    std::size_t maxRecentReplies = 8;
+    std::size_t maxMessageBytes = 240;
+    std::size_t maxContextBytes = 1200;
+};
+
+struct Turn
+{
+    Guid botGuid = 0;
+    std::string playerMessage;
+    std::string botReply;
+    std::time_t at = 0;
+};
+
+class Store
+{
+public:
+    explicit Store(Settings settings = {}) : settings_(SanitizeSettings(settings)) { }
+
+    void Configure(Settings settings)
+    {
+        settings_ = SanitizeSettings(settings);
+        TrimAll();
+    }
+
+    bool Enabled() const { return settings_.enabled; }
+
+    void Clear()
+    {
+        players_.clear();
+    }
+
+    bool LoadTurn(Guid playerGuid, Guid botGuid, std::string const& playerMessage,
+                  std::string const& botReply, std::time_t at)
+    {
+        return AddTurn(playerGuid, botGuid, playerMessage, botReply, at, false);
+    }
+
+    bool CommitTurn(Guid playerGuid, Guid botGuid, std::string const& playerMessage,
+                    std::string const& botReply, std::time_t at)
+    {
+        return AddTurn(playerGuid, botGuid, playerMessage, botReply, at, true);
+    }
+
+    std::optional<Guid> PreferredResponder(Guid playerGuid, std::time_t now) const
+    {
+        if (!settings_.enabled)
+            return std::nullopt;
+        auto itr = players_.find(playerGuid);
+        if (itr == players_.end() || !itr->second.preferredBot ||
+            now < itr->second.preferredAt ||
+            static_cast<std::uint64_t>(now - itr->second.preferredAt) > settings_.stickyResponderSeconds)
+            return std::nullopt;
+        return itr->second.preferredBot;
+    }
+
+    bool IsFollowUp(std::string const& message) const
+    {
+        std::string value = Normalize(MemoryText(message));
+        if (value.empty())
+            return false;
+
+        static std::unordered_set<std::string> const exact = {
+            "yes", "yeah", "yep", "no", "nope", "ok", "okay", "sure", "why",
+            "where", "when", "how", "what", "who", "which", "really", "then what",
+            "what now", "go on", "tell me more", "what do you mean", "can you help"
+        };
+        if (exact.find(value) != exact.end())
+            return true;
+
+        std::size_t words = 1 + static_cast<std::size_t>(std::count(value.begin(), value.end(), ' '));
+        return words <= 6 && (StartsWith(value, "why ") || StartsWith(value, "how ") ||
+            StartsWith(value, "where ") || StartsWith(value, "what ") ||
+            StartsWith(value, "and ") || StartsWith(value, "but ") ||
+            StartsWith(value, "then "));
+    }
+
+    bool IsDuplicateReply(Guid playerGuid, Guid botGuid, std::string const& reply, std::time_t now) const
+    {
+        if (!settings_.enabled)
+            return false;
+        auto itr = players_.find(playerGuid);
+        if (itr == players_.end())
+            return false;
+
+        std::string normalized = Normalize(MemoryText(reply));
+        if (normalized.empty())
+            return true;
+
+        for (auto const& previous : itr->second.normalizedReplies)
+        {
+            if (previous.botGuid == botGuid && now >= previous.at &&
+                static_cast<std::uint64_t>(now - previous.at) <= settings_.stickyResponderSeconds &&
+                Similar(normalized, previous.normalized))
+                return true;
+        }
+        return false;
+    }
+
+    std::string BuildContext(Guid playerGuid, Guid responderGuid, std::string const& playerName,
+                             std::string const& currentMessage, std::time_t now) const
+    {
+        if (!settings_.enabled)
+            return {};
+        auto itr = players_.find(playerGuid);
+        if (itr == players_.end() || itr->second.turns.empty())
+            return {};
+
+        std::vector<std::string> lines;
+        std::size_t used = 0;
+        for (auto turn = itr->second.turns.rbegin(); turn != itr->second.turns.rend(); ++turn)
+        {
+            if (now < turn->at ||
+                static_cast<std::uint64_t>(now - turn->at) > settings_.memoryTtlSeconds)
+                continue;
+            std::string line = playerName + " said: " + turn->playerMessage + "\n";
+            line += (turn->botGuid == responderGuid ? "You replied: " : "Another player replied: ");
+            line += turn->botReply + "\n";
+            if (used + line.size() > settings_.maxContextBytes)
+                break;
+            used += line.size();
+            lines.push_back(std::move(line));
+        }
+
+        if (lines.empty())
+            return {};
+
+        std::ostringstream out;
+        out << "Recent gameplay conversation with " << playerName
+            << ". Continue naturally and do not invent memories:\n";
+        for (auto line = lines.rbegin(); line != lines.rend(); ++line)
+            out << *line;
+        std::string current = MemoryText(currentMessage);
+        if (!current.empty())
+            out << "NEW MESSAGE from " << playerName << ": " << current;
+        std::string result = out.str();
+        if (result.size() > settings_.maxContextBytes)
+            result.resize(settings_.maxContextBytes);
+        return result;
+    }
+
+    std::size_t PairTurnCount(Guid speakerGuid, Guid responderGuid, std::time_t now) const
+    {
+        if (!settings_.enabled)
+            return 0;
+        auto itr = players_.find(speakerGuid);
+        if (itr == players_.end())
+            return 0;
+        return static_cast<std::size_t>(std::count_if(
+            itr->second.turns.begin(), itr->second.turns.end(),
+            [&](Turn const& turn)
+            {
+                return turn.botGuid == responderGuid && now >= turn.at &&
+                    static_cast<std::uint64_t>(now - turn.at) <= settings_.memoryTtlSeconds;
+            }));
+    }
+
+    std::string BuildRelationshipCue(Guid speakerGuid, Guid responderGuid,
+                                     std::string const& speakerName, std::time_t now) const
+    {
+        std::size_t turns = PairTurnCount(speakerGuid, responderGuid, now);
+        if (!turns)
+            return {};
+        std::ostringstream cue;
+        cue << "Relationship with " << speakerName << ": ";
+        if (turns >= 6)
+            cue << "trusted long-time companion";
+        else if (turns >= 3)
+            cue << "familiar guildmate";
+        else
+            cue << "new acquaintance";
+        cue << " based on " << turns
+            << " recent shared conversation turn" << (turns == 1 ? "" : "s")
+            << ". Let familiarity affect warmth, but never invent events.";
+        return cue.str();
+    }
+
+    void Expire(std::time_t now)
+    {
+        for (auto itr = players_.begin(); itr != players_.end();)
+        {
+            PlayerState& state = itr->second;
+            while (!state.turns.empty() && now >= state.turns.front().at &&
+                   static_cast<std::uint64_t>(now - state.turns.front().at) > settings_.memoryTtlSeconds)
+                state.turns.pop_front();
+            while (!state.normalizedReplies.empty() && now >= state.normalizedReplies.front().at &&
+                   static_cast<std::uint64_t>(now - state.normalizedReplies.front().at) > settings_.memoryTtlSeconds)
+                state.normalizedReplies.pop_front();
+            if (state.preferredBot && now >= state.preferredAt &&
+                static_cast<std::uint64_t>(now - state.preferredAt) > settings_.stickyResponderSeconds)
+                state.preferredBot = 0;
+
+            if (state.turns.empty() && state.normalizedReplies.empty() && !state.preferredBot)
+                itr = players_.erase(itr);
+            else
+                ++itr;
+        }
+    }
+
+    std::size_t PlayerCount() const { return players_.size(); }
+
+    std::string MemoryText(std::string const& input) const
+    {
+        if (!settings_.enabled || input.empty() || input.size() > settings_.maxMessageBytes ||
+            LooksSensitiveOrMachineGenerated(input))
+            return {};
+
+        std::string result;
+        result.reserve(input.size());
+        bool lastWasSpace = true;
+        for (unsigned char c : input)
+        {
+            if (c < 32 || c == 127 || std::isspace(c))
+            {
+                if (!lastWasSpace && !result.empty())
+                    result.push_back(' ');
+                lastWasSpace = true;
+                continue;
+            }
+            result.push_back(static_cast<char>(c));
+            lastWasSpace = false;
+        }
+        while (!result.empty() && result.back() == ' ')
+            result.pop_back();
+        return result;
+    }
+
+private:
+    struct RecentReply
+    {
+        Guid botGuid = 0;
+        std::string normalized;
+        std::time_t at = 0;
+    };
+
+    struct PlayerState
+    {
+        Guid preferredBot = 0;
+        std::time_t preferredAt = 0;
+        std::time_t lastTouched = 0;
+        std::deque<Turn> turns;
+        std::deque<RecentReply> normalizedReplies;
+    };
+
+    static Settings SanitizeSettings(Settings settings)
+    {
+        settings.stickyResponderSeconds = std::max<std::uint32_t>(60, settings.stickyResponderSeconds);
+        settings.memoryTtlSeconds = std::max(settings.stickyResponderSeconds, settings.memoryTtlSeconds);
+        settings.maxPlayers = std::clamp<std::size_t>(settings.maxPlayers, 1, 4096);
+        settings.maxTurnsPerPlayer = std::clamp<std::size_t>(settings.maxTurnsPerPlayer, 1, 20);
+        settings.maxRecentReplies = std::clamp<std::size_t>(settings.maxRecentReplies, 1, 20);
+        settings.maxMessageBytes = std::clamp<std::size_t>(settings.maxMessageBytes, 32, 512);
+        settings.maxContextBytes = std::clamp<std::size_t>(settings.maxContextBytes, 256, 4096);
+        return settings;
+    }
+
+    bool AddTurn(Guid playerGuid, Guid botGuid, std::string const& playerMessage,
+                 std::string const& botReply, std::time_t at, bool updatePreferred)
+    {
+        if (!settings_.enabled || !playerGuid || !botGuid)
+            return false;
+        std::string safePlayer = MemoryText(playerMessage);
+        std::string safeReply = MemoryText(botReply);
+        if (safePlayer.empty() || safeReply.empty())
+            return false;
+
+        auto& state = players_[playerGuid];
+        state.turns.push_back({botGuid, std::move(safePlayer), safeReply, at});
+        while (state.turns.size() > settings_.maxTurnsPerPlayer)
+            state.turns.pop_front();
+
+        std::string normalized = Normalize(safeReply);
+        if (!normalized.empty())
+        {
+            state.normalizedReplies.push_back({botGuid, std::move(normalized), at});
+            while (state.normalizedReplies.size() > settings_.maxRecentReplies)
+                state.normalizedReplies.pop_front();
+        }
+
+        if (updatePreferred || at >= state.preferredAt)
+        {
+            state.preferredBot = botGuid;
+            state.preferredAt = at;
+        }
+        state.lastTouched = std::max(state.lastTouched, at);
+        EnforcePlayerLimit();
+        return true;
+    }
+
+    void TrimAll()
+    {
+        for (auto& entry : players_)
+        {
+            while (entry.second.turns.size() > settings_.maxTurnsPerPlayer)
+                entry.second.turns.pop_front();
+            while (entry.second.normalizedReplies.size() > settings_.maxRecentReplies)
+                entry.second.normalizedReplies.pop_front();
+        }
+        EnforcePlayerLimit();
+    }
+
+    void EnforcePlayerLimit()
+    {
+        while (players_.size() > settings_.maxPlayers)
+        {
+            auto oldest = std::min_element(players_.begin(), players_.end(), [](auto const& left, auto const& right)
+            {
+                return left.second.lastTouched < right.second.lastTouched;
+            });
+            if (oldest == players_.end())
+                break;
+            players_.erase(oldest);
+        }
+    }
+
+    static bool StartsWith(std::string const& value, std::string const& prefix)
+    {
+        return value.size() >= prefix.size() && value.compare(0, prefix.size(), prefix) == 0;
+    }
+
+    static std::string Lower(std::string value)
+    {
+        std::transform(value.begin(), value.end(), value.begin(), [](unsigned char c)
+        {
+            return static_cast<char>(std::tolower(c));
+        });
+        return value;
+    }
+
+    static std::string Normalize(std::string const& input)
+    {
+        std::string result;
+        bool pendingSpace = false;
+        for (unsigned char c : input)
+        {
+            if (std::isalnum(c))
+            {
+                if (pendingSpace && !result.empty())
+                    result.push_back(' ');
+                result.push_back(static_cast<char>(std::tolower(c)));
+                pendingSpace = false;
+            }
+            else if (!result.empty())
+                pendingSpace = true;
+        }
+        return result;
+    }
+
+    static bool LooksSensitiveOrMachineGenerated(std::string const& input)
+    {
+        std::string value = Lower(input);
+        if (value.empty() || value.front() == '.' || value.front() == '/' ||
+            value.find('\0') != std::string::npos)
+            return true;
+        static char const* blocked[] = {
+            "password=", "password:", "passwd=", "pass=", "api_key", "apikey",
+            "access_token", "refresh_token", "authorization: bearer", "sessionid="
+        };
+        for (char const* marker : blocked)
+            if (value.find(marker) != std::string::npos)
+                return true;
+        return false;
+    }
+
+    static bool Similar(std::string const& left, std::string const& right)
+    {
+        if (left == right)
+            return true;
+        if (left.size() >= 24 && right.size() >= 24 &&
+            (StartsWith(left, right) || StartsWith(right, left)))
+            return true;
+
+        auto tokens = [](std::string const& value)
+        {
+            std::unordered_set<std::string> result;
+            std::istringstream in(value);
+            std::string token;
+            while (in >> token)
+                result.insert(std::move(token));
+            return result;
+        };
+        auto first = tokens(left);
+        auto second = tokens(right);
+        if (first.size() < 4 || second.size() < 4)
+            return false;
+        std::size_t intersection = 0;
+        for (auto const& token : first)
+            intersection += second.count(token);
+        std::size_t unionSize = first.size() + second.size() - intersection;
+        return unionSize && static_cast<double>(intersection) / static_cast<double>(unionSize) >= 0.85;
+    }
+
+    Settings settings_;
+    std::unordered_map<Guid, PlayerState> players_;
+};
+}
+
