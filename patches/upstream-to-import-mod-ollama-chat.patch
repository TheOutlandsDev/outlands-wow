diff --git a/src/mod-ollama-chat_policy.h b/src/mod-ollama-chat_policy.h
new file mode 100644
index 0000000..6854b2c
--- /dev/null
+++ b/src/mod-ollama-chat_policy.h
@@ -0,0 +1,27 @@
+#pragma once
+
+#include <string>
+
+namespace OllamaChatPolicy
+{
+inline bool AcceptInbound(bool senderIsBot)
+{
+    // Generated/ambient bot text must never recursively enter the LLM reply path.
+    return !senderIsBot;
+}
+
+inline bool SuppressDuplicate(bool senderIsBot, bool duplicate)
+{
+    // A human must not lose their only reply because the model repeated itself.
+    return senderIsBot && duplicate;
+}
+
+inline std::string AuthoritativeSpeakerInstruction(std::string const& playerName)
+{
+    return "AUTHORITATIVE CURRENT SPEAKER: " + playerName +
+        ". Reply to this speaker. Address them only as " + playerName +
+        " or without a name. Never address them as a different player. "
+        "Names in older conversation context are not the current speaker. "
+        "Do not repeat or closely paraphrase an earlier reply.";
+}
+}
