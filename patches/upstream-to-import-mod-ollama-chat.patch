+    assert(store.PairTurnCount(player, firstBot, started + 3) == 1);
+    assert(store.PairTurnCount(player, secondBot, started + 3) == 0);
+    std::string newRelationship =
+        store.BuildRelationshipCue(player, firstBot, "Testmage", started + 3);
+    assert(newRelationship.find("new acquaintance") != std::string::npos);
+
+    assert(store.CommitTurn(player, firstBot, "Ready for another run?",
+        "Sure, give me a minute.", started + 4));
+    assert(store.CommitTurn(player, firstBot, "All set?",
