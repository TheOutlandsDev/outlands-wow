+struct PendingConversationWrite
+{
+    uint64_t botGuid = 0;
+    uint64_t playerGuid = 0;
+    std::string playerMessage;
+    std::string botReply;
+};
+
+static std::deque<PendingConversationWrite> g_DirtyConversationHistory;
+static constexpr std::size_t MAX_DIRTY_CONVERSATIONS = 256;
+
+void AppendBotConversation(uint64_t botGuid, uint64_t playerGuid, const std::string& playerMessage, const std::string& botReply)
+{
+    std::string safePlayerMessage = g_ConversationContinuity.MemoryText(playerMessage);
+    std::string safeBotReply = g_ConversationContinuity.MemoryText(botReply);
+    if (safePlayerMessage.empty() || safeBotReply.empty() ||
+        !g_ConversationContinuity.CommitTurn(playerGuid, botGuid, safePlayerMessage, safeBotReply, time(nullptr)))
+    {
+        LOG_INFO("playerbots", "[Ollama Chat] continuity result=memory_skipped player_guid={} bot_guid={}",
+                 playerGuid, botGuid);
+        return;
+    }
+
+    std::lock_guard<std::mutex> continuityLock(g_ConversationHistoryMutex);
+    auto& continuityHistory = g_BotConversationHistory[botGuid][playerGuid];
+    continuityHistory.push_back({ safePlayerMessage, safeBotReply });
+    while (continuityHistory.size() > g_MaxConversationHistory)
+        continuityHistory.pop_front();
+
+    if (g_DirtyConversationHistory.size() >= MAX_DIRTY_CONVERSATIONS)
+    {
+        g_DirtyConversationHistory.pop_front();
+        LOG_WARN("playerbots", "[Ollama Chat] continuity result=dirty_queue_oldest_dropped limit={}",
+                 MAX_DIRTY_CONVERSATIONS);
+    }
+    g_DirtyConversationHistory.push_back(
+        { botGuid, playerGuid, std::move(safePlayerMessage), std::move(safeBotReply) });
+
+#if 0 // LA24: replaced by bounded continuity implementation above
+    std::lock_guard<std::mutex> lock(g_ConversationHistoryMutex);
+    auto& playerHistory = g_BotConversationHistory[botGuid][playerGuid];
+    playerHistory.push_back({ playerMessage, botReply });
+    while (playerHistory.size() > g_MaxConversationHistory)
+    {
+        playerHistory.pop_front();
+    }
+#endif
+
+}
