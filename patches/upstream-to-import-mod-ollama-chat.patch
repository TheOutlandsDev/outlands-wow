+bool Store::HasConsentOverride(uint64_t playerGuid) const
+{
+    if (_secret.empty())
+        return false;
+    std::string playerId = Pseudonym(playerGuid);
+    std::lock_guard<std::mutex> lock(_stateMutex);
+    return _consent.find(playerId) != _consent.end();
+}
