+
+char const* QuerySubmitResultName(QuerySubmitResult result)
+{
+    switch (result)
+    {
+        case QuerySubmitResult::Accepted:
+            return "accepted";
+        case QuerySubmitResult::NotRunning:
+            return "rejected_disabled";
+        case QuerySubmitResult::EmptyPrompt:
+            return "rejected_empty_prompt";
+        case QuerySubmitResult::InvalidIdentity:
+            return "rejected_invalid_identity";
+        case QuerySubmitResult::QueueFull:
+            return "rejected_queue_full";
+        case QuerySubmitResult::PlayerLimit:
+            return "rejected_player_limit";
+        case QuerySubmitResult::BotLimit:
+            return "rejected_bot_busy";
+    }
+
+    return "rejected_unknown";
+}
+
+char const* QueryPriorityName(QueryPriority priority)
+{
+    switch (priority)
+    {
+        case QueryPriority::Human:
+            return "human";
+        case QueryPriority::FollowUp:
+            return "follow_up";
+        case QueryPriority::Ambient:
+            return "ambient";
+    }
+    return "unknown";
+}
+
+QueryManager::QueryManager()
+    : nextRequestId_(1), workerCount_(2), maxQueuedQueries_(16), maxPendingPerPlayer_(2), maxPendingPerBot_(1),
+      queueExpiry_(15), completionExpiry_(30), backend_(QueryOllamaAPI), accepting_(false), stopping_(false)
+{
+}
+
+QueryManager::~QueryManager()
+{
+    Stop();
+}
+
+void QueryManager::Configure(uint32_t workerCount, uint32_t maxQueuedQueries, uint32_t maxPendingPerPlayer,
+    uint32_t maxPendingPerBot, uint32_t queueExpirySeconds, uint32_t completionExpirySeconds)
+{
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (accepting_ || !workers_.empty())
+    {
+        LOG_WARN("server.loading", "[Ollama Chat] Scheduler reconfiguration ignored while running");
+        return;
+    }
+
+    workerCount_ = workerCount == 0 ? 1 : workerCount;
+    maxQueuedQueries_ = maxQueuedQueries == 0 ? 1 : maxQueuedQueries;
+    maxPendingPerPlayer_ = maxPendingPerPlayer == 0 ? 1 : maxPendingPerPlayer;
+    maxPendingPerBot_ = maxPendingPerBot == 0 ? 1 : maxPendingPerBot;
+    queueExpiry_ = std::chrono::seconds(queueExpirySeconds == 0 ? 1 : queueExpirySeconds);
+    completionExpiry_ = std::chrono::seconds(completionExpirySeconds == 0 ? 1 : completionExpirySeconds);
+}
+
+bool QueryManager::SetBackendForTesting(Backend backend)
+{
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (accepting_ || !workers_.empty() || !backend)
+        return false;
+
+    backend_ = std::move(backend);
+    return true;
+}
+
+bool QueryManager::Start()
+{
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (accepting_)
+        return true;
+
+    if (!workers_.empty())
+        return false;
+
+    stopping_ = false;
+    accepting_ = true;
+    workers_.reserve(workerCount_);
+    for (uint32_t workerIndex = 0; workerIndex < workerCount_; ++workerIndex)
+        workers_.emplace_back(&QueryManager::WorkerLoop, this, workerIndex);
+
+    LOG_INFO("server.loading", "[Ollama Chat] Scheduler started: workers={}, max_queue={}, per_player={}, per_bot={}, "
+        "queue_expiry={}s, completion_expiry={}s", workerCount_, maxQueuedQueries_, maxPendingPerPlayer_,
+        maxPendingPerBot_, queueExpiry_.count(), completionExpiry_.count());
+    return true;
+}
+
+void QueryManager::Stop()
+{
+    std::vector<std::thread> workers;
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        if (!accepting_ && workers_.empty())
+            return;
+
+        accepting_ = false;
+        stopping_ = true;
+        for (QueryTask const& task : taskQueue_)
+        {
+            LOG_INFO("server.loading", "[Ollama Chat] request_id={} result=cancelled_shutdown", task.requestId);
+            ReleasePendingLocked(task.botGuid, task.playerGuid);
+        }
+        taskQueue_.clear();
+        workers.swap(workers_);
+    }
+
+    workReady_.notify_all();
+    for (std::thread& worker : workers)
+    {
+        if (worker.joinable())
+            worker.join();
+    }
+
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        for (QueryCompletion const& result : completionQueue_)
+            LOG_INFO("server.loading", "[Ollama Chat] request_id={} result=cancelled_shutdown", result.requestId);
+        completionQueue_.clear();
+        pendingByPlayer_.clear();
+        pendingByBot_.clear();
+        stopping_ = false;
+    }
+
+    LOG_INFO("server.loading", "[Ollama Chat] Scheduler stopped; workers joined and queues cleared");
+}
+
+QuerySubmitResult QueryManager::Submit(std::string prompt, uint64_t botGuid, uint64_t playerGuid,
+    Completion completion, uint64_t& requestId, QueryPriority priority)
+{
+    requestId = nextRequestId_.fetch_add(1, std::memory_order_relaxed);
+    QuerySubmitResult result = QuerySubmitResult::Accepted;
+    size_t queueDepth = 0;
+
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        if (!accepting_ || stopping_)
+            result = QuerySubmitResult::NotRunning;
+        else if (prompt.empty() || !completion)
+            result = QuerySubmitResult::EmptyPrompt;
+        else if (botGuid == 0 || playerGuid == 0)
+            result = QuerySubmitResult::InvalidIdentity;
+        else if (auto playerItr = pendingByPlayer_.find(playerGuid);
+                 playerItr != pendingByPlayer_.end() && playerItr->second >= maxPendingPerPlayer_)
+            result = QuerySubmitResult::PlayerLimit;
+        else if (auto botItr = pendingByBot_.find(botGuid);
+                 botItr != pendingByBot_.end() && botItr->second >= maxPendingPerBot_)
+            result = QuerySubmitResult::BotLimit;
+        else if (taskQueue_.size() >= maxQueuedQueries_)
+            result = QuerySubmitResult::QueueFull;
+        else
+        {
+            ++pendingByPlayer_[playerGuid];
+            ++pendingByBot_[botGuid];
+            QueryTask task{
+                requestId, botGuid, playerGuid, priority, std::move(prompt), std::move(completion), Clock::now()
+            };
+            auto insertion = std::find_if(taskQueue_.begin(), taskQueue_.end(),
+                [priority](QueryTask const& queued)
+                {
+                    return static_cast<std::uint8_t>(queued.priority) >
+                        static_cast<std::uint8_t>(priority);
+                });
+            taskQueue_.insert(insertion, std::move(task));
+            queueDepth = taskQueue_.size();
+        }
+    }
+
+    if (result == QuerySubmitResult::Accepted)
+        LOG_INFO("server.loading", "[Ollama Chat] request_id={} state=accepted bot_guid={} player_guid={} priority={} queue_depth={}",
+            requestId, botGuid, playerGuid, QueryPriorityName(priority), queueDepth);
+    else
+        LOG_INFO("server.loading", "[Ollama Chat] request_id={} result={} bot_guid={} player_guid={} queue_depth={}",
+            requestId, QuerySubmitResultName(result), botGuid, playerGuid, queueDepth);
+
+    if (result == QuerySubmitResult::Accepted)
+        workReady_.notify_one();
+
+    return result;
+}
+
+void QueryManager::DrainCompletions()
+{
+    std::deque<QueryCompletion> completions;
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        completions.swap(completionQueue_);
+    }
+
+    for (QueryCompletion& result : completions)
+    {
+        bool const stale = Clock::now() - result.completedAt > completionExpiry_;
+        {
+            std::lock_guard<std::mutex> lock(mutex_);
+            ReleasePendingLocked(result.botGuid, result.playerGuid);
+        }
+
+        if (result.expiredInQueue)
+        {
+            LOG_INFO("server.loading", "[Ollama Chat] request_id={} result=expired_queue", result.requestId);
+            continue;
+        }
+
+        if (stale)
+        {
+            LOG_INFO("server.loading", "[Ollama Chat] request_id={} result=completion_dropped_stale", result.requestId);
+            continue;
+        }
+
+        try
+        {
+            result.completion(result.requestId, std::move(result.response));
+        }
+        catch (std::exception const& ex)
+        {
+            LOG_ERROR("server.loading", "[Ollama Chat] request_id={} result=completion_exception error={}",
+                result.requestId, ex.what());
+        }
+    }
+}
+
+bool QueryManager::IsRunning() const
+{
+    std::lock_guard<std::mutex> lock(mutex_);
+    return accepting_ && !stopping_;
+}
+
+void QueryManager::WorkerLoop(uint32_t workerIndex)
+{
+    for (;;)
+    {
+        QueryTask task;
+        Backend backend;
+        {
+            std::unique_lock<std::mutex> lock(mutex_);
+            workReady_.wait(lock, [this] { return stopping_ || !taskQueue_.empty(); });
+            if (stopping_ && taskQueue_.empty())
+                return;
+
+            task = std::move(taskQueue_.front());
+            taskQueue_.pop_front();
+            backend = backend_;
+        }
+
+        bool const expiredInQueue = Clock::now() - task.queuedAt > queueExpiry_;
+        std::string response;
+        if (!expiredInQueue)
+        {
+            LOG_INFO("server.loading", "[Ollama Chat] request_id={} state=http_started worker={} priority={}",
+                task.requestId, workerIndex, QueryPriorityName(task.priority));
+            try
+            {
+                response = backend(task.prompt);
+            }
+            catch (std::exception const& ex)
+            {
+                LOG_ERROR("server.loading", "[Ollama Chat] request_id={} result=http_exception worker={} error={}",
+                    task.requestId, workerIndex, ex.what());
+            }
+            catch (...)
+            {
+                LOG_ERROR("server.loading", "[Ollama Chat] request_id={} result=http_exception worker={} error=unknown",
+                    task.requestId, workerIndex);
+            }
+            LOG_INFO("server.loading", "[Ollama Chat] request_id={} state={} response_bytes={}", task.requestId,
+                response.empty() ? "http_error" : "http_ok", response.size());
+        }
+
+        {
+            std::lock_guard<std::mutex> lock(mutex_);
+            if (stopping_)
+            {
+                LOG_INFO("server.loading", "[Ollama Chat] request_id={} result=cancelled_shutdown", task.requestId);
+                ReleasePendingLocked(task.botGuid, task.playerGuid);
+                continue;
+            }
+
+            completionQueue_.push_back({ task.requestId, task.botGuid, task.playerGuid, std::move(response),
+                std::move(task.completion), Clock::now(), expiredInQueue });
+        }
+
+        LOG_INFO("server.loading", "[Ollama Chat] request_id={} state=completion_queued", task.requestId);
+    }
+}
+
+void QueryManager::ReleasePendingLocked(uint64_t botGuid, uint64_t playerGuid)
+{
+    auto playerItr = pendingByPlayer_.find(playerGuid);
+    if (playerItr != pendingByPlayer_.end())
+    {
+        if (playerItr->second > 1)
+            --playerItr->second;
+        else
+            pendingByPlayer_.erase(playerItr);
+    }
+
+    auto botItr = pendingByBot_.find(botGuid);
+    if (botItr != pendingByBot_.end())
+    {
+        if (botItr->second > 1)
+            --botItr->second;
+        else
+            pendingByBot_.erase(botItr);
+    }
+}
