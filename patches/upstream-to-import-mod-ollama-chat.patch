+
+bool Store::SanitizeText(std::string const& input, uint32_t maxBytes,
+    std::string& output, bool& changed)
+{
+    output = input;
+    changed = false;
+
+    static std::regex const commandPattern(R"(^\s*[./]\S+)", std::regex::icase);
+    static std::regex const secretAssignment(
+        R"((password|passwd|api[\s_-]?key|access[\s_-]?token|secret|token)\s*[:=])",
+        std::regex::icase);
+    if (std::regex_search(output, commandPattern) || std::regex_search(output, secretAssignment))
+        return false;
+
+    for (char& character : output)
+    {
+        unsigned char value = static_cast<unsigned char>(character);
+        if (value < 0x20 && character != '\t')
+        {
+            character = ' ';
+            changed = true;
+        }
+    }
+
+    auto redact = [&](std::regex const& pattern, char const* replacement)
+    {
+        std::string next = std::regex_replace(output, pattern, replacement);
+        if (next != output)
+        {
+            output = std::move(next);
+            changed = true;
+        }
+    };
+
+    static std::regex const email(R"(\b[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}\b)",
+        std::regex::icase);
+    static std::regex const ipv4(
+        R"(\b(?:\d{1,3}\.){3}\d{1,3}\b)", std::regex::icase);
+    static std::regex const url(
+        R"(\b(?:https?://|www\.)\S+)", std::regex::icase);
+    static std::regex const phone(
+        R"((?:\+?\d[\d\s().-]{7,}\d))", std::regex::icase);
+    static std::regex const longToken(
+        R"(\b[A-Z0-9_-]{32,}\b)", std::regex::icase);
+
+    redact(email, "[redacted-email]");
+    redact(ipv4, "[redacted-ip]");
+    redact(url, "[redacted-url]");
+    redact(phone, "[redacted-phone]");
+    redact(longToken, "[redacted-token]");
+
+    std::string bounded = Utf8Prefix(output, maxBytes);
+    if (bounded != output)
+    {
+        output = std::move(bounded);
+        changed = true;
+    }
+    return !output.empty();
+}
+
+bool Store::Record(ConversationEvent event)
+{
+    if (!IsRunning() || !event.playerGuid)
+        return false;
+
+    bool hasConsentOverride = HasConsentOverride(event.playerGuid);
+    bool consented = IsConsented(event.playerGuid);
+    event.consentGranted = consented;
+    event.consentSource = hasConsentOverride ? "explicit" : "default";
+    if (!consented)
+        ++_noConsent;
+
+    bool allowText = consented && (event.channel == 1 || event.channel == 6);
+    bool whisperExcluded = event.channel == 7 && !_settings.captureWhispers;
+    if (event.channel == 7)
+        allowText = consented && _settings.captureWhispers;
+    else if (event.channel == 2 || event.channel == 3 || event.channel == 4 ||
+        event.channel == 5 || event.channel == 17)
+        allowText = consented && _settings.captureSharedChannels;
+
+    bool changedPlayer = false;
+    bool changedBot = false;
+    bool changedIdentity = false;
+    auto sanitizeOptional = [](std::string const& input, uint32_t maxBytes,
+        std::string& output, bool& changed)
+    {
+        if (input.empty())
+        {
+            output.clear();
+            return true;
+        }
+        return Store::SanitizeText(input, maxBytes, output, changed);
+    };
+
+    std::string safeBotName;
+    bool changedBotName = false;
+    if (sanitizeOptional(event.botName, 48, safeBotName, changedBotName))
+        event.botName = std::move(safeBotName);
+    else
+        event.botName.clear();
+    changedIdentity = changedBotName;
+
+    if (!allowText)
+    {
+        event.playerName.clear();
+        event.playerText.clear();
+        event.botText.clear();
+        event.channelName.clear();
+        event.metadataOnly = true;
+        if (!consented)
+            event.privacyReason = "consent_not_granted";
+        else if (whisperExcluded)
+            event.privacyReason = "whisper_excluded";
+        else
+            event.privacyReason = "channel_text_disabled";
+        ++_metadataOnly;
+    }
+    else
+    {
+        std::string playerName;
+        std::string channelName;
+        std::string playerText;
+        std::string botText;
+        bool changedPlayerName = false;
+        bool changedChannelName = false;
+        bool textSafe =
+            sanitizeOptional(event.playerName, 48, playerName, changedPlayerName) &&
+            sanitizeOptional(event.channelName, 64, channelName, changedChannelName) &&
+            sanitizeOptional(event.playerText, _settings.maxTextBytes, playerText, changedPlayer) &&
+            sanitizeOptional(event.botText, _settings.maxTextBytes, botText, changedBot);
+        if (!textSafe)
+        {
+            event.playerName.clear();
+            event.channelName.clear();
+            event.playerText.clear();
+            event.botText.clear();
+            event.metadataOnly = true;
+            event.privacyReason = "sensitive_content_omitted";
+            event.redactionApplied = true;
+            ++_metadataOnly;
+            ++_rejectedSensitive;
+        }
+        else
+        {
+            event.playerName = std::move(playerName);
+            event.channelName = std::move(channelName);
+            event.playerText = std::move(playerText);
+            event.botText = std::move(botText);
+            changedIdentity = changedIdentity || changedPlayerName || changedChannelName;
+        }
+    }
+
+    if (changedPlayer || changedBot || changedIdentity)
+    {
+        event.redactionApplied = true;
+        ++_redacted;
+    }
+
+    std::string playerId = Pseudonym(event.playerGuid);
+    event.playerGuid = 0;
+
+    WorkItem item;
+    item.type = WorkType::Event;
+    item.playerId = playerId;
+    item.event = std::move(event);
+    uint64_t requestId = item.event.requestId;
+    if (!Enqueue(std::move(item)))
+        return false;
+
+    {
+        std::lock_guard<std::mutex> lock(_stateMutex);
+        _lastRequestByPlayer[playerId] = requestId;
+    }
+    ++_accepted;
+    return true;
+}
+bool Store::AddFeedback(uint64_t playerGuid, Feedback feedback)
+{
+    if (!IsConsented(playerGuid))
+        return false;
+    std::string playerId = Pseudonym(playerGuid);
+    uint64_t requestId = 0;
+    {
+        std::lock_guard<std::mutex> lock(_stateMutex);
+        auto itr = _lastRequestByPlayer.find(playerId);
+        if (itr == _lastRequestByPlayer.end())
+            return false;
+        requestId = itr->second;
+    }
+    WorkItem item;
+    item.type = WorkType::Feedback;
+    item.playerId = std::move(playerId);
+    item.event.requestId = requestId;
+    item.feedback = feedback;
+    return Enqueue(std::move(item));
+}
+
+std::string Store::FeedbackName(Feedback feedback)
+{
+    switch (feedback)
+    {
+        case Feedback::Good: return "good";
+        case Feedback::Wrong: return "wrong";
+        case Feedback::Repetitive: return "repetitive";
+        case Feedback::Unnatural: return "unnatural";
+        case Feedback::Forgot: return "forgot";
+        case Feedback::Unsafe: return "unsafe";
+    }
+    return "unknown";
+}
+
+bool Store::WriteEvent(ConversationEvent const& event, std::string const& playerId)
+{
+    int64_t created = UnixNow();
+    json value = {
+        {"schema_version", 2},
+        {"record_type", "conversation"},
+        {"request_id", event.requestId},
+        {"created_utc", UtcNow()},
+        {"created_unix", created},
+        {"received_unix_ms", event.receivedUnixMs},
+        {"completed_unix_ms", UnixNowMs()},
+        {"latency_ms", event.latencyMs},
+        {"expires_unix", created + static_cast<int64_t>(_settings.rawRetentionDays) * 86400},
+        {"player_id", playerId},
+        {"bot_id", Pseudonym(event.botGuid)},
+        {"player_name", event.playerName},
+        {"bot_name", event.botName},
+        {"channel", ChannelName(event.channel)},
+        {"channel_name", event.channelName},
+        {"lifecycle_state", event.lifecycleState},
+        {"delivery_state", event.deliveryState},
+        {"suppression_reason", event.suppressionReason},
+        {"consent_state", event.consentGranted ? "granted" : "not_granted"},
+        {"consent_source", event.consentSource},
+        {"privacy_reason", event.privacyReason},
+        {"text_mode", event.metadataOnly ? "metadata_only" : "redacted_text"},
+        {"redaction_applied", event.redactionApplied},
+        {"player_text", event.playerText},
+        {"bot_text", event.botText},
+        {"player_level", static_cast<uint32_t>(event.playerLevel)},
+        {"player_class", static_cast<uint32_t>(event.playerClass)},
+        {"map_id", event.mapId},
+        {"zone_id", event.zoneId},
+        {"in_group", event.inGroup},
+        {"in_dungeon", event.inDungeon},
+        {"model_version", _settings.modelVersion},
+        {"prompt_version", _settings.promptVersion},
+        {"policy_version", _settings.policyVersion}
+    };
+    return AppendJsonLine(fs::path(_settings.dataDirectory) / "events" /
+        (playerId + ".jsonl"), value);
+}
+bool Store::WriteControl(WorkItem const& item)
+{
+    std::string operation;
+    if (item.type == WorkType::Consent) operation = "consent";
+    else if (item.type == WorkType::Delete) operation = "delete";
+    else if (item.type == WorkType::Export) operation = "export";
+    else return false;
+
+    json value = {
+        {"schema_version", 1},
+        {"record_type", "privacy_control"},
+        {"operation", operation},
+        {"player_id", item.playerId},
+        {"created_utc", UtcNow()},
+        {"enabled", item.consent},
+        {"policy_version", _settings.policyVersion}
+    };
+    return AppendJsonLine(fs::path(_settings.dataDirectory) / "control" /
+        "consent.jsonl", value);
+}
+
+bool Store::DeletePlayerData(std::string const& playerId)
+{
+    std::error_code error;
+    fs::remove(fs::path(_settings.dataDirectory) / "events" / (playerId + ".jsonl"), error);
+    if (error)
+        return false;
+
+    fs::path exports = fs::path(_settings.dataDirectory) / "exports";
+    for (fs::directory_iterator itr(exports, error), end; !error && itr != end; itr.increment(error))
+    {
+        if (itr->is_regular_file() && itr->path().filename().string().rfind(playerId + "-", 0) == 0)
+            fs::remove(itr->path(), error);
+        if (error)
+            return false;
+    }
+    return true;
+}
+
+bool Store::ExportPlayerData(std::string const& playerId)
+{
+    fs::path source = fs::path(_settings.dataDirectory) / "events" / (playerId + ".jsonl");
+    fs::path target = fs::path(_settings.dataDirectory) / "exports" /
+        (playerId + "-" + SafeUtcStamp() + ".jsonl");
+    std::error_code error;
+    if (!fs::exists(source, error))
+    {
+        std::ofstream empty(target, std::ios::out | std::ios::binary);
+        return empty.good();
+    }
+    fs::copy_file(source, target, fs::copy_options::none, error);
+    return !error;
+}
+
+void Store::ApplyRetention()
+{
+    int64_t now = UnixNow();
+    for (char const* directoryName : {"events", "exports"})
+    {
+        fs::path directory = fs::path(_settings.dataDirectory) / directoryName;
+        std::error_code error;
+        for (fs::directory_iterator itr(directory, error), end; !error && itr != end; itr.increment(error))
+        {
+            if (!itr->is_regular_file() || itr->path().extension() != ".jsonl")
+                continue;
+
+            std::ifstream input(itr->path(), std::ios::in | std::ios::binary);
+            fs::path temporary = itr->path();
+            temporary += ".retention.tmp";
+            std::ofstream output(temporary, std::ios::out | std::ios::binary | std::ios::trunc);
+            if (!input || !output)
+            {
+                ++_writeFailed;
+                continue;
+            }
+
+            std::string line;
+            while (std::getline(input, line))
+            {
+                try
+                {
+                    json value = json::parse(line);
+                    if (value.value("expires_unix", now + 1) > now)
+                        output << line << '\n';
+                }
+                catch (...)
+                {
+                    ++_writeFailed;
+                }
+            }
+            input.close();
+            output.flush();
+            output.close();
+            if (!output.good())
+            {
+                fs::remove(temporary, error);
+                ++_writeFailed;
+                continue;
+            }
+
+            fs::path backup = itr->path();
+            backup += ".retention.old";
+            fs::remove(backup, error);
+            error.clear();
+            fs::rename(itr->path(), backup, error);
+            if (error)
+            {
+                fs::remove(temporary, error);
+                ++_writeFailed;
+                continue;
+            }
+            fs::rename(temporary, itr->path(), error);
+            if (error)
+            {
+                std::error_code restore;
+                fs::rename(backup, itr->path(), restore);
+                ++_writeFailed;
+                continue;
+            }
+            fs::remove(backup, error);
+        }
+    }
+}
+
+void Store::WorkerLoop()
+{
+    int64_t lastRetention = UnixNow();
+    for (;;)
+    {
+        WorkItem item;
+        {
+            std::unique_lock<std::mutex> lock(_queueMutex);
+            _queueCv.wait(lock, [&] { return !_queue.empty(); });
+            item = std::move(_queue.front());
+            _queue.pop_front();
+        }
+
+        if (item.type == WorkType::Stop)
+            break;
+
+        bool success = false;
+        try
+        {
+            if (item.type == WorkType::Event)
+                success = WriteEvent(item.event, item.playerId);
+            else if (item.type == WorkType::Consent)
+                success = WriteControl(item);
+            else if (item.type == WorkType::Delete)
+            {
+                success = DeletePlayerData(item.playerId);
+                success = WriteControl(item) && success;
+            }
+            else if (item.type == WorkType::Export)
+            {
+                success = ExportPlayerData(item.playerId);
+                success = WriteControl(item) && success;
+            }
+            else if (item.type == WorkType::Feedback)
+            {
+                int64_t created = UnixNow();
+                json value = {
+                    {"schema_version", 1},
+                    {"record_type", "feedback"},
+                    {"request_id", item.event.requestId},
+                    {"player_id", item.playerId},
+                    {"rating", FeedbackName(item.feedback)},
+                    {"created_utc", UtcNow()},
+                    {"created_unix", created},
+                    {"expires_unix", created + static_cast<int64_t>(_settings.rawRetentionDays) * 86400},
+                    {"policy_version", _settings.policyVersion}
+                };
+                success = AppendJsonLine(fs::path(_settings.dataDirectory) / "events" /
+                    (item.playerId + ".jsonl"), value);
+            }
+        }
+        catch (std::exception const& ex)
+        {
+            LOG_ERROR("server.loading", "[Ollama Chat Telemetry] worker_error type={} error={}",
+                static_cast<uint32_t>(item.type), ex.what());
+            success = false;
+        }
+        if (!success)
+            ++_writeFailed;
+
+        int64_t now = UnixNow();
+        if (now - lastRetention >= 21600)
+        {
+            ApplyRetention();
+            lastRetention = now;
+        }
+    }
+}
+
+Counters Store::GetCounters() const
+{
+    Counters value;
+    value.accepted = _accepted.load();
+    value.noConsent = _noConsent.load();
+    value.metadataOnly = _metadataOnly.load();
+    value.redacted = _redacted.load();
+    value.rejectedSensitive = _rejectedSensitive.load();
+    value.queueFull = _queueFull.load();
+    value.writeFailed = _writeFailed.load();
+    return value;
+}
+}
