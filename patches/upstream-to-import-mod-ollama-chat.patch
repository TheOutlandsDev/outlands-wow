+bool Store::IsConsented(uint64_t playerGuid) const
+{
+    if (_secret.empty())
+        return false;
+    std::string playerId = Pseudonym(playerGuid);
+    std::lock_guard<std::mutex> lock(_stateMutex);
+    auto itr = _consent.find(playerId);
+    return itr != _consent.end() ? itr->second : _settings.defaultConsent;
