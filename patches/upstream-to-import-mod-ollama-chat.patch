+        store.BuildRelationshipCue(player, firstBot, "Testmage", started + 6);
+    assert(familiarRelationship.find("familiar guildmate") != std::string::npos);
+    assert(store.BuildRelationshipCue(player, secondBot, "Testmage", started + 6).empty());
