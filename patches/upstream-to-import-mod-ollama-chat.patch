+#include "mod-ollama-chat_continuity.h"
+
+#include <cassert>
+#include <iostream>
+#include <string>
+
+int main()
+{
+    OllamaChatContinuity::Settings settings;
+    settings.enabled = true;
+    settings.stickyResponderSeconds = 60;
+    settings.memoryTtlSeconds = 120;
+    settings.maxPlayers = 8;
+    settings.maxTurnsPerPlayer = 4;
+    settings.maxRecentReplies = 4;
+
+    OllamaChatContinuity::Store store(settings);
+    constexpr uint64_t player = 100;
+    constexpr uint64_t firstBot = 200;
+    constexpr uint64_t secondBot = 300;
+    constexpr std::time_t started = 1000;
+
+    assert(store.CommitTurn(player, firstBot, "Good evening everyone",
+        "Evening! How is questing going?", started));
+
+    assert(store.IsDuplicateReply(player, firstBot,
+        "Evening! How is questing going?", started + 1));
+    assert(!store.IsDuplicateReply(player, secondBot,
+        "Evening! How is questing going?", started + 1));
+
+    assert(store.IsDuplicateReply(player, firstBot,
+        "Evening, how is questing going?", started + 2));
+    assert(!store.IsDuplicateReply(player, secondBot,
+        "Evening, how is questing going?", started + 2));
+
+    assert(!store.IsDuplicateReply(player, firstBot,
+        "Evening! How is questing going?", started + 61));
+
+    std::string context = store.BuildContext(player, firstBot, "Testmage",
+        "Anyone want to run Deadmines?", started + 3);
+    assert(context.find("You replied: Evening! How is questing going?") != std::string::npos);
+    assert(context.find("NEW MESSAGE from Testmage") != std::string::npos);
