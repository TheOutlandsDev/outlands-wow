diff --git a/tests/query_priority_test.cpp b/tests/query_priority_test.cpp
new file mode 100644
index 0000000..1b2b03d
--- /dev/null
+++ b/tests/query_priority_test.cpp
@@ -0,0 +1,105 @@
+#include "mod-ollama-chat_querymanager.h"
+
+#include <cassert>
+#include <chrono>
+#include <condition_variable>
+#include <iostream>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+std::string QueryOllamaAPI(std::string const&)
+{
+    return {};
+}
+
+int main()
+{
+    QueryManager manager;
+    manager.Configure(1, 8, 4, 2, 10, 10);
+
+    std::mutex mutex;
+    std::condition_variable changed;
+    bool blockerStarted = false;
+    bool releaseBlocker = false;
+    std::vector<std::string> started;
+    std::vector<std::string> completed;
+
+    assert(manager.SetBackendForTesting([&](std::string const& prompt)
+    {
+        std::unique_lock<std::mutex> lock(mutex);
+        if (prompt == "blocker")
+        {
+            blockerStarted = true;
+            changed.notify_all();
+            changed.wait(lock, [&] { return releaseBlocker; });
+        }
+        started.push_back(prompt);
+        changed.notify_all();
+        return prompt;
+    }));
+    assert(manager.Start());
+
+    auto completion = [&](uint64_t, std::string response)
+    {
+        std::lock_guard<std::mutex> lock(mutex);
+        completed.push_back(std::move(response));
+        changed.notify_all();
+    };
+
+    uint64_t requestId = 0;
+    assert(manager.Submit("blocker", 1, 11, completion, requestId, QueryPriority::Human) ==
+        QuerySubmitResult::Accepted);
+    {
+        std::unique_lock<std::mutex> lock(mutex);
+        assert(changed.wait_for(lock, std::chrono::seconds(2), [&] { return blockerStarted; }));
+    }
+
+    assert(manager.Submit("ambient", 2, 22, completion, requestId, QueryPriority::Ambient) ==
+        QuerySubmitResult::Accepted);
+    assert(manager.Submit("follow-up", 3, 33, completion, requestId, QueryPriority::FollowUp) ==
+        QuerySubmitResult::Accepted);
+    assert(manager.Submit("human", 4, 44, completion, requestId, QueryPriority::Human) ==
+        QuerySubmitResult::Accepted);
+
+    {
+        std::lock_guard<std::mutex> lock(mutex);
+        releaseBlocker = true;
+    }
+    changed.notify_all();
+
+    {
+        std::unique_lock<std::mutex> lock(mutex);
+        assert(changed.wait_for(lock, std::chrono::seconds(3), [&] { return started.size() == 4; }));
+        assert(started[0] == "blocker");
+        assert(started[1] == "human");
+        assert(started[2] == "follow-up");
+        assert(started[3] == "ambient");
+    }
+
+    for (int i = 0; i < 100; ++i)
+    {
+        manager.DrainCompletions();
+        {
+            std::lock_guard<std::mutex> lock(mutex);
+            if (completed.size() == 4)
+                break;
+        }
+        std::this_thread::sleep_for(std::chrono::milliseconds(10));
+    }
+    {
+        std::lock_guard<std::mutex> lock(mutex);
+        assert(completed.size() == 4);
+    }
+
+    manager.Stop();
+    assert(!manager.IsRunning());
+    assert(std::string(QueryPriorityName(QueryPriority::Human)) == "human");
+    assert(std::string(QueryPriorityName(QueryPriority::FollowUp)) == "follow_up");
+    assert(std::string(QueryPriorityName(QueryPriority::Ambient)) == "ambient");
+
+    std::cout << "PASS human_priority=1 followup_priority=1 ambient_last=1 bounded_workers=1 clean_stop=1"
+              << std::endl;
+    return 0;
+}
