+bool Store::Enqueue(WorkItem item)
+{
+    {
+        std::lock_guard<std::mutex> lock(_queueMutex);
+        if (!_accepting)
+            return false;
+        if (_queue.size() >= _settings.maxQueue)
+        {
+            if (item.type == WorkType::Event)
+            {
+                ++_queueFull;
+                return false;
+            }
+
+            auto event = std::find_if(_queue.begin(), _queue.end(),
+                [](WorkItem const& queued) { return queued.type == WorkType::Event; });
+            if (event == _queue.end())
+            {
+                ++_queueFull;
+                return false;
+            }
+            _queue.erase(event);
+            ++_queueFull;
+        }
+        _queue.emplace_back(std::move(item));
+    }
+    _queueCv.notify_one();
+    return true;
+}
+
+bool Store::SetConsent(uint64_t playerGuid, bool enabled)
+{
+    if (!IsRunning() || _secret.empty())
+        return false;
+
+    std::string playerId = Pseudonym(playerGuid);
+    bool previous = false;
+    bool existed = false;
+    {
+        std::lock_guard<std::mutex> lock(_stateMutex);
+        auto itr = _consent.find(playerId);
+        existed = itr != _consent.end();
+        previous = existed && itr->second;
+        _consent[playerId] = enabled;
+    }
+
+    WorkItem item;
+    item.type = WorkType::Consent;
+    item.playerId = playerId;
+    item.consent = enabled;
+    if (Enqueue(std::move(item)))
+        return true;
+
+    {
+        std::lock_guard<std::mutex> lock(_stateMutex);
+        if (existed)
+            _consent[playerId] = previous;
+        else
+            _consent.erase(playerId);
+    }
+    return false;
+}
+
+bool Store::RequestDelete(uint64_t playerGuid)
+{
+    if (!IsRunning() || _secret.empty())
+        return false;
+    std::string playerId = Pseudonym(playerGuid);
+    {
+        std::lock_guard<std::mutex> lock(_stateMutex);
+        _consent[playerId] = false;
+        _lastRequestByPlayer.erase(playerId);
+    }
+    WorkItem item;
+    item.type = WorkType::Delete;
+    item.playerId = std::move(playerId);
+    return Enqueue(std::move(item));
+}
