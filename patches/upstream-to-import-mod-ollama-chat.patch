+static void QueueGuildSocialFollowUp(uint64_t threadId, uint64_t followUpBotGuid,
+    uint64_t primaryBotGuid, uint64_t humanGuid, std::string humanMessage,
+    std::string primaryResponse, ChatChannelSourceLocal sourceLocal)
+{
+    if (!g_EnableSocialConversation || !g_EnableSocialFollowUps || !threadId ||
+        !followUpBotGuid || !primaryBotGuid || !humanGuid ||
+        (sourceLocal != SRC_GUILD_LOCAL && sourceLocal != SRC_OFFICER_LOCAL))
+        return;
+
+    std::time_t now = time(nullptr);
+    if (!g_SocialCoordinator.ReserveFollowUp(threadId, followUpBotGuid, now))
+    {
+        LOG_INFO("playerbots",
+            "[Ollama Chat Social] event=followup_suppressed thread_id={} reason=coordinator_budget bot_guid={}",
+            threadId, followUpBotGuid);
+        return;
+    }
+
+    Player* followUpBot = ObjectAccessor::FindPlayer(ObjectGuid(followUpBotGuid));
+    Player* primaryBot = ObjectAccessor::FindPlayer(ObjectGuid(primaryBotGuid));
+    Player* human = ObjectAccessor::FindPlayer(ObjectGuid(humanGuid));
+    PlayerbotAI* followUpAI = followUpBot ? PlayerbotsMgr::instance().GetPlayerbotAI(followUpBot) : nullptr;
+    if (!followUpBot || !primaryBot || !human || !followUpAI || !followUpAI->IsBotAI() ||
+        !followUpBot->IsInWorld() || !primaryBot->IsInWorld() || !human->IsInWorld() ||
+        !human->GetGuildId() || followUpBot->GetGuildId() != human->GetGuildId() ||
+        primaryBot->GetGuildId() != human->GetGuildId() ||
+        (g_DisableRepliesInCombat && followUpBot->IsInCombat()))
+    {
+        LOG_INFO("playerbots",
+            "[Ollama Chat Social] event=followup_suppressed thread_id={} reason=participant_unavailable bot_guid={}",
+            threadId, followUpBotGuid);
+        return;
+    }
+
+    std::string prompt = GenerateBotPrompt(followUpBot, primaryResponse, primaryBot);
+    if (prompt.empty())
+    {
+        LOG_INFO("playerbots",
+            "[Ollama Chat Social] event=followup_suppressed thread_id={} reason=empty_prompt bot_guid={}",
+            threadId, followUpBot->GetGUID().GetCounter());
+        return;
+    }
+
+    std::string safeHumanMessage = g_ConversationContinuity.MemoryText(humanMessage);
+    prompt += "\nThis is one bounded follow-up in guild chat. " + human->GetName() +
+        " originally said: " + safeHumanMessage + ". " + primaryBot->GetName() +
+        " replied: " + g_ConversationContinuity.MemoryText(primaryResponse) +
+        ". Respond once as a different guild member. Be natural, relevant, and concise; "
+        "do not repeat either message, invent shared events, or prefix your name.\n";
+    prompt += OllamaChatPolicy::AuthoritativeSpeakerInstruction(primaryBot->GetName()) + "\n";
+
+    uint64_t requestId = 0;
+    QuerySubmitResult submitResult = SubmitQuery(std::move(prompt), followUpBotGuid, primaryBotGuid,
+        [threadId, followUpBotGuid, primaryBotGuid, humanGuid, primaryResponse, sourceLocal]
+        (uint64_t completedRequestId, std::string response)
+    {
+        if (!g_SocialCoordinator.IsThreadActive(threadId, time(nullptr)))
+        {
+            LOG_INFO("playerbots",
+                "[Ollama Chat Social] event=followup_suppressed thread_id={} request_id={} reason=thread_expired",
+                threadId, completedRequestId);
+            return;
+        }
+        Player* bot = ObjectAccessor::FindPlayer(ObjectGuid(followUpBotGuid));
+        Player* primary = ObjectAccessor::FindPlayer(ObjectGuid(primaryBotGuid));
+        Player* humanPtr = ObjectAccessor::FindPlayer(ObjectGuid(humanGuid));
+        PlayerbotAI* ai = bot ? PlayerbotsMgr::instance().GetPlayerbotAI(bot) : nullptr;
+        if (!bot || !primary || !humanPtr || !ai || !ai->IsBotAI() || response.empty() ||
+            !humanPtr->GetGuildId() || bot->GetGuildId() != humanPtr->GetGuildId() ||
+            primary->GetGuildId() != humanPtr->GetGuildId() ||
+            (g_DisableRepliesInCombat && bot->IsInCombat()))
+        {
+            LOG_INFO("playerbots",
+                "[Ollama Chat Social] event=followup_suppressed thread_id={} request_id={} reason=response_or_participant_unavailable",
+                threadId, completedRequestId);
+            return;
+        }
+        if (g_ConversationContinuity.IsDuplicateReply(
+                primaryBotGuid, followUpBotGuid, response, time(nullptr)))
+        {
+            LOG_INFO("playerbots",
+                "[Ollama Chat Social] event=followup_suppressed thread_id={} request_id={} reason=duplicate_reply",
+                threadId, completedRequestId);
+            return;
+        }
+
+        bool delivered = ai->SayToGuild(response, sourceLocal == SRC_OFFICER_LOCAL);
+        if (!delivered)
+        {
+            LOG_INFO("playerbots",
+                "[Ollama Chat Social] event=followup_suppressed thread_id={} request_id={} reason=delivery_failed",
+                threadId, completedRequestId);
+            return;
+        }
+        AppendBotConversation(followUpBotGuid, primaryBotGuid, primaryResponse, response);
+        LOG_INFO("playerbots",
+            "[Ollama Chat Social] event=followup_delivered thread_id={} request_id={} primary_bot_guid={} followup_bot_guid={} source={}",
+            threadId, completedRequestId, primary->GetGUID().GetCounter(),
+            bot->GetGUID().GetCounter(), static_cast<uint32>(sourceLocal));
+    }, requestId, QueryPriority::FollowUp);
+
+    LOG_INFO("playerbots",
+        "[Ollama Chat Social] event=followup_submit thread_id={} request_id={} result={} bot_guid={}",
+        threadId, requestId, QuerySubmitResultName(submitResult), followUpBot->GetGUID().GetCounter());
+}
+
+void UpdateSocialConversation(uint32 diff)
+{
+    if (!g_EnableSocialConversation)
+        return;
+
+    uint64_t intervalMs = static_cast<uint64_t>(g_SocialTickSeconds) * 1000;
+    g_SocialTickAccumulatorMs += diff;
+    if (g_SocialTickAccumulatorMs < intervalMs)
+        return;
+    g_SocialTickAccumulatorMs %= intervalMs;
+
+    std::time_t now = time(nullptr);
+    g_SocialCoordinator.Expire(now);
+    auto const& allPlayers = ObjectAccessor::GetPlayers();
+    for (auto const& pair : allPlayers)
+    {
+        Player* human = pair.second;
+        PlayerbotAI* humanAI = human ? PlayerbotsMgr::instance().GetPlayerbotAI(human) : nullptr;
+        if (!human || !human->IsInWorld() || !human->GetGuildId() ||
+            (humanAI && humanAI->IsBotAI()))
+            continue;
+
+        OllamaChatSocial::ChannelKey key{
+            static_cast<uint8_t>(SRC_GUILD_LOCAL), human->GetGuildId(),
+            static_cast<uint8_t>(human->GetTeamId())
+        };
+        g_SocialCoordinator.ObserveHumanPresence(key, now);
+        if (!g_EnableSocialAmbient || !g_SocialCoordinator.ReserveAmbient(key, now))
+            continue;
+
+        std::vector<Player*> bots;
+        for (auto const& candidatePair : allPlayers)
+        {
+            Player* candidate = candidatePair.second;
+            PlayerbotAI* candidateAI = candidate ? PlayerbotsMgr::instance().GetPlayerbotAI(candidate) : nullptr;
+            if (candidate && candidate->IsInWorld() && candidateAI && candidateAI->IsBotAI() &&
+                candidate->GetGuildId() == human->GetGuildId() &&
+                candidate->GetTeamId() == human->GetTeamId() &&
+                !(g_DisableRepliesInCombat && candidate->IsInCombat()))
+                bots.push_back(candidate);
+        }
+        if (bots.empty())
+        {
+            LOG_INFO("playerbots",
+                "[Ollama Chat Social] event=ambient_suppressed guild_id={} reason=no_available_bot",
+                human->GetGuildId());
+            continue;
+        }
+
+        Player* bot = bots[urand(0, static_cast<uint32>(bots.size() - 1))];
+        uint64_t botGuid = bot->GetGUID().GetRawValue();
+        uint32 guildId = human->GetGuildId();
+        uint64_t schedulerIdentity = 0xF000000000000000ULL | static_cast<uint64_t>(guildId);
+        std::ostringstream prompt;
+        prompt << "You are " << bot->GetName() << ", a level " << bot->GetLevel() << " "
+            << FormatPlayerClass(bot->getClass()) << " currently logged into a Wrath of the Lich King guild. "
+            << "Write exactly one short, natural guild-chat line about current gameplay, plans, a useful question, "
+            << "or friendly banter. Sound like a real player. Do not fabricate a specific shared event, address an "
+            << "offline player, mention AI, explain yourself, or prefix your name. Output only the chat line.";
+
+        uint64_t requestId = 0;
+        QuerySubmitResult submitResult = SubmitQuery(prompt.str(), botGuid, schedulerIdentity,
+            [botGuid, guildId, schedulerIdentity](uint64_t completedRequestId, std::string response)
+        {
+            Player* botPtr = ObjectAccessor::FindPlayer(ObjectGuid(botGuid));
+            PlayerbotAI* ai = botPtr ? PlayerbotsMgr::instance().GetPlayerbotAI(botPtr) : nullptr;
+            if (!botPtr || !botPtr->IsInWorld() || !ai || !ai->IsBotAI() ||
+                botPtr->GetGuildId() != guildId || response.empty() ||
+                (g_DisableRepliesInCombat && botPtr->IsInCombat()))
+            {
+                LOG_INFO("playerbots",
+                    "[Ollama Chat Social] event=ambient_suppressed request_id={} guild_id={} reason=response_or_bot_unavailable",
+                    completedRequestId, guildId);
+                return;
+            }
+            if (g_ConversationContinuity.IsDuplicateReply(
+                    schedulerIdentity, botGuid, response, time(nullptr)))
+            {
+                LOG_INFO("playerbots",
+                    "[Ollama Chat Social] event=ambient_suppressed request_id={} guild_id={} reason=duplicate_reply",
+                    completedRequestId, guildId);
+                return;
+            }
+            if (!ai->SayToGuild(response, false))
+            {
+                LOG_INFO("playerbots",
+                    "[Ollama Chat Social] event=ambient_suppressed request_id={} guild_id={} reason=delivery_failed",
+                    completedRequestId, guildId);
+                return;
+            }
+            g_ConversationContinuity.CommitTurn(
+                schedulerIdentity, botGuid, "ambient guild conversation", response, time(nullptr));
+            LOG_INFO("playerbots",
+                "[Ollama Chat Social] event=ambient_delivered request_id={} guild_id={} bot_guid={}",
+                completedRequestId, guildId, botPtr->GetGUID().GetCounter());
+        }, requestId, QueryPriority::Ambient);
+        LOG_INFO("playerbots",
+            "[Ollama Chat Social] event=ambient_submit request_id={} guild_id={} bot_guid={} result={}",
+            requestId, guildId, bot->GetGUID().GetCounter(), QuerySubmitResultName(submitResult));
+        return; // At most one ambient submission attempt per scheduler tick.
+    }
+}
