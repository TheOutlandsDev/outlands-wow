+bool Store::LoadKey()
+{
+    std::ifstream input(_settings.pseudonymKeyFile, std::ios::in | std::ios::binary);
+    if (!input)
+    {
+        LOG_ERROR("server.loading", "[Ollama Chat Telemetry] start_failed reason=key_unreadable");
+        return false;
+    }
+
+    _secret.assign(std::istreambuf_iterator<char>(input), std::istreambuf_iterator<char>());
+    while (!_secret.empty() && (_secret.back() == '\r' || _secret.back() == '\n'))
+        _secret.pop_back();
+    if (_secret.size() < 32 || _secret.size() > 1024)
+    {
+        _secret.clear();
+        LOG_ERROR("server.loading", "[Ollama Chat Telemetry] start_failed reason=invalid_key_length");
+        return false;
+    }
+    return true;
+}
