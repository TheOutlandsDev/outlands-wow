+bool PlayerBotChatHandler::OnPlayerCanUseChat(Player* player, uint32_t type, uint32_t lang, std::string& msg, Guild* /*guild*/)
+{
+    if (!g_Enable)
+        return true;
+
+    // The Guild* overload is the authoritative context. Do not let an
+    // unexpected or version-specific ChatMsg value downgrade guild traffic to
+    // an undefined source.
+    ChatChannelSourceLocal sourceLocal =
+        type == CHAT_MSG_OFFICER ? SRC_OFFICER_LOCAL : SRC_GUILD_LOCAL;
+    ProcessChat(player, type, lang, msg, sourceLocal, nullptr, nullptr);
+    return true;
+}
