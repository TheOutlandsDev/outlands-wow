+bool Store::LoadConsent()
+{
+    std::ifstream input(fs::path(_settings.dataDirectory) / "control" / "consent.jsonl",
+        std::ios::in | std::ios::binary);
+    if (!input)
+        return true;
+
+    std::unordered_map<std::string, bool> loaded;
+    std::string line;
+    uint64_t invalid = 0;
+    while (std::getline(input, line))
+    {
+        try
+        {
+            json value = json::parse(line);
+            std::string playerId = value.value("player_id", "");
+            std::string operation = value.value("operation", "");
+            if (playerId.size() != 32)
+            {
+                ++invalid;
+                continue;
+            }
+            if (operation == "consent")
+                loaded[playerId] = value.value("enabled", false);
+            else if (operation == "delete")
+                loaded[playerId] = false;
+        }
+        catch (...)
+        {
+            ++invalid;
+        }
+    }
+    {
+        std::lock_guard<std::mutex> lock(_stateMutex);
+        _consent = std::move(loaded);
+    }
+    if (invalid)
+        LOG_WARN("server.loading", "[Ollama Chat Telemetry] consent_load invalid_records={}", invalid);
+    return true;
+}
