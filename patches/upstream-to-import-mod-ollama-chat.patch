+void OllamaBotEventChatter::QueueEvent(Player* bot, std::string type, std::string detail, std::string actorName, bool isGuildEvent)
+{
+    if (!g_Enable || !g_EnableEventChatter || !bot)
+        return;
+
+    uint64_t botGuid = bot->GetGUID().GetRawValue();
+
+    std::string prompt = BuildPrompt(bot, g_EventChatterPromptTemplate, type, detail, actorName);
+    if (prompt.empty())
+    {
+        LOG_INFO("server.loading", "[Ollama Chat] result=event_prompt_empty bot_guid={}", botGuid);
+        return;
+    }
+
+    uint64_t requestId = 0;
+    QuerySubmitResult submitResult = SubmitQuery(std::move(prompt), botGuid, botGuid,
+        [botGuid, isGuildEvent](uint64_t completedRequestId, std::string response)
+    {
+        try
+        {
+            // QueryManager drains this callback from WorldScript::OnUpdate.
+            Player* botPtr = ObjectAccessor::FindPlayer(ObjectGuid(botGuid));
+            if (!botPtr)
+            {
+                LOG_INFO("server.loading", "[Ollama Chat] request_id={} result=event_bot_unavailable",
+                    completedRequestId);
+                return;
+            }
+
+            if (response.empty())
+            {
+                LOG_INFO("server.loading", "[Ollama Chat] request_id={} result=event_empty_response",
+                    completedRequestId);
+                return;
+            }
+
+            PlayerbotAI* botAI = PlayerbotsMgr::instance().GetPlayerbotAI(botPtr);
+            if (!botAI)
+            {
+                LOG_INFO("server.loading", "[Ollama Chat] request_id={} result=event_bot_ai_unavailable",
+                    completedRequestId);
+                return;
+            }
+
+            if (g_EnableTypingSimulation)
+                LOG_WARN("server.loading", "[Ollama Chat] request_id={} typing simulation ignored by LA21 safety profile",
+                    completedRequestId);
+
+            bool chatSent = false;
+            if (isGuildEvent && botPtr->GetGuild())
+            {
+                if (!g_DisableForGuild)
+                {
+                    botAI->SayToGuild(response);
+                    chatSent = true;
+                }
+            }
+            else if (botPtr->GetGroup())
+            {
+                if (!g_DisableForParty)
+                {
+                    botAI->SayToParty(response);
+                    chatSent = true;
+                }
+            }
+            else
+            {
+                std::vector<std::string> channels;
+                if (!g_DisableForCustomChannels)
+                    channels.push_back("General");
+                if (!g_DisableForSayYell)
+                    channels.push_back("Say");
+
+                if (!channels.empty())
+                {
+                    std::uniform_int_distribution<size_t> dist(0, channels.size() - 1);
+                    static std::mt19937 generator(std::random_device{}());
+                    std::string const& selectedChannel = channels[dist(generator)];
+                    if (selectedChannel == "General")
+                    {
+                        if (!botAI->SayToChannel(response, ChatChannelId::GENERAL))
+                            botAI->Say(response);
+                        chatSent = true;
+                    }
+                    else
+                    {
+                        botAI->Say(response);
+                        chatSent = true;
+                    }
+                }
+            }
+
+            LOG_INFO("server.loading", "[Ollama Chat] request_id={} result={}", completedRequestId,
+                chatSent ? "event_chat_sent" : "event_delivery_skipped");
+        }
+        catch (std::exception const& ex)
+        {
+            LOG_ERROR("server.loading", "[Ollama Chat] request_id={} result=event_delivery_exception error={}",
+                completedRequestId, ex.what());
+        }
+    }, requestId);
+
+    if (submitResult != QuerySubmitResult::Accepted)
+        LOG_INFO("server.loading", "[Ollama Chat] request_id={} result=event_submit_failed reason={}",
+            requestId, QuerySubmitResultName(submitResult));
+}
+
