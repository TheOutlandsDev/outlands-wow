+OllamaChat.EnableGuildEventChatter = 0
 
 # OllamaChat.GuildChatterBotCommentChance
 #     Description: Percentage chance (0-100) for guild bots to comment on guild events.
@@ -859,6 +895,46 @@ OllamaChat.GuildEventTypeLevelUp_Chance = 95
 OllamaChat.GuildEventTypeDungeonComplete = guild group completed a dungeon
 OllamaChat.GuildEventTypeDungeonComplete_Chance = 85
 
+# --------------------------------------------
+# CONSENT-FIRST CONVERSATION TELEMETRY (LA25)
+# --------------------------------------------
+# Telemetry is disabled by default. When enabled, DefaultConsent controls the
+# policy for players who have not made an explicit privacy choice. Explicit
+# .ollama privacy on/off choices always override the realm default.
+# The key file must contain at least 32 random bytes and must not be committed.
+# Say/yell text may be retained after redaction. Shared channels and whispers
+# are metadata-only unless their separate capture switches are enabled.
+OllamaChat.Telemetry.Enable = 0
+OllamaChat.Telemetry.DefaultConsent = 0
+OllamaChat.Telemetry.DataDirectory = telemetry/ollama-chat
+OllamaChat.Telemetry.PseudonymKeyFile =
+OllamaChat.Telemetry.CaptureSharedChannels = 0
+OllamaChat.Telemetry.CaptureWhispers = 0
+OllamaChat.Telemetry.MaxQueue = 256
+OllamaChat.Telemetry.MaxTextBytes = 240
+OllamaChat.Telemetry.RawRetentionDays = 30
+OllamaChat.Telemetry.PolicyVersion = la25-v1
+OllamaChat.Telemetry.PromptVersion = la25-v1
+
+# --------------------------------------------
+# BOUNDED SOCIAL CONVERSATION (LA25 V8)
+# --------------------------------------------
+# Human messages always have queue priority and exactly one primary responder.
+# Follow-ups are one separate bot reply tied to the human thread. Ambient guild
+# chat waits for human quiet time and is limited per guild/channel per hour.
+OllamaChat.Social.Enable = 1
+OllamaChat.Social.FollowUps.Enable = 1
+OllamaChat.Social.FollowUps.ChancePercent = 25
+OllamaChat.Social.ThreadTtlSeconds = 180
+OllamaChat.Social.FollowUps.CooldownSeconds = 90
+OllamaChat.Social.MaxDepth = 2
+OllamaChat.Social.MaxBotParticipants = 3
+OllamaChat.Social.Ambient.Enable = 1
+OllamaChat.Social.Ambient.HumanQuietSeconds = 120
+OllamaChat.Social.Ambient.CooldownSeconds = 900
+OllamaChat.Social.Ambient.HourlyBudget = 2
+OllamaChat.Social.TickSeconds = 30
+
 # --------------------------------------------
 # RAG (Retrieval-Augmented Generation) SYSTEM
 # --------------------------------------------
@@ -903,4 +979,4 @@ OllamaChat.RAGSimilarityThreshold = 0.3
 # OllamaChat.RAGPromptTemplate
 #     Description: Template for including RAG information in bot prompts.
 #     Placeholders (named): {rag_info}
-OllamaChat.RAGPromptTemplate = "RELEVANT INFORMATION:\n{rag_info}\nUse this information to provide accurate and detailed responses when applicable."
\ No newline at end of file
