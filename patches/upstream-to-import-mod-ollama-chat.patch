+bool OllamaChatConfigCommand::HandleOllamaPrivacyStatusCommand(ChatHandler* handler)
+{
+    Player* player = GetTelemetryCommandPlayer(handler);
+    if (!player)
+        return false;
+    if (!g_OllamaChatTelemetry.IsRunning())
+        handler->SendSysMessage("AI conversation telemetry is disabled on this realm.");
+    else if (g_OllamaChatTelemetry.IsConsented(player->GetGUID().GetRawValue()) &&
+        g_OllamaChatTelemetry.HasConsentOverride(player->GetGUID().GetRawValue()))
+        handler->SendSysMessage("AI conversation telemetry: OPTED IN. Use .ollama privacy off or delete at any time.");
+    else if (g_OllamaChatTelemetry.IsConsented(player->GetGUID().GetRawValue()))
+        handler->SendSysMessage("AI conversation telemetry: ON BY REALM DEFAULT. Use .ollama privacy off or delete at any time.");
+    else if (g_OllamaChatTelemetry.HasConsentOverride(player->GetGUID().GetRawValue()))
+        handler->SendSysMessage("AI conversation telemetry: OPTED OUT. Use .ollama privacy on to enable it again.");
+    else
+        handler->SendSysMessage("AI conversation telemetry: OFF BY REALM DEFAULT. Use .ollama privacy on to enable it.");
+    return true;
+}
+
+bool OllamaChatConfigCommand::HandleOllamaPrivacyOnCommand(ChatHandler* handler)
+{
+    Player* player = GetTelemetryCommandPlayer(handler);
+    if (!player)
+        return false;
+    if (!g_OllamaChatTelemetry.SetConsent(player->GetGUID().GetRawValue(), true))
+        handler->SendSysMessage("AI conversation telemetry opt-in failed; no consent change was recorded.");
+    else
+        handler->SendSysMessage("AI conversation telemetry is ON. Only delivered AI exchanges are considered; identifiers are pseudonymous and text is redacted. Use .ollama privacy off or delete at any time.");
+    return true;
+}
+
+bool OllamaChatConfigCommand::HandleOllamaPrivacyOffCommand(ChatHandler* handler)
+{
+    Player* player = GetTelemetryCommandPlayer(handler);
+    if (!player)
+        return false;
+    if (!g_OllamaChatTelemetry.SetConsent(player->GetGUID().GetRawValue(), false))
+        handler->SendSysMessage("AI conversation telemetry opt-out failed; please retry.");
+    else
+        handler->SendSysMessage("AI conversation telemetry is OFF. Existing records remain until retention expiry; use .ollama privacy delete to erase them.");
+    return true;
+}
+
+bool OllamaChatConfigCommand::HandleOllamaPrivacyDeleteCommand(ChatHandler* handler)
+{
+    Player* player = GetTelemetryCommandPlayer(handler);
+    if (!player)
+        return false;
+    if (!g_OllamaChatTelemetry.RequestDelete(player->GetGUID().GetRawValue()))
+        handler->SendSysMessage("AI conversation data deletion could not be queued; please retry.");
+    else
+        handler->SendSysMessage("AI conversation data deletion is queued and future capture is disabled.");
+    return true;
+}
+
+bool OllamaChatConfigCommand::HandleOllamaPrivacyExportCommand(ChatHandler* handler)
+{
+    Player* player = GetTelemetryCommandPlayer(handler);
+    if (!player)
+        return false;
+    if (!g_OllamaChatTelemetry.RequestExport(player->GetGUID().GetRawValue()))
+        handler->SendSysMessage("AI conversation data export could not be queued; please retry.");
+    else
+        handler->SendSysMessage("AI conversation data export is queued for administrator delivery.");
+    return true;
+}
+
+bool OllamaChatConfigCommand::HandleOllamaFeedbackCommand(ChatHandler* handler, std::string rating)
+{
+    Player* player = GetTelemetryCommandPlayer(handler);
+    if (!player)
+        return false;
+    std::transform(rating.begin(), rating.end(), rating.begin(), [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+    static std::unordered_map<std::string, OllamaChatTelemetry::Feedback> const ratings =
+    {
+        { "good", OllamaChatTelemetry::Feedback::Good },
+        { "wrong", OllamaChatTelemetry::Feedback::Wrong },
+        { "repetitive", OllamaChatTelemetry::Feedback::Repetitive },
+        { "unnatural", OllamaChatTelemetry::Feedback::Unnatural },
+        { "forgot", OllamaChatTelemetry::Feedback::Forgot },
+        { "unsafe", OllamaChatTelemetry::Feedback::Unsafe }
+    };
+    auto itr = ratings.find(rating);
+    if (itr == ratings.end())
+    {
+        handler->SendSysMessage("Usage: .ollama feedback good|wrong|repetitive|unnatural|forgot|unsafe");
+        return true;
+    }
+    if (!g_OllamaChatTelemetry.AddFeedback(player->GetGUID().GetRawValue(), itr->second))
+        handler->SendSysMessage("Feedback was not recorded. Opt in first and receive an AI reply.");
+    else
+        handler->SendSysMessage("Thank you. Feedback was attached to your latest retained AI reply.");
+    return true;
+}
+
+bool OllamaChatConfigCommand::HandleOllamaPersonalityListCommand(ChatHandler* handler)
+{
+    std::vector<std::string> personalities = GetAllPersonalityKeys();
+    
+    if (personalities.empty())
+    {
+        handler->SendSysMessage("OllamaChat: No personalities loaded.");
+        return true;
+    }
+    
+    handler->SendSysMessage(fmt::format("OllamaChat: Available personalities ({} total, {} random-assignable):", 
+                            personalities.size(), g_PersonalityKeysRandomOnly.size()));
+    
+    for (const auto& personality : personalities)
+    {
+        std::string prompt = GetPersonalityPromptAddition(personality);
+        
+        // Check if this personality is manual-only
+        bool isManualOnly = (std::find(g_PersonalityKeysRandomOnly.begin(), g_PersonalityKeysRandomOnly.end(), personality) 
+                            == g_PersonalityKeysRandomOnly.end());
+        
+        std::string manualTag = isManualOnly ? " [MANUAL ONLY]" : "";
+        
+        handler->SendSysMessage(fmt::format("  - {}{}", personality, manualTag));
+        handler->SendSysMessage(fmt::format("    {}", prompt));
+    }
+    
+    return true;
+}
