+{
+    return std::chrono::duration_cast<std::chrono::seconds>(
+        std::chrono::system_clock::now().time_since_epoch()).count();
+}
+
+uint64_t UnixNowMs()
+{
+    return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::milliseconds>(
+        std::chrono::system_clock::now().time_since_epoch()).count());
+}
+
+std::string UtcNow()
+{
+    std::time_t now = std::time(nullptr);
+    std::tm tm{};
+#ifdef _WIN32
+    gmtime_s(&tm, &now);
+#else
+    gmtime_r(&now, &tm);
+#endif
+    std::ostringstream value;
+    value << std::put_time(&tm, "%Y-%m-%dT%H:%M:%SZ");
+    return value.str();
+}
+
+std::string SafeUtcStamp()
+{
+    std::string value = UtcNow();
+    value.erase(std::remove_if(value.begin(), value.end(), [](char c)
+    {
+        return c == '-' || c == ':' || c == 'T' || c == 'Z';
+    }), value.end());
+    return value;
+}
+
+std::string HexPrefix(Acore::Crypto::HMAC_SHA256::Digest const& digest)
+{
+    static char const hex[] = "0123456789abcdef";
+    std::string value;
+    value.reserve(32);
+    for (std::size_t i = 0; i < 16; ++i)
+    {
+        value.push_back(hex[(digest[i] >> 4) & 0x0f]);
+        value.push_back(hex[digest[i] & 0x0f]);
+    }
+    return value;
+}
+
+std::string Utf8Prefix(std::string const& value, std::size_t maxBytes)
+{
+    if (value.size() <= maxBytes)
+        return value;
+
+    std::size_t pos = 0;
+    while (pos < value.size())
+    {
+        unsigned char first = static_cast<unsigned char>(value[pos]);
+        std::size_t length = 1;
+        if ((first & 0xe0) == 0xc0) length = 2;
+        else if ((first & 0xf0) == 0xe0) length = 3;
+        else if ((first & 0xf8) == 0xf0) length = 4;
+        if (pos + length > maxBytes)
+            break;
+        pos += length;
+    }
+    return value.substr(0, pos);
+}
