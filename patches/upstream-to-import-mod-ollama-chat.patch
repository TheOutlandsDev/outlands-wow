+std::string Store::Pseudonym(uint64_t rawGuid) const
+{
+    std::string input = std::to_string(rawGuid);
+    Acore::Crypto::HMAC_SHA256 hash(reinterpret_cast<uint8 const*>(_secret.data()), _secret.size());
+    hash.UpdateData(input);
+    hash.Finalize();
+    return HexPrefix(hash.GetDigest());
+}
