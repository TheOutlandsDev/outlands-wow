##############################################
# Living Azeroth ambient population prototype
##############################################

# Master switch. Disabled by default in installed releases.
Population.Enable = 0
Population.AutoStart = 0

# Restore assigned bot positions and native strategies during graceful shutdown.
# Level normalization is intentionally not reversed; the pre-gate database
# checkpoint is the exact rollback for generated inventory and character state.
Population.RestoreOnShutdown = 1

# Exact independent random-Playerbot roster per faction.
# The isolated capacity candidate allows at most 32 per faction. Public
# activation remains at 30 until a private 60-bot recovery gate passes.
Population.TargetPerFaction = 10
# Exact roster slots per faction assigned to the first four, capital-city
# anchors. The remainder uses the four starter/travel anchors. A value larger
# than TargetPerFaction is clamped to TargetPerFaction.
Population.CapitalSlotsPerFaction = 0
# This range seeds new profiles. Persistent profiles may progress above it.
Population.MinLevel = 5
Population.MaxLevel = 12

Population.RosterTimeoutSeconds = 300
Population.AssignmentIntervalMs = 500
Population.VerifyIntervalSeconds = 30
Population.AssignmentHoldSeconds = 7200
Population.HistoryPath = "/run/living-azeroth/logs/population/ambient-history.jsonl"

# Initialize each selected RNDBOT profile only once, then preserve earned
# levels, equipment, talents, quests, inventory, and guild membership.
Population.PersistentProfiles = 0

# Optional cross-faction shared guild and activity evidence.
Population.SharedGuild.Enable = 0
Population.SharedGuild.Name = "Living Azeroth"
Population.SharedGuild.PlayerName = "Shamus"
Population.SharedGuild.CheckIntervalSeconds = 5
Population.ActivityTelemetryIntervalSeconds = 30
Population.ProfileHistoryPath = "/run/living-azeroth/logs/population/profile-history.jsonl"

