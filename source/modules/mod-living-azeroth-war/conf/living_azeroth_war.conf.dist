############################################################
# LIVING AZEROTH: BATTLE FOR HILLSBRAD PROTOTYPE            #
############################################################

# Master switch. Disabled in every distributed release.
War.Enable = 0

# Start one bounded event after world startup.
War.AutoStart = 0

# Version 1 hard cap. The prototype requires exactly this many
# registered random Playerbots from each faction.
War.MaximumActivePerFaction = 10

# The selected roster is deliberately normalized into a dedicated
# Hillsbrad level-band roster. Back up the character database first.
War.NormalizeLevel = 30

# Lifecycle timing.
War.RosterTimeoutSeconds = 300
War.PreparationIntervalMs = 500
War.StagingSeconds = 20
War.CountdownSeconds = 10
War.ObjectiveSeconds = 45
War.ConclusionSeconds = 5
War.AbortDisengageSeconds = 3
War.CleanupReleaseIntervalMs = 250

# Objective evaluation.
War.CaptureRadius = 60.0

# Safety thresholds.
War.PerformanceAbortLatencyMs = 200
War.PerformanceAbortSustainedSeconds = 30
War.ExtremeUpdateSpikeMs = 500
War.MaximumTeleportFailurePercent = 15.0

# Prototype invariants.
War.ReinforcementsEnable = 0
War.RewardsEnable = 0

# Append-only event evidence.
War.HistoryPath = "/run/living-azeroth/logs/war/hillsbrad-history.jsonl"

# Authoritative locations from acore_world.game_tele.
War.Southshore.Map = 0
